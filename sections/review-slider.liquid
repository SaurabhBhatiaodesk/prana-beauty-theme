<script>
document.addEventListener('DOMContentLoaded', function() {
  const swiper = new Swiper(".reviewSwiper", {
    slidesPerView: 1.5,
    spaceBetween: 20, 
    loop: true,
    breakpoints: {
      0: {
        slidesPerView: 1   // mobile
      },
      768: {
        slidesPerView: 1.5 // tablet & desktop
      }
    },
    navigation: {
      nextEl: ".custom-next-{{ section.id }}",
      prevEl: ".custom-prev-{{ section.id }}",
    },
    on: {
      slideChange: function() {
        const total = this.slides.length;
        const index = this.realIndex + 1;
        const percent = (index / total) * 100;
        document.querySelector('.swiper-pagination-bar-fill').style.width = percent + "%";
      }
    }
  });
});
</script>


{% schema %}
{
  "name": "Review Slider",
  "settings": [
    {
        "type": "text",
        "id": "title",
        "label": "Title"
    },
    {
        "type": "text",
        "id": "des",
        "label": "Desription"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "left_image",
          "label": "Left Review Image"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "I’ve tried so many masks, but this one actually makes my skin glow."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah M."
        },
        {
          "type": "url",
          "id": "tag",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review Slider"
    }
  ]
}
{% endschema %}
