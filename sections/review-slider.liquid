<style>
.review-slider-wrapper {
  padding: 50px 16px;
}
.review-slider-wrapper h2 {
    font-family: "Josefin Sans";
    letter-spacing: 1px !important;
    margin: 0 0 10px 0;
    color: #4e403c;
    font-size: 25px;
    text-align: center;
}
.review-slider-wrapper p {
    margin: 0 auto;
    font-family: "Josefin Sans";
    color: #4e403c;
    font-size: 21px;
    font-weight: 300;
    text-align: center;
    max-width: 480px;
    letter-spacing: -1px;
}
.swiper.reviewSwiper {
    margin-top: 40px;
}
.review-slide {
  display: flex;
  gap: 25px;
}
.review-left,
.review-right {
  width: 50%;
}
.review-left img {
  width: 100%;
  border-radius: 6px;
  object-fit: cover;
}
.review-stars {
  display: flex;
  gap: 6px;
  margin-bottom: 15px;
}
.review-text {
  font-size: 31px;
    line-height: 1.1;
    margin-bottom: 15px;
    color: #0E2127;
    font-family: 'Josefin Sans';
    font-weight: 300;
    margin-bottom: 20px;
}
.review-name {
    font-weight: 400;
    margin-bottom: 5px;
    font-size: 18px;
    color: #161718;
    font-family: 'Josefin Sans';
}
.review-arrows {
  margin-top: -20px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 80px;
}
.review-arrows div {
  position: static !important;
}
.swiper-pagination-bar {
  width: 120px;
  height: 4px;
  background: #ddd;
  border-radius: 5px;
  overflow: hidden;
}
.swiper-pagination-bar-fill {
  height: 100%;
  width: 0%;
  background: black;
  transition: width 0.4s ease;
}
.item-centers {
    align-items: center;
    justify-content: space-between;
}
.custom-arrow {
    z-index: 2;
}

@media(max-width: 768px) {
  .review-slide {
    flex-direction: column;
  }
  .review-left,
  .review-right {
    width: 100%;
  }
  .review-right {
    margin-bottom: 2rem;
}
}
</style>


