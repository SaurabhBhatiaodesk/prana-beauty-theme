{% schema %}
{
  "name": "Shoppable UGC – Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOPPABLE UGC"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Perfect if you want a wink of personality.</p>"
    }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Video Item",
      "settings": [
        { "type": "video", "id": "video_file", "label": "Upload Video" },
        { "type": "image_picker", "id": "poster", "label": "Poster Image" },
        { "type": "product", "id": "product", "label": "Link Product" }
      ]
    }
  ],
  "presets": [
    { "name": "Shoppable UGC – Video", "category": "Custom sections" }
  ]
}
{% endschema %}

<!-- Load Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<section class="ugc-video-section-{{ section.id }}">
  <div class="ugc-header">
    <h2 class="pls-title">{{ section.settings.heading }}</h2>
    <p class="pls-des">{{ section.settings.subheading }}</p>
  </div>

  <div class="ugc-video-slider swiper-{{ section.id }}">
    <div class="swiper-wrapper">
      {% for i in (1..2) %}
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}

        <div class="ugc-slide swiper-slide" {{ block.shopify_attributes }}>
          <div class="ugc-video-card">
            <div class="ugc-video-wrapper {% if block.settings.poster == blank %}no-poster{% endif %}" data-video-id="{{ forloop.index }}">

              {% if block.settings.poster != blank %}
                <button class="ugc-play-btn" aria-label="Play video">
                  <svg width="18" height="21" viewBox="0 0 18 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 0L17.3418 10.116L0 20.2319V0Z" fill="#FDFCFA"/>
                  </svg>
                </button>
              {% endif %}


              {% if block.settings.video_file != blank %}
                {% assign video_url = block.settings.video_file.sources[1].url | default: block.settings.video_file.sources[0].url %}
                <video 
                    class="ugc-video" 
                    preload="none"
                    playsinline 
                    webkit-playsinline
                >
                  <source src="{{ video_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              {% endif %}

              <button class="ugc-play-btn" aria-label="Play video">
                <svg width="18" height="21" viewBox="0 0 18 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 0L17.3418 10.116L0 20.2319V0Z" fill="#FDFCFA"/>
                </svg>
              </button>
            </div>

            {% if product != blank %}
            <div class="ugc-product-card">
            <a href="{{ product.url }}" class="pdp-link-wrap">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '100x' }}" class="ugc-prod-img" alt="{{ product.title }}" loading="lazy">
              {% endif %}
              <div class="ugc-prod-info">
                <span class="ugc-prod-cat">{{ product.category }}</span>
                <p class="ugc-prod-title">{{ product.title }}</p>
                <p class="ugc-prod-price">FROM {{ product.price | money }}</p>
              </div>
            </a>
                <span class="ugc-add-icon">
                   <span class="add-btn" onclick="document.querySelector('.m{{ section.id }}-{{ product.id }} .quick-add__button').click()">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11 0H9V20H11V0Z" fill="#97371E"/>
                  <path d="M20 9H0V11H20V9Z" fill="#97371E"/>
                  </svg>
                </span>
                 {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
              <product-form-component 

                data-section-id="{{ section.id }}"
                data-product-id="{{ product.id }}"
                data-product-url="{{ product.url }}"
                on:submit="/handleSubmit"
                style="opacity: 0;visibility: hidden;"
                class="m{{ section.id }}-{{ product.id }}"
                data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
                data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}">
                <div
                  class="visually-hidden"
                  aria-live="assertive"
                  role="status"
                  aria-atomic="true"
                  ref="liveRegion"
                ></div>
                {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                  <input
                    type="hidden"
                    name="id"
                    ref="variantId"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <div
                    class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
                    
                    ref="productFormButtons"
                  >
                    {%- liquid
                      assign has_quantity_rules = false
                      if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
                        assign has_quantity_rules = true
                      endif
                    -%}
                      <button class="quick-add__button" type="sumbit">aaaaa</button>
                  </div>
                {%- endform -%}
              </product-form-component>
                </span>
              </div>
            {% endif %}

          </div>
        </div>
      {% endfor %}
      {% endfor %}
    
    </div>

    <div class="ugc-navigation">
      <div class="ugc-prev-{{ section.id }}">
        <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.259121 9.17002L9.11942 0.30972C9.43771 -0.0618701 9.99738 -0.105273 10.369 0.213015C10.7406 0.531304 10.784 1.09097 10.4657 1.46256C10.436 1.49759 10.404 1.52957 10.369 1.55927L3.02396 8.91341H38.1019C38.5916 8.91341 38.9883 9.31013 38.9883 9.79974C38.9883 10.2894 38.5916 10.6861 38.1019 10.6861H3.0232L10.3682 18.0311C10.7398 18.3494 10.7832 18.909 10.4649 19.2806C10.1466 19.6522 9.58695 19.6956 9.21536 19.3773C9.1811 19.3476 9.14835 19.3157 9.11866 19.2806L0.258358 10.4203C-0.0850601 10.0746 -0.0850601 9.51648 0.258358 9.17078L0.259121 9.17002Z" fill="#443531"/>
        </svg>
      </div>
      <div class="ugc-next-{{ section.id }}">
        <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M38.7292 9.17002L29.8689 0.30972C29.5506 -0.0618701 28.9909 -0.105273 28.6193 0.213015C28.2477 0.531304 28.2043 1.09097 28.5226 1.46256C28.5523 1.49759 28.5843 1.52957 28.6193 1.55927L35.9643 8.91341H0.886335C0.396718 8.91341 0 9.31013 0 9.79974C0 10.2894 0.396718 10.6861 0.886335 10.6861H35.9651L28.6201 18.0311C28.2485 18.3494 28.2051 18.909 28.5234 19.2806C28.8417 19.6522 29.4013 19.6956 29.7729 19.3773C29.8072 19.3476 29.8399 19.3157 29.8696 19.2806L38.7299 10.4203C39.0733 10.0746 39.0733 9.51648 38.7299 9.17078L38.7292 9.17002Z" fill="#443531"/>
        </svg>
      </div>
    </div>
  </div>
</section>


<style>
/* Prevent click events from bubbling through video wrapper */
.ugc-video-section-{{ section.id }} .ugc-video-wrapper {
  pointer-events: none;
}

.ugc-video-section-{{ section.id }} .ugc-play-btn,
.ugc-video-section-{{ section.id }} .ugc-video,
.ugc-video-section-{{ section.id }} .ugc-product-card {
  pointer-events: auto;
}

.ugc-video-section-{{ section.id }} { 
  margin: 0 auto;
  overflow: hidden; /* Prevent layout shift */
}

.ugc-video-section-{{ section.id }} .ugc-header { 
  text-align: center; 
     margin-top: 50px; 
}

.ugc-video-section-{{ section.id }} .ugc-video-card { 
  position: relative; 
  height: 100%;
}

/* Set fixed width for slides */
.swiper-{{ section.id }} .swiper-slide {
  {% comment %} width: 280px !important;
  flex-shrink: 0;
  transition: width 0.3s ease;
  height: 550px;
  margin-top: 90px; {% endcomment %}
   width: 280px;
   height: 500px;
   margin-top: 50px;
  transition: transform 0.35s ease;
}
.ugc-header p {
    margin: 0;
    font-family: 'Josefin Sans';
    color: #4E403C;
    font-size: 21px;
    font-weight: 300;
}
.pls-title {
    font-family: 'Josefin Sans';
    letter-spacing: 1px !important;
    margin: 20px 0 0 0;
    color: #4E403C;
    font-size: 25px;
}
.swiper-{{ section.id }} .swiper-slide-active {
  {% comment %} width: 350px !important; {% endcomment %}
  margin-top: 0!important;
  transform: scale(1);
}
.pdp-link-wrap {
display: flex; 
align-items: center;}
.ugc-video-section-{{ section.id }} .ugc-video-wrapper { 
  position: relative; 
  width: 100%;
  height: 450px;
  overflow: hidden; 
  background: #f5f5f5;
  transition: height 0.3s ease;
  pointer-events: none;

}

/* Make center slide bigger */
.swiper-{{ section.id }} .swiper-slide-active .ugc-video-wrapper {
  height: 500px;
}

.ugc-video-section-{{ section.id }} .ugc-video,
.ugc-video-section-{{ section.id }} .ugc-poster { 
  width: 100%; 
  height: 100%; 
  object-fit: cover;
  display: block;
}

.ugc-video-section-{{ section.id }} .ugc-video { 
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
  pointer-events: none;
}

.ugc-video-section-{{ section.id }} .ugc-video.active {
  opacity: 1;
  pointer-events: auto;
}

.ugc-video-section-{{ section.id }} .ugc-poster.hidden {
  opacity: 0;
}

/* Play Button - Small, Top Left */
.ugc-video-section-{{ section.id }} .ugc-play-btn {
  position: absolute;
  top: 15px;
  left: 15px;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  color: #fff;
  height: 40px;
  width: 40px;
  border-radius: 50%;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.3s ease;
  padding-left: 3px;
  pointer-events: auto;
}

.ugc-video-section-{{ section.id }} .ugc-play-btn svg {
  width: 14px;
  height: 16px;
  margin-left: 5px;
}

.ugc-video-section-{{ section.id }} .ugc-play-btn.hidden {
  opacity: 0;
  pointer-events: none;
}

/* Product Card - Bottom */
.ugc-video-section-{{ section.id }} .ugc-product-card {
  position: absolute;
  bottom: 15px;
  left: 15px;
  right: 15px;
  background: rgba(244, 241, 234, 0.98);
  backdrop-filter: blur(10px);
  padding: 12px 15px;
  text-decoration: none;
  display: none;
  align-items: center;
  gap: 12px;
  z-index: 5;
  transition: all 0.3s ease;
  pointer-events: auto;
}

.ugc-video-section-{{ section.id }} .ugc-prod-img {    
  width: 60px;
  height: 60px;
  object-fit: cover;
  border-radius: 6px;
  flex-shrink: 0;
}

.ugc-video-section-{{ section.id }} .ugc-prod-info {
  flex: 1;
}

.ugc-video-section-{{ section.id }} .ugc-prod-title { 
     margin: 0 0 8px 0;
    font-size: 20px;
    font-weight: 400;
    color: #4E403C;
    line-height: 1;
    font-family: 'Josefin Sans';
    letter-spacing: -1px;
}
span.ugc-prod-cat {
    color: #6F6865;
    font-weight: 400;
    line-height: 1;
    font-family: 'Josefin Sans';
    letter-spacing: -1px;
    font-size: 16px;
    text-transform: uppercase;
}

.ugc-video-section-{{ section.id }} .ugc-prod-price { 
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    color: #4E403C;
    line-height: 1.3;
    font-family: 'Josefin Sans';
    letter-spacing: -1px;
}
.ugc-video-section-{{ section.id }} .ugc-add-icon {
  position: absolute;
  bottom: 13px;
  right: 15px;
  cursor: pointer;
}

/* Navigation */
.ugc-video-section-{{ section.id }} .ugc-navigation {
  position: relative;
}

.ugc-video-section-{{ section.id }} .ugc-next-{{ section.id }} {
  position: absolute;
  top: 0;
  right: 33%;
  margin-top: -2rem;
  z-index: 9;
  transform: translateX(-33%);
}
.ugc-video-section-{{ section.id }} .ugc-prev-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 33%;
  margin-top: -2rem;
  z-index: 9;
  transform: translateX(-33%);
}

.swiper-{{ section.id }} {
  overflow: hidden;
}

.swiper-{{ section.id }} .swiper-wrapper {
  align-items: center;
  transition-timing-function: ease-out; /* Smoother transitions */
}

.swiper-{{ section.id }} .ugc-slide.swiper-slide-active .ugc-product-card {
  display: flex;
}
/* If no poster exists, show video by default */
.ugc-video-wrapper.no-poster .ugc-video {
  opacity: 1;
  pointer-events: auto;
}

.ugc-video-wrapper.no-poster .ugc-poster {
  display: none;
}




/* Mobile adjustments */
@media (max-width: 768px) {
  .swiper-{{ section.id }} .swiper-slide {
    width: 220px !important;
  }
  
  {% comment %} .swiper-{{ section.id }} .swiper-slide-active {
    width: 250px !important;
  } {% endcomment %}
  
  .ugc-video-section-{{ section.id }} .ugc-video-wrapper {
    height: 400px;
  }
  
  .swiper-{{ section.id }} .swiper-slide-active .ugc-video-wrapper {
    height: 450px;
  }
  
  .ugc-video-section-{{ section.id }} .ugc-header h2 {
    font-size: 24px;
  }
  .ugc-video-section-{{ section.id }} .ugc-product-card {
          bottom: 55px !important;
        left: 6px;
        right: 6px;
        padding: 5px;
  }
  .ugc-video-section-{{ section.id }} .ugc-add-icon {
    bottom: 10px;
    right: 10px;
    max-width: 20px;
    height: 20px;
  }
  .ugc-video-section-{{ section.id }} .ugc-prod-cat {
    letter-spacing: -1.2px;
  }
}
</style>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  
  function initUGCSection() {
    console.log('Initializing UGC Section...');
    
    // SWIPER INITIALIZATION
    let swiperInstance = null;
    
    if (typeof Swiper !== 'undefined') {
      
      swiperInstance = new Swiper(".swiper-" + sectionId, {
        slidesPerView: 'auto',
        spaceBetween: 10,
        centeredSlides: true,
        loop: true,
        navigation: {
          nextEl: ".ugc-next-" + sectionId,
          prevEl: ".ugc-prev-" + sectionId,
        },
         breakpoints: {
          768: { slidesPerView: 4.6 },
          1024: { slidesPerView: 4.6 }
        },
        on: {
          init: function() {
            this.update();
          },
          slideChange: function() {
            // Reset all videos when sliding
            const allVideos = document.querySelectorAll('.ugc-video-section-' + sectionId + ' .ugc-video');
            const allPosters = document.querySelectorAll('.ugc-video-section-' + sectionId + ' .ugc-poster');
            const allButtons = document.querySelectorAll('.ugc-video-section-' + sectionId + ' .ugc-play-btn');
            
            allVideos.forEach(v => {
              v.pause();
              v.currentTime = 0;
              v.classList.remove('active');
              v.controls = false;
            });
            
            allPosters.forEach(p => p.classList.remove('hidden'));
            allButtons.forEach(b => b.classList.remove('hidden'));
          },
          transitionStart: function() {
            // Prevent layout shift during transition
            this.wrapperEl.style.willChange = 'transform';
          },
          transitionEnd: function() {
            this.wrapperEl.style.willChange = 'auto';
          }
        }
      });
      
      console.log('✓ Swiper initialized');
    } else {
      console.error('Swiper library not loaded!');
    }
    
    // VIDEO PLAY HANDLER
    setTimeout(() => {
      const playButtons = document.querySelectorAll('.ugc-video-section-' + sectionId + ' .ugc-play-btn');
      
      playButtons.forEach(btn => {
        btn.addEventListener("click", function(e) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();
          
          const wrapper = this.closest(".ugc-video-wrapper");
          const video = wrapper.querySelector(".ugc-video");
          const poster = wrapper.querySelector(".ugc-poster");

          if (!video) {
            console.error("No video element found");
            return false;
          }

          console.log("Play button clicked, attempting to play video...");

          // Hide poster & play button
          if (poster) {
            poster.classList.add('hidden');
          }
          this.classList.add('hidden');

          // Show video
          video.classList.add('active');
          
          // Set video properties
          video.muted = false;
          video.controls = true;
          
          // Load and play
          video.load();
          
          const playPromise = video.play();
          
          if (playPromise !== undefined) {
            playPromise
              .then(() => {
                console.log("✓ Video is playing");
              })
              .catch(error => {
                console.error("Play failed:", error);
                // Fallback: try muted autoplay
                video.muted = true;
                video.play()
                  .then(() => console.log("✓ Playing muted"))
                  .catch(err => console.error("Muted play also failed:", err));
              });
          }
          
          return false;
        }, true);
      });
    }, 500);
    // Auto-show videos without posters
document.querySelectorAll(
  '.ugc-video-section-' + sectionId + ' .ugc-video-wrapper.no-poster'
).forEach(wrapper => {
  const video = wrapper.querySelector('.ugc-video');

  if (video) {
    video.classList.add('active');
    video.controls = true;
    video.muted = true; // safer autoplay behavior
    video.load();
  }
});

  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUGCSection);
  } else {
    initUGCSection();
  }
})();
</script>
