{{ 'prana-mask-pdp.css' | asset_url | stylesheet_tag }}
<prana-pdp-journeys class="prana-mask-pdp pm-pdp-journeys">
{% assign journey_blocks = section.blocks | where: 'type', 'journey' %}
{% if journey_blocks.size > 0 %}
<section class="pm-journeys" aria-labelledby="journeys-heading-{{ section.id }}">
  <div class="pm-wrap">
    <h2 id="journeys-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="pm-intro">{{ section.settings.intro | escape }}</p>
    <div class="pm-journey-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {% for block in journey_blocks %}
        <button type="button" role="tab" id="journey-tab-{{ block.id }}" aria-controls="journey-panel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">{{ block.settings.tab_label | default: block.settings.title | escape }}</button>
      {% endfor %}
    </div>
    {% for block in journey_blocks %}
      {% assign has_photos = false %}{% if block.settings.before_image != blank and block.settings.after_image != blank %}{% assign has_photos = true %}{% endif %}
      <div class="pm-ba-grid" role="tabpanel" id="journey-panel-{{ block.id }}" aria-labelledby="journey-tab-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
        <div class="pm-ba">
          <div class="pm-img pm-before">{% if block.settings.before_image != blank %}{{ block.settings.before_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% else %}<div class="ph">Before photo slot — {{ block.settings.before_label | escape }}<br>Real customer, natural light, no makeup</div>{% endif %}</div>
          <div class="pm-img pm-after">{% if block.settings.after_image != blank %}{{ block.settings.after_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% else %}<div class="ph">After photo slot — {{ block.settings.after_label | escape }}<br>Same customer, same lighting, angle and camera</div>{% endif %}</div>
          <span class="pm-lbl pm-l">{{ block.settings.before_label | escape }}</span><span class="pm-lbl pm-r">{{ block.settings.after_label | escape }}</span><div class="pm-handle" aria-hidden="true"></div>
          <label class="pm-sr" for="compare-{{ block.id }}">Compare before and after for {{ block.settings.title | escape }}</label>
          <input type="range" id="compare-{{ block.id }}" min="0" max="100" value="50">
        </div>
        <div class="pm-journey-copy">
          {% unless has_photos %}<span class="sample-tag">Sample data: replace before launch</span>{% endunless %}
          <h3>{{ block.settings.title | escape }}</h3>
          {% if block.settings.skin != blank %}<p>{{ block.settings.skin | escape }}</p>{% endif %}
          <div class="pm-journey-story">{{ block.settings.story }}</div>
          <p class="pm-disclose">{{ block.settings.disclosure | escape }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{% else %}
{% if section.settings.before_image != blank and section.settings.after_image != blank %}
<section class="pm-journeys"><div class="pm-wrap"><h2>Customer journeys</h2><div class="pm-ba-grid"><div class="pm-ba" id="ba-{{ section.id }}"><div class="pm-img pm-before">{{ section.settings.before_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}</div><div class="pm-img pm-after">{{ section.settings.after_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}</div><span class="pm-lbl pm-l">Before</span><span class="pm-lbl pm-r">After</span><div class="pm-handle"></div><label class="pm-sr" for="baRange-{{ section.id }}">Compare before and after</label><input type="range" id="baRange-{{ section.id }}" min="0" max="100" value="50"></div><div class="pm-journey-copy">{{ section.settings.journey_text }}</div></div></div></section>{% endif %}
{% if request.design_mode and section.settings.before_image == blank %}<section class="pm-journeys"><div class="pm-wrap"><h2>Customer journeys</h2><p>Add Customer journey blocks with approved before and after photos to display the comparison sliders here.</p></div></section>{% endif %}
{% endif %}
</prana-pdp-journeys>
<script src="{{ 'prana-pdp-journeys.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "PRANA PDP Journeys",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer journeys"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "Real customers with acne-prone skin, photographed at week 0 and week 8 of twice-weekly use. Drag to compare."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Customer before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "Customer after image"
    },
    {
      "type": "richtext",
      "id": "journey_text",
      "label": "Customer journey and disclosure"
    }
  ],
  "blocks": [
    {
      "type": "journey",
      "name": "Customer journey",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Customer name",
          "default": "Customer journey"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "info": "Short name for the tab. Defaults to the customer name."
        },
        {
          "type": "text",
          "id": "skin",
          "label": "Skin type"
        },
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After image"
        },
        {
          "type": "text",
          "id": "before_label",
          "label": "Before label",
          "default": "Week 0"
        },
        {
          "type": "text",
          "id": "after_label",
          "label": "After label",
          "default": "Week 8"
        },
        {
          "type": "richtext",
          "id": "story",
          "label": "Customer story and timeline"
        },
        {
          "type": "textarea",
          "id": "disclosure",
          "label": "Results disclosure",
          "default": "Individual results may vary."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA PDP Journeys"
    }
  ]
}
{% endschema %}
