{%- render 'ptm-assets' -%}
<div class="ptm">
<section class="tm-results" id="{{ section.settings.anchor | default: 'results' }}" aria-labelledby="res-h-{{ section.id }}">
  <div class="tm-wrap">
    {%- if section.settings.heading != blank -%}<h2 id="res-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.lede != blank -%}<p class="tm-lede">{{ section.settings.lede }}</p>{%- endif -%}
    <div class="tm-stat-row tm-five">
      {%- for block in section.blocks -%}<div class="tm-stat" {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.text }}</span></div>{%- endfor -%}
    </div>
    {%- if section.settings.footnote != blank -%}<p class="tm-foot">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: Study results",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [{ "type": "stat", "name": "Stat", "settings": [
    { "type": "text", "id": "value", "label": "Value" },
    { "type": "text", "id": "text", "label": "Text" }
  ] }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "lede", "label": "Intro" },
    { "type": "textarea", "id": "footnote", "label": "Footnote" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "results", "info": "Links like #results jump here" }
  ],
  "presets": [{ "name": "PDP: Study results" }]
}
{% endschema %}
