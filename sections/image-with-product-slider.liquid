<style>
.product-dual-slide {
  display: flex;
  gap: 10px;
}
.dual-left {
  width: 50%;
  position: relative;
}
.dual-left img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.dual-right {
  width: 50%;
  text-align: center;
  background: #fff;
  padding: 30px 40px;
  position: relative;
}
.dual-right h3 {
    color: #4E403C;
    font-size: 24px;
    font-family: 'Josefin Sans';
    margin: 2rem 1rem 0;
    text-transform: uppercase;
}
.dual-right p {
    margin: 1rem 0;
    font-family: "Josefin Sans";
    color: #4e403c;
    font-size: 18px;
    font-weight: 400;
    text-transform: uppercase;
}
.dual-right h6 {
    background: #F4E3B8;
    line-height: 18px;
    border-radius: 25px;
    font-size: 18px;
    font-weight: 400;
    font-family: 'Josefin Sans';
    color: #4E403C;
    border: 1px solid #4E403c;
    max-width: max-content;
    padding: 8px 13px 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 -15px 0;
}
.svgs {
    display: flex;
    margin: 0 0 15px auto;
}

.product-image {
  max-width: 300px;
  margin: auto;
}

.add-to-cart-btn {
  border: none;
    cursor: pointer;
    display: flex;
    margin: 20px auto 0;
    padding: 17px 100px;
    background: #F4F1EA;
    color: #1B1716;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    align-items: center;
    justify-content: center;
    line-height: 14px;
        max-width: 55%;
}
.add-to-cart-btn svg{
    margin-right: 8px;
}
.slider-arrows {
  margin-top: 20px;
  display: flex;
  justify-content: center;
  gap: 25px;
}
.productDualSwiper .custom-arrow.custom-next {
    position: absolute;
    right: 5%;
    top: 50%;
    transform: translateX(-50%);
}
.productDualSwiper .custom-arrow.custom-prev {
    position: absolute;
    left: 9%;
    top: 50%;
    transform: translateX(-50%);
}
.productDualSwiper {
    margin: 0 16px;
}


@media(max-width: 768px) {
  .product-dual-slide {
    flex-direction: column;
  }
  .dual-left, .dual-right {
    width: 100%;
  }
  .dual-right {
    padding: 16px;
  }
  .svgs {
    display: flex;
    margin: -25px 0 20px auto;
    max-width: 150px;
}
.dual-right h3 {
    font-size: 20px;
    letter-spacing: -1px;
}
.add-to-cart-btn {
    padding: 17px 0px;
}
.product-form-buttons button.quick-add__button {
    height: 1px;
    margin: 0;
    padding: 0;
}
.dual-right h6 {
    line-height: 12px;
    font-size: 11px;
}
}
</style>


<div class="swiper productDualSwiper">
  <div class="swiper-wrapper">

{% assign left_product = all_products[section.settings.left_product] %}

    {% for block in section.blocks %}
      {% assign product = all_products[block.settings.product] %}

      <div class="swiper-slide">
        <div class="product-dual-slide">
          
          <!-- LEFT IMAGE FROM BLOCK -->
          <div class="dual-left">
            {% if block.settings.left_image %}
              <img src="{{ block.settings.left_image | image_url: width: 1000 }}">
            {% else %}
              <div style="padding:50px; background:#eee; text-align:center;">Upload left image</div>
            {% endif %}
            <product-form-component
  class="left-{{ section.id }}-{{ left_product.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ left_product.id }}"
  style="opacity:0; visibility:hidden;"
>
  {% form 'product', left_product %}
    <input
      type="hidden"
      name="id"
      value="{{ left_product.selected_or_first_available_variant.id }}"
    >
    <button type="submit" class="quick-add__button"></button>
  {% endform %}
</product-form-component>

            
               <div class="add-btn add-to-cart-btn"
  onclick="document
    .querySelector('.left-{{ section.id }}-{{ left_product.id }} .quick-add__button')
    .click()" style="position: absolute;bottom: 30px;left: 50%;transform: translateX(-50%);padding: 17px 30px;" class="add-btn add-to-cart-btn" onclick="document.querySelector('.m{{ section.id }}-{{ product.id }} .quick-add__button').click()">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 0H9V20H11V0Z" fill="#97371E"/>
              <path d="M20 9H0V11H20V9Z" fill="#97371E"/>
              </svg>
  
                  Add to Cart
              </div>
              {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
              <product-form-component 

                data-section-id="{{ section.id }}"
                data-product-id="{{ product.id }}"
                data-product-url="{{ product.url }}"
                on:submit="/handleSubmit"
                style="opacity: 0;visibility: hidden;"
                class="m{{ section.id }}-{{ product.id }}"
                data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
                data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}">
                <div
                  class="visually-hidden"
                  aria-live="assertive"
                  role="status"
                  aria-atomic="true"
                  ref="liveRegion"
                ></div>
                {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                  <input
                    type="hidden"
                    name="id"
                    ref="variantId"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <div
                    class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
                    
                    ref="productFormButtons"
                  >
                    {%- liquid
                      assign has_quantity_rules = false
                      if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
                        assign has_quantity_rules = true
                      endif
                    -%}
                      <button class="quick-add__button" type="sumbit">aaaaa</button>
                  </div>
                {%- endform -%}
              </product-form-component>
          </div>
          
          <div class="dual-right">
            {% if product %}
                <h6>{{ product.category }}</h6>
                <a href="https://www.pranabeauty.com/pages/prana-glow-quiz">
