                <path d="M17.9314 18.191L18.319 19.2591C18.7443 20.4406 19.6801 21.3764 20.8616 21.8017L21.9297 22.1893C22.0242 22.2271 22.0242 22.3594 21.9297 22.3972L20.8616 22.7848C19.6801 23.2101 18.7443 24.1459 18.319 25.3274L17.9314 26.3955C17.8936 26.49 17.7613 26.49 17.7235 26.3955L17.3359 25.3274C16.9106 24.1459 15.9748 23.2101 14.7933 22.7848L13.7252 22.3972C13.6307 22.3594 13.6307 22.2271 13.7252 22.1893L14.7933 21.8017C15.9748 21.3764 16.9106 20.4406 17.3359 19.2591L17.7235 18.191C17.7613 18.0965 17.8936 18.0965 17.9314 18.191Z" fill="#97371E"/>
                </svg></a>
              <a href="{{ product.url }}">
              <img class="product-image" src="{{ product.featured_image | image_url: width: 700 }}" width=" " height="">
              </a>
             
                {% comment %} rating {% endcomment %}
                  <div class="loox-rating" data-id="{{ product.id }}" data-rating="{{ product.metafields.loox.avg_rating }}" data-raters="{{ product.metafields.loox.num_reviews }}"></div>
                {% comment %} end rating {% endcomment %}

              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

              <p>From {{ product.price | money }}</p>

              
               <div class="add-btn add-to-cart-btn" onclick="document.querySelector('.m{{ section.id }}-{{ product.id }} .quick-add__button').click()">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 0H9V20H11V0Z" fill="#97371E"/>
              <path d="M20 9H0V11H20V9Z" fill="#97371E"/>
              </svg>
                  Add to Cart
              </div>
              {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
              <product-form-component 

                data-section-id="{{ section.id }}"
                data-product-id="{{ product.id }}"
                data-product-url="{{ product.url }}"
                on:submit="/handleSubmit"
                style="opacity: 0;visibility: hidden;"
                class="m{{ section.id }}-{{ product.id }}"
                data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
                data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}">
                <div
                  class="visually-hidden"
                  aria-live="assertive"
                  role="status"
                  aria-atomic="true"
                  ref="liveRegion"
                ></div>
                {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                  <input
                    type="hidden"
                    name="id"
                    ref="variantId"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <div
                    class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
                    
                    ref="productFormButtons"
                  >
                    {%- liquid
                      assign has_quantity_rules = false
                      if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
                        assign has_quantity_rules = true
                      endif
                    -%}
                      <button class="quick-add__button" type="sumbit">aaaaa</button>
                  </div>
                {%- endform -%}
              </product-form-component>

              {% if section.blocks.size > 1 %}
                <div class="slider-arrows">
                  <div class="custom-arrow custom-prev custom-prev-{{ section.id }}">
                      <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M0.259121 9.17002L9.11942 0.30972C9.43771 -0.0618701 9.99738 -0.105273 10.369 0.213015C10.7406 0.531304 10.784 1.09097 10.4657 1.46256C10.436 1.49759 10.404 1.52957 10.369 1.55927L3.02396 8.91341H38.1019C38.5916 8.91341 38.9883 9.31013 38.9883 9.79974C38.9883 10.2894 38.5916 10.6861 38.1019 10.6861H3.0232L10.3682 18.0311C10.7398 18.3494 10.7832 18.909 10.4649 19.2806C10.1466 19.6522 9.58695 19.6956 9.21536 19.3773C9.1811 19.3476 9.14835 19.3157 9.11866 19.2806L0.258358 10.4203C-0.0850601 10.0746 -0.0850601 9.51648 0.258358 9.17078L0.259121 9.17002Z" fill="#443531"/>
                      </svg>
                  </div>
                  <div class="custom-arrow custom-next custom-next-{{ section.id }}">
                      <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M38.7292 9.17002L29.8689 0.30972C29.5506 -0.0618701 28.9909 -0.105273 28.6193 0.213015C28.2477 0.531304 28.2043 1.09097 28.5226 1.46256C28.5523 1.49759 28.5843 1.52957 28.6193 1.55927L35.9643 8.91341H0.886335C0.396718 8.91341 0 9.31013 0 9.79974C0 10.2894 0.396718 10.6861 0.886335 10.6861H35.9651L28.6201 18.0311C28.2485 18.3494 28.2051 18.909 28.5234 19.2806C28.8417 19.6522 29.4013 19.6956 29.7729 19.3773C29.8072 19.3476 29.8399 19.3157 29.8696 19.2806L38.7299 10.4203C39.0733 10.0746 39.0733 9.51648 38.7299 9.17078L38.7292 9.17002Z" fill="#443531"/>
                      </svg>
                  </div>
                </div>
              {% endif %}
            {% else %}
              <p>Select a product</p>
            {% endif %}
          </div>

        </div>
      </div>

    {% endfor %}
  </div>


</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  new Swiper(".productDualSwiper", {
    slidesPerView: 1,
    navigation: {
      nextEl: ".custom-next-{{ section.id }}",
      prevEl: ".custom-prev-{{ section.id }}",
    },
    loop: true
  });

});
</script>


{% schema %}
{
  "name": "Image With Product Slider",
  "settings": [
    {
  "type": "product",
  "id": "left_product",
  "label": "Left side product"
}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product Slide",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "left_image",
          "label": "Left Side Image (Model Image)"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Image With Product Slider"
    }
  ]
}
{% endschema %}
