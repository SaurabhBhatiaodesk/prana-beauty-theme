{%- render 'ptm-assets' -%}
<div class="ptm">
<section class="tm-chain" aria-label="{{ section.settings.label | escape }}">
  <div class="tm-wrap">
    <ol>
      {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>{%- endfor -%}
    </ol>
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: Provenance chain",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [{ "type": "link", "name": "Chain step", "settings": [
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "text", "label": "Text" }
  ] }],
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "From root to jar" }
  ],
  "presets": [{ "name": "PDP: Provenance chain" }]
}
{% endschema %}
