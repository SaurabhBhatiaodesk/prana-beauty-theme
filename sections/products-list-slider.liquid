<section class="product-list-slider">
  <div class="pls-header">
    <div>
        {% if section.settings.heading %}
        <h2 class="pls-title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.des %}
        <p class="pls-des">{{ section.settings.des }}</p>
        {% endif %}
    </div>
    {% if section.settings.button_label and section.settings.button_link %}
      <a href="{{ section.settings.button_link }}" class="pls-button">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3.18494 0.000976562V1.38H10.827L0 12.051L1 13.0391L11.827 2.36804V9.90002H13.2269V0L3.18494 0.000976562Z" fill="black"/>
        <path d="M0 12.051L10.827 1.38098H3.18396V0.000976562H13.229V9.901H11.829V2.36902L1.00195 13.0391L0 12.051Z" fill="#1B1716"/>
        </svg>

        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>

  <div class="swiper product-list-swiper">
    <div class="swiper-wrapper">

      {% assign coll = collections[section.settings.collection] %}
      {% if coll %}
        {% for product in coll.products %}
          <div class="swiper-slide">
            <a href="{{ product.url }}" class="pls-item">
              <div class="pls-image">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title }}" width="" height="">
                {% endif %}

              </div>
              {% comment %} {% for tag in product.tags %}
                {% if tag contains 'NEW ARRIVAL' %}
                  <span class="new-tag">{{ tag }}</span>
                {% endif %}
                {% if tag contains 'BEST SELLER' %}
                  <span class="best-tag">{{ tag }}</span>
                {% endif %}
              {% endfor %} {% endcomment %}
              
              {% assign my_obj = product.metafields.custom.custom_tags.value %}
              {% if my_obj %}
                <span class="new-tag" style="background: {{ my_obj.tag_background }};">{{ my_obj.tag_name }}</span>
              {% endif %}

              {% comment %} rating {% endcomment %}
              <div class="loox-rating" data-id="{{ product.id }}" data-rating="{{ product.metafields.loox.avg_rating }}" data-raters="{{ product.metafields.loox.num_reviews }}"></div>
              {% comment %} end rating {% endcomment %}

              <h3 class="pls-prod-title">{{ product.title }}</h3>

              {% if section.settings.show_price %}
               <p class="pls-price">From {{ product.price | money }}</p>
              {% endif %}

            </a>
           
            <div class="add-btn pls-add-btn" onclick="document.querySelector('.m{{ section.id }}-{{ product.id }} .quick-add__button').click()">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 0H9V20H11V0Z" fill="#97371E"/>
              <path d="M20 9H0V11H20V9Z" fill="#97371E"/>
              </svg>
                  Add to Cart
              </div>
              {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
              <product-form-component 

                data-section-id="{{ section.id }}"
                data-product-id="{{ product.id }}"
                data-product-url="{{ product.url }}"
                on:submit="/handleSubmit"
                style="opacity: 0;visibility: hidden;"
                class="m{{ section.id }}-{{ product.id }}"
                data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
                data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}">
                <div
                  class="visually-hidden"
                  aria-live="assertive"
                  role="status"
                  aria-atomic="true"
                  ref="liveRegion"
                ></div>
                {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                  <input
                    type="hidden"
                    name="id"
                    ref="variantId"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <div
                    class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
                    
                    ref="productFormButtons"
                  >
                    {%- liquid
                      assign has_quantity_rules = false
                      if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
                        assign has_quantity_rules = true
                      endif
                    -%}
                      <button class="quick-add__button" type="sumbit">aaaaa</button>
                  </div>
                {%- endform -%}
              </product-form-component>
          </div>
        {% endfor %}
      {% endif %}

    </div>
    {% if section.settings.button_label and section.settings.button_link %}
      <a href="{{ section.settings.button_link }}" class="pls-button desktop-hide">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3.18494 0.000976562V1.38H10.827L0 12.051L1 13.0391L11.827 2.36804V9.90002H13.2269V0L3.18494 0.000976562Z" fill="black"/>
        <path d="M0 12.051L10.827 1.38098H3.18396V0.000976562H13.229V9.901H11.829V2.36902L1.00195 13.0391L0 12.051Z" fill="#1B1716"/>
        </svg>

        {{ section.settings.button_label }}
      </a>
    {% endif %}
    <div class="pls-controls">
      <div class="swiper-pagination swiper-scrollbar"></div>

      <div class="custom-arrows">
        <div class="custom-arrow custom-prev">
            <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.259121 9.17002L9.11942 0.30972C9.43771 -0.0618701 9.99738 -0.105273 10.369 0.213015C10.7406 0.531304 10.784 1.09097 10.4657 1.46256C10.436 1.49759 10.404 1.52957 10.369 1.55927L3.02396 8.91341H38.1019C38.5916 8.91341 38.9883 9.31013 38.9883 9.79974C38.9883 10.2894 38.5916 10.6861 38.1019 10.6861H3.0232L10.3682 18.0311C10.7398 18.3494 10.7832 18.909 10.4649 19.2806C10.1466 19.6522 9.58695 19.6956 9.21536 19.3773C9.1811 19.3476 9.14835 19.3157 9.11866 19.2806L0.258358 10.4203C-0.0850601 10.0746 -0.0850601 9.51648 0.258358 9.17078L0.259121 9.17002Z" fill="#443531"/>
            </svg>
        </div>
        <div class="custom-arrow custom-next">
            <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M38.7292 9.17002L29.8689 0.30972C29.5506 -0.0618701 28.9909 -0.105273 28.6193 0.213015C28.2477 0.531304 28.2043 1.09097 28.5226 1.46256C28.5523 1.49759 28.5843 1.52957 28.6193 1.55927L35.9643 8.91341H0.886335C0.396718 8.91341 0 9.31013 0 9.79974C0 10.2894 0.396718 10.6861 0.886335 10.6861H35.9651L28.6201 18.0311C28.2485 18.3494 28.2051 18.909 28.5234 19.2806C28.8417 19.6522 29.4013 19.6956 29.7729 19.3773C29.8072 19.3476 29.8399 19.3157 29.8696 19.2806L38.7299 10.4203C39.0733 10.0746 39.0733 9.51648 38.7299 9.17078L38.7292 9.17002Z" fill="#443531"/>
            </svg>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product List Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "des",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    { "name": "Product List Slider" }
  ]
}
{% endschema %}

<style>
.product-list-slider { padding-bottom: 1rem; }

.pls-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding: 0 16px;
  margin-top: 25px;
}
.pls-header div {
    display: flex;
    align-items: center;
}
.product-list-slider .pls-des {
    margin: 0 0 0 15px;
    font-family: 'Josefin Sans';
    color: #4E403C;
    font-size: 21px;
    font-weight: 300;
    letter-spacing: -1px;
}
.product-list-slider .pls-title {
    font-family: 'Josefin Sans';
    letter-spacing: 0 !important;
    margin: 0;
    color: #4E403C;
    font-size: 25px;
}

.pls-button {
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  text-transform: uppercase;
  line-height: 14px;
  padding: 18px 37px;
  background: #ECCA6F;
  font-family: 'Josefin Sans';
  color: #1B1716;
}
.pls-button svg {
  margin-right: 8px;
}

.pls-image {
  width: 100%;
  aspect-ratio: 1/1;
  overflow: hidden;
  height: 300px;
}

.pls-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}
.pls-prod-title {
    text-align: center;
    margin: 10px 0;
    font-weight: 400;
    font-size: 19px;
    font-family: 'Josefin Sans';
    color: #4E403C;
    text-transform: uppercase;
    height: 45px;
     letter-spacing: -1px;
}

.pls-price {
  text-align: center;
  font-size: 18px;
  margin: 0;
  font-weight: 400;
  font-family: 'Josefin Sans';
  color: #4E403C;
  text-transform: uppercase;
}

.pls-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40px;
}

.swiper-scrollbar { background: #ddd; height: 4px; width: 85%; position: relative !important;}
.swiper-scrollbar-drag { background: #97371E; }

.custom-arrows {
  display: flex;
  gap: 20px;
  align-items: center;
}
.custom-arrow {
  cursor: pointer;
  font-size: 26px;
  user-select: none;
}
.product-list-slider .swiper-slide {
    background: #FDFCFB;
    padding: 15px;
}
.product-list-slider .pls-add-btn {
    background: #F4F1EA;
    border: none;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Josefin Sans';
    display: flex;
    max-width: 100%;
    width: 100%;
    color: #1B1716;
    text-transform: uppercase;
    padding: 16px;
    margin-top: 15px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
}
.product-list-slider .pls-add-btn svg {
    margin-right: 8px;
}
.svg{
    text-align: center;
    margin: 10px auto 15px;
    display: flex;
}
a.pls-button.desktop-hide {
    display: none;
}


@media screen and (max-width: 767px) {
  .pls-button {
    display: none;
  }
  .pls-header div {
    align-items: baseline;
    flex-direction: column;
    max-width: 100%;
    width: 100%;
  }
  .pls-prod-title {
    font-size: 14px;
    height: 34px;
 }
 .pls-price {
    font-size: 14px;
 }
 .product-list-slider .pls-title {
    margin: 2px auto 0 !important;
    text-align: center;
    padding: 0;
    text-transform: uppercase;
 }
 .product-list-slider .pls-des {
      display: block!important;
      text-align: center;
      margin: 0 auto;
      padding: 0;
    }
    a.pls-button.desktop-hide {
    display: flex!important;
            align-items: center;
        justify-content: center;
        max-width: 200px;
        margin: 25px auto;
}
}
</style>



<script>
document.addEventListener("DOMContentLoaded", () => {
  const sliders = document.querySelectorAll(".product-list-swiper");

  sliders.forEach(slider => {
    new Swiper(slider, {
      slidesPerView: 1.5,
      spaceBetween: 10,
      loop: true,
      navigation: {
        nextEl: slider.querySelector(".custom-next"),
        prevEl: slider.querySelector(".custom-prev"),
      },
      scrollbar: {
        el: slider.querySelector(".swiper-pagination"),
        draggable: true,
        dragSize: 300
      },
      breakpoints: {
        768: { slidesPerView: 1.4, centeredSlides: true },
        1024: { slidesPerView: 3.7 }
      }
    });
  });
});
</script>