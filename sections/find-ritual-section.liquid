<section class="fyr-section" id="findYourRitual">
  <div class="section">
    <div class="fyr-header">
      {% if section.settings.caption != blank %}
        <p class="rule rule-c reveal">
          {{ section.settings.caption }}
        </p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="sec-h2 reveal d1">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="fyr-sub reveal d2">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    <div class="fyr-grid">
      <!-- LEFT -->

      <div class="fyr-panel fyr-scan">
        {% if section.settings.badge != blank %}
          <div class="fyr-panel-badge">
            {{ section.settings.badge }}
          </div>
        {% endif %}

        <div class="scan-vis fyr-vis">
          <div class="sfc">
            <div class="sr4"></div>

            <div class="sr sr1"></div>

            <div class="sr sr2"></div>

            <div class="sr sr3"></div>

            <div class="scan-sweep"></div>

            <div class="ldot" style="top:27%;left:30%"></div>

            <div class="ldot" style="top:27%;right:26%;animation-delay:.7s"></div>

            <div class="ldot" style="top:47%;left:50%;transform:translateX(-50%);animation-delay:1.4s"></div>

            <div class="ldot" style="top:63%;left:36%;animation-delay:.35s"></div>

            <div class="ldot" style="top:63%;right:32%;animation-delay:1.1s"></div>

            <div class="dchips l">
              <div class="dc">
                {{ section.settings.chip_1 | default: 'Hydration' }}
              </div>

              <div class="dc">
                {{ section.settings.chip_2 | default: 'Pigmentation' }}
              </div>

              <div class="dc">
                {{ section.settings.chip_3 | default: 'Texture' }}
              </div>
            </div>

            <div class="dchips r">
              <div class="dc">
                {{ section.settings.chip_4 | default: 'Elasticity' }}
              </div>

              <div class="dc">
                {{ section.settings.chip_5 | default: 'Radiance' }}
              </div>

              <div class="dc">
                {{ section.settings.chip_6 | default: 'Barrier' }}
              </div>
            </div>

            <div class="face-sil"></div>
          </div>
        </div>

        <div class="fyr-copy">
          <div class="scan-live">
            <span class="sl-dot"></span>

            <span class="sl-txt">
              {{ section.settings.scan_live }}
            </span>
          </div>

          <div class="content-fyr-main">
            <div class="content-fyr-top">
              <h3 class="fyr-panel-h">
                {{ section.settings.label }}
              </h3>

              <h3 class="fyr-panel-h-highlight">
                {{ section.settings.highlight }}
              </h3>

              <h3 class="fyr-panel-h-normal">
                {{ section.settings.normal }}
              </h3>
            </div>

            <div class="fyr-steps">
              <div class="fyr-step">
                <span class="fyr-sn">01</span>

                <span>{{ section.settings.step1 }}</span>
              </div>

              <div class="fyr-step">
                <span class="fyr-sn">02</span>

                <span>{{ section.settings.step2 }}</span>
              </div>

              <div class="fyr-step">
                <span class="fyr-sn">03</span>

                <span>{{ section.settings.step3 }}</span>
              </div>
            </div>
          </div>

          {% if section.settings.btn_txt != blank %}
            <a
              href="{{ section.settings.btn_link }}"

              class="fyr-cta-scan btn btn-gold"
            >
              <span class="scan-icon"></span>

              {{ section.settings.btn_txt }}
            </a>
          {% endif %}

          {% if section.settings.note != blank %}
            <div class="fyr-note">
              {{ section.settings.note }}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- OR -->

      <div class="fyr-or">
        <div class="fyr-or-line"></div>

        <div class="fyr-or-badge">
          {{ section.settings.or_text | default: 'OR' }}
        </div>

        <div class="fyr-or-line"></div>
      </div>

      <!-- RIGHT -->

      <div class="fyr-panel fyr-quiz-panel">
        {% if section.settings.badge_quiz != blank %}
          <div class="fyr-panel-badge fyr-badge-quiz">
            {{ section.settings.badge_quiz }}
          </div>
        {% endif %}

        <h3 class="fyr-panel-h" style="color:var(--canvas)">
          {{ section.settings.title_quiz }}
        </h3>

        <p class="fyr-quiz-desc">
          {{ section.settings.desc_quiz }}
        </p>

        <div class="fyr-quiz-trust">
          <li>{{ section.settings.trust_quiz1 }}</li>

          <li>{{ section.settings.trust_quiz2 }}</li>
        </div>

        <prana-ritual-quiz
          class="fyr-quiz-widget"

          data-api-url="{{ section.settings.quiz_api_url | default: '/apps/dosha-quiz/quiz?code=1791954993424' | escape }}"

          data-skip="{{ section.settings.skip_text | default: 'Skip' | escape }}"

          data-email-placeholder="{{ section.settings.email_placeholder | default: 'your@email.com' | escape }}"

          data-loading="{{ 'prana_quiz.loading' | t | escape }}"

          data-error="{{ 'prana_quiz.error' | t | escape }}"

          data-empty="{{ 'prana_quiz.empty' | t | escape }}"

          data-retry="{{ 'prana_quiz.retry' | t | escape }}"

          data-progress="{{ 'prana_quiz.progress' | t | escape }}"

          data-restart="{{ section.settings.restart_text | escape }}"
        >
          <p class="fyr-quiz-step-label" role="status">{{ 'prana_quiz.loading' | t }}</p>
        </prana-ritual-quiz>

        <script src="{{ 'prana-ritual-quiz.js' | asset_url }}" defer></script>
      </div>
    </div>
  </div>
</section>

<style>
  /* Compact product recommendations. Card display only; quiz logic unchanged. */
  .fyr-product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 190px));
    gap: 10px;
    margin: 12px 0 16px;
    justify-content: start;
  }
  .fyr-product-card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    padding: 7px;
    background: var(--canvas2);
    color: var(--ink3);
    border: 1px solid rgba(200, 146, 26, 0.3);
    border-radius: 8px;
    text-decoration: none;
    overflow: hidden;
  }
  .fyr-product-card img {
    display: block;
    width: 100%;
    height: 150px;
    object-fit: contain;
    border-radius: 4px;
  }
  .fyr-product-title {
    font-size: 13px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .fyr-product-price {
    margin-top: auto;
    font-size: 13px;
    font-weight: 600;
  }
  .fyr-product-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }
  @media (max-width: 600px) {
    .fyr-product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .fyr-product-card {
      padding: 7px;
    }
    .fyr-product-card img {
      height: 120px;
    }
    .fyr-product-title,
    .fyr-product-price {
      font-size: 12px;
    }
  }

  prana-ritual-quiz {
    display: block;
  }

  .fyr-email-input {
    width: 100%;
    padding: 14px;
    margin-bottom: 16px;
    background: var(--canvas2);
    color: var(--ink3);
    border: 1px solid var(--gold);
    border-radius: 4px;
  }

  /* ── FIND YOUR RITUAL COMBINED ── */

  .fyr-section {
    background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);

    padding: 58px 0px;
  }

  .fyr-header {
    text-align: center;

    margin-bottom: 39px;
  }

  .fyr-header h2 {
    font-size: 41px;

    color: var(--heading-color);

    padding: 10px 0 0 0;

    margin: 0;
  }

  .fyr-sub {
    font-family: var(--S);

    font-size: 17px;

    color: var(--ink3);

    max-width: 560px;

    margin: 5px auto 0;

    line-height: normal;
  }

  .fyr-grid {
    display: grid;

    grid-template-columns: 1fr 80px 1fr;

    gap: 0;

    align-items: stretch;
  }

  .fyr-panel {
    position: relative;
  }

  .fyr-panel-badge {
    position: static;

    font-size: 11px;

    letter-spacing: 0.28em;

    text-transform: uppercase;

    background: var(--gold);

    padding: 5px 12px;

    z-index: 2;

    border-radius: 4px;

    width: fit-content;

    color: #fff;

    margin: 22px;
  }

  .fyr-badge-quiz {
    margin: 0;
  }

  /* Left panel — scan (canvas bg) */

  .fyr-scan {
    background: var(--canvas2);

    display: grid;

    grid-template-rows: 1fr auto;

    min-height: 600px;
  }

  .fyr-vis {
    padding: 40px;

    display: flex;

    align-items: center;

    justify-content: center;

    min-height: 280px;
  }

  .fyr-copy {
    padding: 32px 40px 48px;

    border-top: 1px solid var(--gold-line);
  }

  .fyr-panel-h {
    color: var(--ink);

    line-height: 1.05;

    margin: 0;
  }

  .fyr-copy h3 {
    color: var(--ink3);

    font-size: 30px;

    font-weight: 300;
  }

  h3.fyr-panel-h-highlight {
    color: var(--heading-color);

    padding: 12px 0;
  }

  .fyr-steps {
    display: flex;

    flex-direction: column;

    gap: 0px;

    margin: 10px 0 24px 0;
  }

  .fyr-step {
    display: flex;

    align-items: flex-start;

    gap: 14px;

    font-family: var(--S);

    font-size: 21px;

    color: var(--ink3);

    line-height: 1.6;
  }

  .fyr-sn {
    font-family: var(--U);

    font-size: 21px;

    letter-spacing: 0.14em;

    color: var(--gold);

    padding-top: 2px;

    flex-shrink: 0;

    width: 20px;
  }

  .fyr-cta-scan {
    width: 100%;

    justify-content: center;

    margin-bottom: 10px;
  }

  .fyr-note {
    font-family: var(--S);

    font-size: 16px;

    color: var(--ink3);
  }

  /* OR divider */

  .fyr-or {
    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    background: var(--canvas-dk);

    gap: 0;
  }

  .fyr-or-line {
    flex: 1;

    width: 1px;

    background: rgba(200, 146, 26, 0.15);
  }

  .fyr-or-badge {
    font-family: var(--U);

    font-size: 10px;

    letter-spacing: 0.24em;

    color: var(--ink4);

    padding: 16px 0;

    writing-mode: vertical-lr;

    text-orientation: mixed;
  }

  p.where-should-we-send {
    color: white;

    font-size: 15px;

    padding-bottom: 10px;
  }

  /* Right panel — quiz (dark bg) */

  .fyr-quiz-panel {
    background: linear-gradient(-90deg, #461324, #813850);

    padding: 48px 40px;

    display: flex;

    flex-direction: column;

    justify-content: flex-start;
  }

  .fyr-quiz-panel .fyr-panel-h {
    padding: 20px 0 10px 0;
  }

  .fyr-quiz-desc {
    font-family: var(--S);

    font-size: 15px;

    color: white;

    line-height: normal;

    margin-bottom: 16px;
  }

  .fyr-quiz-trust {
    display: flex;

    flex-direction: column;

    gap: 5px;

    margin: 0 0 28px 13px;
  }

  .fyr-quiz-trust li {
    font-family: var(--S);

    font-size: 15px;

    color: white;
  }

  .fyr-quiz-widget {
    flex: 1;
  }

  .fyr-quiz-step-label {
    font-family: var(--U);

    font-size: 16px;

    color: white;

    margin-bottom: 11px;
  }

  .fyr-quiz-q {
    font-family: var(--D);

    font-size: clamp(22px, 2.5vw, 28px);

    font-weight: 300;

    color: white;

    line-height: 1.2;

    margin-bottom: 20px;
  }

  .fyr-quiz-opts {
    display: flex;

    flex-direction: column;

    gap: 8px;
  }

  .fyr-quiz-opt {
    background: var(--canvas2);

    border: 1px solid rgba(248, 242, 230, 0.1);

    color: var(--ink3);
    border-radius: 4px;
    font-size: 16px;

    padding:6px 18px;

    text-align: left;

    cursor: pointer;

    transition: all 0.18s;
  }

  .fyr-quiz-opt.selected {
    background: rgba(200, 146, 26, 0.12);

    border-color: rgba(200, 146, 26, 0.4);

    color: var(--canvas);
  }

  .fyr-result-badge {
    font-family: var(--U);

    font-size: 16px;

    text-transform: capitalize;

    color: white;

    margin-bottom: 4px;
  }

  .fyr-result-name {
    font-family: var(--D);

    font-size: 26px;

    font-weight: 300;

    color: var(--canvas);

    margin-bottom: 8px;
  }

  .fyr-result-desc {
    font-family: var(--S);

    font-size: 15px;

    color: white;

    line-height: 1.7;

    margin-bottom: 16px;
  }

  .fyr-result-price {
    font-family: var(--D);

    font-size: 28px;

    color: white;

    margin-bottom: 16px;
  }

  .fyr-result-cta {
    width: 100%;

    background: var(--gold);

    color: var(--canvas);

    border: none;

    padding: 11px 24px;

    font-size: 17px;

    letter-spacing: unset;

    text-transform: capitalize;

    cursor: pointer;

    transition: background 0.2s;

    margin-bottom: 8px;

    border-radius: 5px;
  }

  .fyr-result-cta:hover {
    background: #c8881e;
  }

  /* ── MOBILE ── */

  @media (max-width: 768px) {
    .fyr-section {
      padding: 29px 0 48px 0px;
    }

    .fyr-section .section {
      display: block;
    }

    .fyr-grid {
      grid-template-columns: 1fr;

      grid-template-rows: auto auto auto;
    }

    .fyr-or {
      flex-direction: row;

      background: transparent;

      padding: 16px 0;

      border-top: 1px solid var(--canvas-dk);

      border-bottom: 1px solid var(--canvas-dk);

      display: none;
    }

    .fyr-quiz-opts {
      display: grid;

      grid-template-columns: 1fr 1fr;

      gap: 8px;
    }

    .fyr-or-line {
      flex: 1;

      height: 1px;

      width: auto;
    }

    .fyr-quiz-opt {
      font-size: 14px;

      padding: 5px 10px;
    }

    .fyr-or-badge {
      writing-mode: horizontal-tb;

      padding: 0 16px;

      font-size: 11px;
    }

    .fyr-panel-badge {
      display: none;
    }

    .fyr-scan {
      min-height: auto;

      background: transparent;
    }

    .fyr-vis {
      padding: 28px 24px;

      min-height: 220px;
    }

    .fyr-result-badge {
      font-size: 13px;

      margin-bottom: 4px;
    }

    .fyr-copy {
      padding: 24px;

      background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
    }

    .fyr-panel-h {
      font-size: 19px;
    }

    .fyr-quiz-panel {
      padding: 24px 16px;
    }

    .fyr-quiz-q {
      font-size: 15px;
    }

    .hp-video-section .vid-placeholder {
      height: 280px;
    }

    .fyr-quiz-desc {
      font-size: 16px;

      margin-bottom: 8px;

      line-height: 21px;
    }

    .fyr-quiz-trust li {
      font-size: 14px;
    }

    .fyr-quiz-panel .fyr-panel-h {
      padding: 0px 0 10px 0;
    }

    .hp-video-section [style*='bottom:36px'] {
      left: 20px;

      right: 20px;

      bottom: 20px;
    }

    .fyr-quiz-step-label {
      font-size: 14px;

      margin-bottom: 7px;
    }

    .fyr-result-name {
      font-size: 17px;

      margin-bottom: 0;
    }

    .fyr-result-desc {
      font-size: 13px;

      line-height: normal;

      margin: 4px 0 13px;
    }

    .hp-quiz-restart {
      font-size: 13px;

      padding: 5px;
    }

    .fyr-result-cta {
      padding: 5px 24px;

      font-size: 13px;
    }

    .fyr-header h2 {
      font-size: 20px;

      padding: 0;
    }

    .fyr-copy h3 {
      font-size: 18px;
    }

    .fyr-sn {
      font-size: 14px;

      line-height: 17px;
    }

    .fyr-step {
      font-size: 13px;

      line-height: 17px;

      gap: 1px;
    }

    .fyr-result-price {
      margin-bottom: 7px;

      font-size: 20px;
    }

    .fyr-header {
      margin-bottom: 3px;
    }

    .fyr-steps {
      margin: 10px 0 14px 0;
    }
  }

  @media all and (max-width: 480px) {
    .fyr-step {
      font-size: 14px;

      line-height: 20px;

      gap: 1px;
    }

    .content-fyr-main {
      gap: 10px;

      display: flex;

      margin-bottom: 11px;

      align-items: end;
    }

    .fyr-copy h3 {
      font-size: 14px;

      line-height: 21px;
    }

    .fyr-copy h3.fyr-panel-h-highlight {
      color: var(--heading-color);

      padding: 0;

      line-height: 21px;
    }

    .fyr-steps {
      margin: 0;
    }
  }
</style>

