<div class="map-sec">
  <div class="section">
    <div class="inner-map">
      {{ section.settings.map }}
    </div>
  </div>
</div>

<style>
    .map-sec .inner-map iframe {
        width: 100%;
        height: 450px;
        border: 0;
        display: block;
    }
    .map-sec{
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
      
    }

    @media screen and (max-width: 749px){
        .map-sec{
            padding-top: {{ section.settings.padding_top_mobile }}px;
            padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
        }
    }
</style>

{% schema %}
{
  "name": "Map Section",
  "settings": [
    {
      "type": "html",
      "id": "map",
      "label": "Map Embed Code",
      "info": "Paste Google Maps iframe code here."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Top Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Top Padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Map Section"
    }
  ]
}
{% endschema %}