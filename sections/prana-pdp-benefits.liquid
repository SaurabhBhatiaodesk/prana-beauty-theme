{{ 'prana-mask-pdp.css' | asset_url | stylesheet_tag }}
<div class="prana-mask-pdp pm-pdp-benefits">
<section class="pm-benefits pm-wrap" aria-labelledby="ben-h-{{ section.id }}">
      <h2 id="ben-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% assign default_icons = 'sun,sparkle,circle-dots,feather,target,droplet' | split: ',' %}
      <ul class="pm-benefit-grid">
        {% for block in section.blocks %}
          {% assign icon_index = forloop.index0 | modulo: 6 %}{% assign icon_name = block.settings.icon %}{% if icon_name == blank or icon_name == 'auto' %}{% assign icon_name = default_icons[icon_index] %}{% endif %}
          <li class="pm-benefit-card" {{ block.shopify_attributes }}><span class="pm-icon-badge">{% render 'prana-pdp-icon', name: icon_name %}</span><div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text | escape }}</p></div></li>
        {% endfor %}
      </ul>
      <p class="pm-free">*4-week independent consumer perception study, 50 participants. Individual results may vary.<br>Vegan and cruelty-free, with botanical and mineral actives. Free from parabens, sulfates and synthetic fragrance.</p>
    </section>
</div>
{% schema %}
{
  "name": "PRANA PDP Benefits",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What it does for your skin"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "auto",
          "options": [{"value":"auto","label":"Automatic"},{"value":"droplet","label":"Droplet"},{"value":"brush","label":"Brush"},{"value":"clock","label":"Clock"},{"value":"waves","label":"Water"},{"value":"sun","label":"Sun"},{"value":"sparkle","label":"Sparkle"},{"value":"circle-dots","label":"Pores"},{"value":"feather","label":"Feather"},{"value":"target","label":"Target"},{"value":"leaf","label":"Leaf"},{"value":"map-pin","label":"Map pin"},{"value":"flask","label":"Flask"},{"value":"clipboard","label":"Clipboard"},{"value":"jar","label":"Jar"},{"value":"shield","label":"Shield"},{"value":"truck","label":"Truck"}]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA PDP Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Brighter-looking skin",
            "text": "Turmeric and three clays leave skin looking fresh and luminous"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Clearer, more even-looking skin in 4 weeks",
            "text": "91% agreed in our consumer study*"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Pores look smaller",
            "text": "86% agreed in our consumer study*"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Calms the look of redness",
            "text": "Sandalwood and rose cool skin as you rinse"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Blemish marks look less visible",
            "text": "Turmeric evens out the look of dark spots and uneven tone"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "title": "Hydrating, never drying",
            "text": "84% said it left skin neither tight nor dry*"
          }
        }
      ]
    }
  ]
}
{% endschema %}
