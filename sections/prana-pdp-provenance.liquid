{{ 'prana-mask-pdp.css' | asset_url | stylesheet_tag }}
<div class="prana-mask-pdp pm-pdp-provenance">
<section class="pm-chain" aria-labelledby="chain-h-{{ section.id }}">
  <div class="pm-wrap">
    {% if section.settings.heading != blank %}<h2 class="pm-chain-title" id="chain-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
    <ol class="pm-chain-steps">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <li {{ block.shopify_attributes }}><span class="pm-chain-node">{% render 'prana-pdp-icon', name: block.settings.icon %}</span><span class="pm-chain-label">{{ block.settings.label | escape }}</span><span class="pm-chain-value">{{ block.settings.value | escape }}</span></li>
        {% endfor %}
      {% else %}
        <li><span class="pm-chain-node">{% render 'prana-pdp-icon', name: 'leaf' %}</span><span class="pm-chain-label">Ingredient</span><span class="pm-chain-value">Kasthuri manjal root</span></li>
        <li><span class="pm-chain-node">{% render 'prana-pdp-icon', name: 'map-pin' %}</span><span class="pm-chain-label">Origin</span><span class="pm-chain-value">Tamil Nadu, India</span></li>
        <li><span class="pm-chain-node">{% render 'prana-pdp-icon', name: 'flask' %}</span><span class="pm-chain-label">Formulation</span><span class="pm-chain-value">Version 20 of 20</span></li>
        <li><span class="pm-chain-node">{% render 'prana-pdp-icon', name: 'clipboard' %}</span><span class="pm-chain-label">Testing</span><span class="pm-chain-value">4-week consumer study, 50 people</span></li>
        <li><span class="pm-chain-node">{% render 'prana-pdp-icon', name: 'jar' %}</span><span class="pm-chain-label">Finished product</span><span class="pm-chain-value">Made in India</span></li>
      {% endif %}
    </ol>
  </div>
</section>
</div>
{% schema %}
{
  "name": "PRANA PDP Provenance",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From root to jar"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "flask", "label": "Flask" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "jar", "label": "Jar" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA PDP Provenance"
    }
  ]
}
{% endschema %}
