{{ 'prana-mask-pdp.css' | asset_url | stylesheet_tag }}
{% assign bundle_id = section.settings.bundle_id | strip %}
<div class="prana-mask-pdp pm-pdp-bundle">
<section class="pm-wrap pm-bundle-wrap" aria-labelledby="set-h-{{ section.id }}">
  <div class="pm-set pm-bundle" data-pm-bundle data-bundle-id="{{ bundle_id | escape }}" data-shop="{{ shop.permanent_domain | escape }}" data-root="{{ routes.root_url }}" data-currency="{{ cart.currency.iso_code }}" data-shop-currency="{{ shop.currency }}" data-locale="{{ request.locale.iso_code }}" data-error="{{ section.settings.error_text | escape }}" data-added="{{ section.settings.added_text | escape }}">
    <div class="pm-bundle-copy">
      <h2 id="set-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.description != blank %}<p class="pm-bundle-desc">{{ section.settings.description | escape }}</p>{% endif %}
    </div>
    <div class="pm-bundle-buy">
      {% if bundle_id != blank %}
        <div class="pm-price" data-bundle-price hidden></div>
        <button type="button" class="pm-btn pm-bundle-add" data-bundle-add disabled>{{ section.settings.button_label | escape }}</button>
        <p class="pm-bundle-status" data-bundle-status role="status">{{ section.settings.loading_text | escape }}</p>
      {% elsif section.settings.bundle_link != blank %}
        <a class="pm-btn" href="{{ section.settings.bundle_link }}">{{ section.settings.link_label | escape }}</a>
      {% elsif request.design_mode %}
        <p class="pm-bundle-status">Add a Bundler Bundle ID to show the bundle price and Add to cart button.</p>
      {% endif %}
    </div>
  </div>
</section>
</div>
{% if bundle_id != blank %}<script type="module" src="{{ 'prana-pdp-bundle.js' | asset_url }}"></script>{% endif %}
{% schema %}
{
  "name": "PRANA PDP Bundle",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "bundle_id",
      "label": "Bundler Bundle ID",
      "info": "Price, discount and Add to cart come from this Bundler bundle. Example: ABHYANGA BUNDLE = 804729."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make it the ABHYANGA weekly ritual"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Rose Jasmine Milk Cleanser, this mask and the Saffron Glow Serum, together."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart label",
      "default": "Add the ritual set"
    },
    {
      "type": "url",
      "id": "bundle_link",
      "label": "Ritual page link",
      "info": "Used as the button link only when no Bundler Bundle ID is set."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Ritual page button label",
      "default": "Shop the ritual set"
    },
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading message",
      "default": "Loading ritual set…"
    },
    {
      "type": "text",
      "id": "added_text",
      "label": "Added message",
      "default": "Ritual set added to cart."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error message",
      "default": "This ritual set is currently unavailable. Please try again later."
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "PRANA PDP Bundle"
    }
  ]
}
{% endschema %}
