{{ 'prana-mask-pdp.css' | asset_url | stylesheet_tag }}
<div class="prana-mask-pdp pm-pdp-faq">
<section class="pm-wrap" style="padding-bottom:96px" aria-labelledby="faq-h-{{ section.id }}">
  <h2 id="faq-h-{{ section.id }}" style="font-size:clamp(32px,4vw,48px);margin-bottom:18px">{{ section.settings.heading | escape }}</h2>

  {% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div class="pm-body">{{ block.settings.text | escape }}</div></details>{% endfor %}
</section>
</div>
{% schema %}
{
  "name": "PRANA PDP Faq",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Details and questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA PDP Faq",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "title": "Which skin types is it for?",
            "text": "It's suitable for all skin types, and especially effective for acne-prone, oily and combination skin. The three clays absorb excess oil at different depths, and sandalwood and rose help calm the look of redness, so skin looks clearer without feeling stripped. If you're under a dermatologist's care or using prescription treatments, check with them before adding a new mask."
          }
        },
        {
          "type": "question",
          "settings": {
            "title": "How far before my wedding should I start?",
            "text": "Eight weeks gives you enough time to see a difference. Use it twice a week for the first four weeks, then weekly. Do your last mask two or three days before the ceremony rather than the night before, and never try a new product for the first time in the final week."
          }
        },
        {
          "type": "question",
          "settings": {
            "title": "Will a clay mask dry out my skin?",
            "text": "Kaolin, glycerin and caprylic/capric triglyceride keep the formula comfortable, which is why it rinses off soft rather than tight. Rinse while the mask is almost dry — letting it crack is what causes that stripped feeling."
          }
        },
        {
          "type": "question",
          "settings": {
            "title": "How often should I use it?",
            "text": "Once a week for most skin. Oily or breakout-prone skin can use it twice a week for the first four weeks, then drop to weekly. Not for daily use."
          }
        },
        {
          "type": "question",
          "settings": {
            "title": "Is it suitable for sensitive skin?",
            "text": "Yes, with care. No synthetic fragrance, parabens or alcohol. Start with 8 minutes, and patch test on your inner arm if you know you react to clays or botanical oils."
          }
        },
        {
          "type": "question",
          "settings": {
            "title": "Will the turmeric stain?",
            "text": "It's a refined root extract, not raw powder, so it won't stain skin. Rinse thoroughly and use a dark towel — traces can mark light fabric if not fully rinsed."
          }
        },
        {
          "type": "question",
          "settings": {
            "title": "Can I use it with the Saffron Glow Serum?",
            "text": "Yes. On mask nights, apply the serum right after rinsing. On other nights, use it after cleansing and toning as usual."
          }
        }
      ]
    }
  ]
}
{% endschema %}
