{% comment %}
  What Is Never In Section
  Header + stacked list cards with diamond icon
{% endcomment %}

<style>
/* ── SECTION ── */
.ni-section {
    background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
}

/* ── HEADER ── */
.ni-eyebrow {
    font-size: 14px;
    font-weight: 400;
    color: var(--ink3, #6b5645);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}
.ni-eyebrow::after {
  content: '';
  display: block;
  height: 1px;
  width: 70px;
  background: var(--gold);
}
.ni-heading {
    font-size: 36px;
    font-weight: 400;
    color:var(--ink3);
    line-height: 1.12;
    margin:0;
}
h2.ni-heading.highlight{
    color: var(--heading-color, #2c1f18);
    padding:10px 0;
}
.ni-subtext {
  font-size:16px;
  font-weight: 300;
  line-height: 1.75;
  color: var(--ink3, #6b5645);
}
.ni-subtext a {
  color: var(--gold, #A8681A);
  text-decoration: none;
}
.ni-subtext a:hover { text-decoration: underline; }
.ni-subtext-secondary {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.75;
  color: var(--ink3, #6b5645);
  margin: 0 0 28px;
}

/* ── LIST ── */
.ni-list {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap:12px;
    margin-top: 25px;
}
/* ── CARD ── */
.ni-card {
  background: #E3C39F;
  border-radius:8px;
  padding:40px 18px;
  display: flex;
  align-items: flex-start;
  gap: 18px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}


/* Diamond icon circle */
.ni-icon-wrap {
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: rgba(255,255,255,0.55);
  border: 1px solid rgba(168, 104, 26, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}
.ni-icon-wrap svg {
  width: 28px;
  height: 28px;
}

/* Card text */
.ni-card-content {
  flex: 1;
  min-width: 0;
}
.ni-card-title {
    font-size: 18px;
    font-weight: 400;
    color: var(--heading-color, #2c1f18);
    margin: 0 0 3px 0;
    line-height: 1.2;
}
.ni-card-desc {
    font-size: 14px;
    font-weight: 300;
    line-height: 21px;
    color: var(--ink3, #6b5645);
    margin: 0;
}
/* ── DESKTOP ── */
@media (min-width: 640px) {
  .ni-icon-wrap { width: 62px; height: 62px; }
  .ni-icon-wrap svg { width: 30px; height: 30px; }
}

@media (min-width: 1024px) {
  .ni-subtext-secondary { max-width: 560px; margin-bottom: 36px; }
  .ni-icon-wrap { width: 68px; height: 68px; }
  .ni-icon-wrap svg { width: 34px; height: 34px; }
}

@media all and (max-width:768px){
    .ni-list {
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .ni-heading{
        font-size:28px;
    }
}

@media (max-width: 639px) {
    .ni-section {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }
    h2.ni-heading.highlight{
        padding: 10px 0;
    }
    .ni-list{
        grid-template-columns: 1fr;
    }
    .ni-subtext,
    .ni-subtext-secondary{
        font-size:14px;
        line-height: normal;
    }
    .ni-card{
        padding:28px 13px;
        gap:12px;
    }
    .ni-icon-wrap { width: 50px; height: 50px; }
    .ni-icon-wrap svg { width: 24px; height: 24px; }
    .ni-card-title { font-size: 18px; }
}
</style>

<section class="ni-section">
  <div class="section">
    <div class="ni-header-wrap">
      {% if section.settings.eyebrow != blank %}
        <div class="ni-eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      <h2 class="ni-heading">{{ section.settings.heading }}</h2>
      <h2 class="ni-heading highlight">{{ section.settings.subheading }}</h2>


      {% if section.settings.subtext != blank %}
        <p class="ni-subtext">
          {{ section.settings.subtext }}
          {% if section.settings.subtext_link_label != blank and section.settings.subtext_link_url != blank %}
            <a href="{{ section.settings.subtext_link_url }}">{{ section.settings.subtext_link_label }}</a>
          {% endif %}
        </p>
      {% endif %}

      {% if section.settings.subtext_2 != blank %}
        <p class="ni-subtext-secondary">{{ section.settings.subtext_2 }}</p>
      {% endif %}
    </div>

    <div class="ni-list">
      {% for block in section.blocks %}
        <div class="ni-card" {{ block.shopify_attributes }}>
          <div class="ni-icon-wrap">
            <!-- Diamond SVG -->
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10.7218 21.4224L-1.57606e-05 10.7219L10.7218 5.6794e-05L21.4223 10.7219L10.7218 21.4224ZM10.7218 19.4865L19.4865 10.7219L10.7218 1.93594L1.95714 10.7219L10.7218 19.4865ZM10.7218 15.168L6.25437 10.7219L10.7218 6.25445L15.1892 10.7219L10.7218 15.168Z" fill="#B28A18"/>
            </svg>
          </div>
          <div class="ni-card-content">
            <h3 class="ni-card-title">{{ block.settings.title }}</h3>
            <p class="ni-card-desc">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "What Is Never In",
  "tag": "section",
  "class": "never-in-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "What Is Never In"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every benefit above is delivered"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Heading",
      "default": "Without these"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "First Paragraph",
      "default": "Compromise has never produced a formula that the Charaka Samhita would recognise."
    },
    {
      "type": "text",
      "id": "subtext_link_label",
      "label": "Highlighted Link Label",
      "default": "The standard is not negotiable."
    },
    {
      "type": "url",
      "id": "subtext_link_url",
      "label": "Highlighted Link URL"
    },
    {
      "type": "textarea",
      "id": "subtext_2",
      "label": "Second Paragraph",
      "default": "If we cannot name the farm, the harvest date, the distillation method, and the third-party purity certificate — the ingredient does not enter a PRANA formula."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop Top Padding",
      "min": 0, "max": 200, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop Bottom Padding",
      "min": 0, "max": 200, "step": 4, "unit": "px", "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile Top Padding",
      "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile Bottom Padding",
      "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Never In Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "No Synthetic Fragrance"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every scent in every PRANA formula derives from the botanical itself."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "What Is Never In",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "No Synthetic Fragrance",
            "description": "Every scent in every PRANA formula derives from the botanical itself."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "No Parabens, Sulphates",
            "description": "Preservation is botanical and small-batch — never compromise chemistry."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "No Mineral Oil, Silicones",
            "description": "The skin recognises sesame, jojoba and rose. It does not recognise petrochemicals."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "No Animal Testing",
            "description": "Cruelty-free, vegan, Leaping Bunny certified — and a brand built by women."
          }
        }
      ]
    }
  ]
}
{% endschema %}
