{{ 'prana-mask-pdp.css' | asset_url | stylesheet_tag }}
<div class="prana-mask-pdp pm-pdp-reviews">
<section class="pm-sec" id="prana-pdp-reviews" aria-labelledby="rev-h-{{ section.id }}">
  <div class="pm-wrap">
    <h2 id="rev-h-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <p class="pm-intro">Every review comes from a confirmed order and appears as the customer wrote it.</p>
    
    <div id="looxReviews-{{ section.id }}">{% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% endif %}{% endfor %}</div>
  </div>
</section>
</div>
{% schema %}
{
  "name": "PRANA PDP Reviews",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What verified customers say"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "PRANA PDP Reviews"
    }
  ]
}
{% endschema %}
