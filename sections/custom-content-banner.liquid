<section 
  class="experience-ayurveda-section experience-ayurveda-section-{{ section.id }}" 
>
  <div class="ayurveda-inner-container">
    <div class="ayurveda-content-wrapper">
      <div class="ayurveda-main-card">
        {% comment %} <svg class="ayurveda-star-icon" width="36" height="44" viewBox="0 0 36 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M13.8122 8.40681L15.0496 11.856C16.4262 15.6919 19.4423 18.6925 23.2782 20.0846L26.7274 21.322C27.0367 21.4302 27.0367 21.8788 26.7274 21.9871L23.2782 23.2244C19.4423 24.601 16.4417 27.6171 15.0496 31.453L13.8122 34.9022C13.704 35.2115 13.2554 35.2115 13.1472 34.9022L11.9098 31.453C10.5332 27.6171 7.51708 24.6165 3.6812 23.2244L0.232009 21.9871C-0.0773362 21.8788 -0.0773362 21.4302 0.232009 21.322L3.6812 20.0846C7.51708 18.708 10.5177 15.6919 11.9098 11.856L13.1472 8.40681C13.2554 8.09747 13.704 8.09747 13.8122 8.40681Z" fill="white"/>
          <path d="M29.3412 0.116004L29.9754 1.8638C30.6714 3.79721 32.2026 5.32846 34.1361 6.02449L35.8839 6.65865C36.0385 6.72052 36.0385 6.93706 35.8839 6.99893L34.1361 7.63308C32.2026 8.32911 30.6714 9.86036 29.9754 11.7938L29.3412 13.5416C29.2793 13.6962 29.0628 13.6962 29.0009 13.5416L28.3668 11.7938C27.6707 9.86036 26.1395 8.32911 24.2061 7.63308L22.4583 6.99893C22.3036 6.93706 22.3036 6.72052 22.4583 6.65865L24.2061 6.02449C26.1395 5.32846 27.6707 3.79721 28.3668 1.8638L29.0009 0.116004C29.0628 -0.0386681 29.2793 -0.0386681 29.3412 0.116004Z" fill="white"/>
          <path d="M29.3417 29.7664L29.9759 31.5142C30.6719 33.4476 32.2031 34.9789 34.1365 35.6749L35.8843 36.309C36.039 36.3709 36.039 36.5874 35.8843 36.6493L34.1365 37.2835C32.2031 37.9795 30.6719 39.5108 29.9759 41.4442L29.3417 43.192C29.2798 43.3466 29.0633 43.3466 29.0014 43.192L28.3673 41.4442C27.6712 39.5108 26.14 37.9795 24.2066 37.2835L22.4588 36.6493C22.3041 36.5874 22.3041 36.3709 22.4588 36.309L24.2066 35.6749C26.14 34.9789 27.6712 33.4476 28.3673 31.5142L29.0014 29.7664C29.0633 29.6117 29.2798 29.6117 29.3417 29.7664Z" fill="white"/>
        </svg> {% endcomment %}

        {% if section.settings.title != blank %}
          <h2 class="ayurveda-main-title">{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="ayurveda-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

      

        {% if section.settings.description2 != blank %}
          <div class="ayurveda-description ayurveda-description-secondary">
            {{ section.settings.description2 }}
          </div>
        {% endif %}
        
        {% if section.settings.button_text != blank or section.settings.button_text2 != blank %}
          <div class="ayurveda-button-group">
            {% if section.settings.button_text != blank %}
              <a href="{{ section.settings.button_link }}" class="ayurveda-btn ayurveda-btn-primary">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3.185 0.000976562V1.37988H10.827L0 12.051L1 13.0388L11.827 2.36792V9.8999H13.227V0L3.185 0.000976562Z" fill="black"/>
                  <path d="M0 12.051L10.827 1.37988H3.186V0H13.23V9.8999H11.83V2.36792L1.00299 13.0388L0 12.051Z" fill="#1B1716"/>
                </svg>
                {{ section.settings.button_text }}
              </a>
            {% endif %}
            {% if section.settings.button_text2 != blank %}
              <a href="{{ section.settings.button_link2 }}" class="ayurveda-btn ayurveda-btn-secondary">
                {{ section.settings.button_text2 }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <style>

    
    .ayurveda-features-heading {
      font-family: Josefin Sans;
      font-weight: 500;
      font-size: 21px;
      line-height: 30px;
      text-align: center;
      margin: 0 auto 16px;
      color: #fff;
    }

    .ayurveda-features-grid {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: 20px;
    }

    .ayurveda-feature-item {
      text-align: center;
      max-width: 166px;
    }

    .ayurveda-feature-icon {
      margin-inline: auto;
      width: 69px;
      height: 69px;
      object-fit: contain;
      margin-bottom: 13px;
    }

    .ayurveda-feature-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .ayurveda-feature-title {
      color: white;
      font-family: Canela Trial;
      font-weight: 500;
      font-size: 18px;
      line-height: 1;
      letter-spacing: -0.02rem;
      text-transform: capitalize;
      text-align: center;
    }

    .ayurveda-star-icon {
      margin: 0 auto;
    }
    .ayurveda-button-group {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin: 29px 0 0 0;
    }
    
    .experience-ayurveda-section-{{ section.id }} .ayurveda-inner-container {
      background: url({{ section.settings.desktop_bg | img_url: 'master' }});
      padding: 80px 42px;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      width: 100%;
      min-height: 700px;
      display: flex;
      align-items: center;
      {% if section.settings.desktop_content_align == 'start' %}
        justify-content: start;
      {% elsif section.settings.desktop_content_align == 'center' %}
        justify-content: center;
      {% else %}
        justify-content: end;
      {% endif %}
    }
    .ayurveda-content-wrapper {
      width: max-content;
      margin: 0;
      padding: 40px;
      display: flex;
      background: #d3b18a78;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-radius: 16px;
      border: 1px solid #ffffff5e;
    }
    .ayurveda-main-card {
      width: 100%;
      max-width: 580px;
    }
    .ayurveda-main-title {
      color: #fff;
      padding-bottom: 2px;
      font-weight: 500;
      font-size: 46px;
      line-height: normal;
      text-align: center;
      margin: 0 auto;
    }
    
    .ayurveda-main-title span {
      font-style: italic;
    }
    .ayurveda-description p {
      font-size: 21px;
      line-height: 27px;
      color: #fff;
      letter-spacing: 0;
      text-align: center;
    }
    .ayurveda-btn {
      text-decoration: none;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 200px;
      height: 50px;
      line-height: 1;
      letter-spacing: 0;
      font-size: 16px;
      text-transform: uppercase;
      color: #fff;
      background: var(--gold);
      text-align: center;
      gap: 7px;
      margin: 0;
      border-radius: 8px;
      transition:ease-in-out 0.5s;
    }
    a.ayurveda-btn.ayurveda-btn-secondary{
      background:#fff;
      color:var(--gold);
    }
    a.ayurveda-btn.ayurveda-btn-secondary:hover{
      background:var(--gold);
      color:#fff;
    }
    .ayurveda-btn svg path{
      fill:#fff;
    }
    .ayurveda-btn:hover{
      background:var(--heading-color);
      color:#ffff;
    }

    /* MOBILE BACKGROUND */
    @media (max-width: 768px) {
      .experience-ayurveda-section-{{ section.id }} .ayurveda-inner-container {
        background: url({{ section.settings.mobile_bg | img_url: 'master' }});
        min-height:500px;
        background-repeat: no-repeat !important;
        background-size: cover;
        background-position: center;
        padding: 0 16px;
        {% if section.settings.mobile_content_align == 'start' %}
          justify-content: start;
        {% elsif section.settings.mobile_content_align == 'center' %}
          justify-content: center;
        {% else %}
          justify-content: end;
        {% endif %}
      }
      
      .ayurveda-features-grid {
        flex-wrap: wrap;
        justify-content: center;
        padding-inline: 12px;
      }
      
      .ayurveda-features-heading {
        font-size: 18px;
        line-height: 20px;
      }
      
      .ayurveda-feature-icon {
        width: 53px;
        height: 53px;
        margin-bottom: 6px;
      }
      
      .ayurveda-feature-title {
        font-size: 15px;
      }
      
      .ayurveda-content-wrapper {
        padding: 0;
      }
      .ayurveda-main-card {
          width: 100%;
          padding: 20px 28px;
      }
      .ayurveda-main-title {
          font-size: 38px;
          padding-bottom: 3px;
          max-width: 500px;
          line-height: 50px;
      }
      .ayurveda-description p {
          font-size: 15px;
          line-height: 1.3;
          max-width: 400px;
          margin-inline: auto;
      }
      .ayurveda-button-group {
        margin: 24px auto 0;
        flex-wrap: wrap;
      }
      .ayurveda-btn {
        width: auto;
        height: auto;
        margin-top: 0;
        font-size: 12px;
        padding: 12px 17px;
        border-radius: 5px;
      }
      .ayurveda-btn svg{
        width: 11px;
        height: 11px;
      }
    }

    @media all and (max-width:575px){
      .ayurveda-content-wrapper {
          width: calc(100% - 0px);
          padding: 0;
      }
      .ayurveda-main-title {
          font-size: 28px;
          padding-bottom: 3px;
          max-width: 500px;
          line-height: normal;
      }
    }
  </style>
</section>

{% schema %}
{
  "name": "Experience Ayurveda",
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_align",
      "label": "Desktop Content Align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_content_align",
      "label": "Mobile Content Align",
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "End"
        }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "desktop_bg",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_bg",
      "label": "Mobile Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Experience Ayurveda with Prana Beauty"
    },
    {
      "type": "text",
      "id": "title_block",
      "label": "Block Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "richtext",
      "id": "description2",
      "label": "Description 2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text2",
      "label": "Button 2 Text",
      "default": "Take the Skin Quiz"
    },
    {
      "type": "url",
      "id": "button_link2",
      "label": "Button 2 Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title",
          "default": "AI-Powered Precision"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Experience Ayurveda",
      "category": "Custom"
    }
  ]
}
{% endschema %}