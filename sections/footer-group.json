    "faq_pg_sec_DEwKXJ": {
      "type": "faq-pg-sec",
      "blocks": {
        "faq_nNMLJG": {
          "type": "faq",
          "settings": {
            "question": "What are natural skincare products?",
            "answer": "<p>Natural skincare products use plant, mineral, and botanical ingredients, not synthetic fillers. At PRANA, they are 100% botanical and anhydrous. They are also free from parabens and silicones, so every drop provides active skincare.</p>"
          }
        },
        "faq_Y4zVeT": {
          "type": "faq",
          "settings": {
            "question": " What are vegan skincare products?",
            "answer": "<p>Vegan skincare products have no animal ingredients, like beeswax, honey, or lanolin. They are also never tested on animals. All PRANA vegan skincare products are 100% plant-based, cruelty-free, and made with clean formulas.</p>"
          }
        },
        "faq_w6pktE": {
          "type": "faq",
          "settings": {
            "question": "Are natural and vegan skincare products the same thing?",
            "answer": "<p>No. Natural skincare products can contain beeswax or honey, so they aren't vegan. Vegan skincare can be synthetic, which means it isn't always natural. The best vegan skincare products are both natural and vegan, like PRANA.</p>"
          }
        },
        "faq_QHtabc": {
          "type": "faq",
          "settings": {
            "question": "What are ayurvedic skin care products?",
            "answer": "<p>Ayurvedic skin care products come from 5,000 years of Ayurveda. They use herb-infused oils, like sesame, to deliver actives such as saffron and triphala deep into the skin. This approach supports balance, not just surface results.</p>"
          }
        },
        "faq_M96LG8": {
          "type": "faq",
          "settings": {
            "question": "What are ayurvedic beauty products used for?",
            "answer": "<p>Ayurvedic beauty products enhance radiance, even skin tone, and soothe sensitivity. Ingredients like saffron brighten, turmeric clarifies, and bakuchiol firms. Use them in daily morning and evening routines, as well as weekly rituals.</p>"
          }
        },
        "faq_meBUTm": {
          "type": "faq",
          "settings": {
            "question": "How does ayurvedic skincare work?",
            "answer": "<p>Ayurvedic skincare balances Vata, Pitta, and Kapha energies instead of just hiding symptoms. It uses warm, oil-based rituals to deeply deliver botanical actives. With regular use, it restores glow and resilience.</p>"
          }
        },
        "faq_6gE397": {
          "type": "faq",
          "settings": {
            "question": "What should I look for in the best ayurvedic skincare brands in the USA?",
            "answer": "<p>Seek classical formulations and traceable sources, such as Kashmiri saffron. Look for anhydrous, oil-based ayurvedic skincare that is 100% vegan and cruelty-free. Also, ensure full ingredient transparency. The top ayurvedic skincare brands in the USA meet all five criteria.</p>"
          }
        }
      },
