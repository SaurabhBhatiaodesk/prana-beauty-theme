<section class="prana-about-section">
  <div class="section">
    <div class="prana-about-wrapper">

      <div class="prana-about-content">

        {% if section.settings.subheading != blank %}
          <div class="inner-header">
            <p class="prana-subheading">
              {{ section.settings.subheading }}
            </p>
            <div class="fv-cap-line"></div>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="prana-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="prana-description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <div class="prana-features">
          {% for block in section.blocks %}
            <div class="prana-feature-item" {{ block.shopify_attributes }}>
              {{ block.settings.title }}
            </div>
          {% endfor %}
        </div>

      </div>

      <div class="prana-about-video">

        {% if section.settings.video != blank %}

        {{
          section.settings.video
          | video_tag:
            autoplay: section.settings.autoplay,
            loop: section.settings.loop_video,
            muted: section.settings.muted,
            controls: section.settings.show_controls,
            playsinline: true,
            image_size: 'master',
            class: 'prana-video'
        }}

      {% elsif section.settings.video_url != blank %}

          <div class="video-wrapper">

            {% if section.settings.video_url.type == 'youtube' %}

              <iframe
                src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&rel=0&playsinline=1"
                title="Video"
                frameborder="0"
                allow="autoplay; encrypted-media"
                allowfullscreen>
              </iframe>

            {% elsif section.settings.video_url.type == 'vimeo' %}

              <iframe
                src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&title=0&byline=0&portrait=0"
                title="Video"
                frameborder="0"
                allow="autoplay; fullscreen"
                allowfullscreen>
              </iframe>

            {% endif %}

          </div>

        {% endif %}

        {% if section.settings.video_poster != blank %}
          <div class="custom-video-poster">
            {{
              section.settings.video_poster
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                class: 'poster-image'
            }}
          </div>
        {% endif %}

      </div>

    </div>
  </div>
</section>

<style>
.prana-about-section{
  background:radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
  padding:60px 0;
}

.prana-about-content .inner-header{
  font-family:var(--U);
  font-size:14px;
  color:var(--ink3);
  display:flex;
  align-items:center;
  gap:16px;
}
.prana-about-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: stretch;
}

.prana-heading{
  margin:18px 0 10px 0;
  font-size:38px;
  line-height:1.1;
  color:var(--heading-color);
  font-weight:400;
  max-width:500px;
}

.prana-description{
  font-size:17px;
  line-height:normal;
  color:var(--ink3);
}

.prana-description p{
  margin-bottom:10px;
}

.prana-features{
  margin-top:30px;
  display:grid;
  grid-template-columns:repeat(2,1fr);
  border-radius:12px;
  overflow:hidden;
  border:1px solid var(--gold);
}

.prana-feature-item{
  padding:22px 15px;
  text-align:center;
  background:#E3C39F;
  font-size:20px;
  color:var(--ink3);
}

.prana-feature-item:nth-child(1),
.prana-feature-item:nth-child(2){
  border-bottom:1px solid var(--gold);
}

.prana-feature-item:nth-child(odd){
  border-right:1px solid var(--gold);
}
.prana-about-video {
    width: 100%;
    position: relative;
    height: 100%;
}
.prana-video,
.video-wrapper iframe,
.video-wrapper video{
  width:100%;
  display:block;
  border-radius:18px;
  overflow:hidden;
  height: 100%;
}

.prana-video{
  width:100%;
  height:100%;
  object-fit:cover;
}

.video-wrapper{
  border-radius:18px;
  overflow:hidden;
}

.video-wrapper iframe{
  width:100%;
  aspect-ratio:9/16;
  border:0;
}

.custom-video-poster{
  display:none;
}

.prana-about-video video{
  border-radius:18px;
  overflow:hidden;
}

@media all and (max-width:768px){
  .prana-about-wrapper{
    gap:40px;
    grid-template-columns: 1fr;
  }
}

@media screen and (max-width: 749px){

  .prana-about-section{
    padding:40px 0;
  }
  .prana-features{
    margin-top:20px;
    border-radius:8px;
  }
  .prana-about-wrapper{
    grid-template-columns:1fr;
    gap:30px;
  }
  .prana-description {
    font-size: 15px;
    line-height: 19px;
  }
  .prana-heading{
    font-size:28px;
    margin:10px 0 4px 0;
  }
  .prana-about-video video {
    border-radius: 12px;
    aspect-ratio: 16 / 9;
    height: 210px;
  }
  .prana-about-video{
    height: 210px;
  }
  .prana-feature-item {
      font-size: 15px;
      padding: 16px 10px;
  }
}
</style>

{% schema %}
{
  "name": "PRANA About",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "PRANA Beauty"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Ayurveda Meets Modern Science"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video Poster Image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Upload Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External Video URL",
      "accept": [
        "youtube",
        "vimeo"
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Muted",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show Controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop Video",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA About",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Woman-founded"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "AI-Powered"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Ayurvedic Roots"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Clean Beauty Certified"
          }
        }
      ]
    }
  ]
}
{% endschema %}