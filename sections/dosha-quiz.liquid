      products: ['rose-jasmine-cleanser', 'rose-water-mist', 'turmeric-sandalwood-mask', 'bakuchiol-night-serum']
    },
    kapha: {
      name: 'Kapha', sub: 'Earth & Water · The energy of structure',
      heroClass: 'rh-kapha', modal: 'kaphaModal-' + SID,
      essence: 'Built for the long game — Kapha skin ages slowly and beautifully when it\'s given clarity and movement.',
      insight: 'Your skin is <em>Kapha-dominant</em> — thick, stable, and slow to age. The challenge is circulation: congestion, enlarged pores, and dullness. Your ritual is built around deep cleansing, clay, and brightening botanicals.',
      products: ['rose-jasmine-cleanser', 'turmeric-sandalwood-mask', 'saffron-glow-serum', 'rose-water-mist']
    },
    'dual-vata-pitta': {
      name: 'Vata–Pitta', sub: 'Air, Space & Fire · The creative flame',
      heroClass: 'rh-vata', modal: 'vataModal-' + SID,
      essence: 'The artist\'s constitution — quick, radiant, reactive. Your skin is full of life and full of opinions.',
      insight: 'Your skin is <em>Vata–Pitta dual dominant</em> — combining Vata\'s delicacy with Pitta\'s reactivity. Your ritual bridges both: soothing the fire while feeding the air.',
      products: ['rose-jasmine-cleanser', 'rose-water-mist', 'bakuchiol-night-serum', 'saffron-glow-serum']
    },
    'dual-vata-kapha': {
      name: 'Vata–Kapha', sub: 'Air, Space & Earth · Grounded movement',
      heroClass: 'rh-vata', modal: 'vataModal-' + SID,
      essence: 'The nurturer\'s constitution — resilient and sensitive. Your skin alternates between thirst and congestion.',
      insight: 'Your skin is <em>Vata–Kapha dual dominant</em> — sometimes dry and delicate, sometimes congested and dull. Your products need to do both without compromising either.',
      products: ['rose-jasmine-cleanser', 'turmeric-sandalwood-mask', 'saffron-radiance-moisturizer', 'saffron-glow-serum']
    },
    'dual-kapha-pitta': {
      name: 'Kapha–Pitta', sub: 'Earth, Water & Fire · Powerful radiance',
      heroClass: 'rh-pitta', modal: 'pittaModal-' + SID,
      essence: 'Resilient and radiant — your skin has extraordinary capacity when it\'s working in harmony.',
      insight: 'Your skin is <em>Kapha–Pitta dual dominant</em> — combining Kapha\'s structure with Pitta\'s intensity. Your ritual focuses on purifying clarity and cooling.',
      products: ['rose-jasmine-cleanser', 'turmeric-sandalwood-mask', 'rose-water-mist', 'saffron-glow-serum']
    },
    balanced: {
      name: 'Tridoshic', sub: 'Vata · Pitta · Kapha · In balance',
      heroClass: 'rh-pitta', modal: 'tridoshicModal-' + SID,
      essence: 'The rarest constitution — all three energies in relative harmony. Your ritual is about maintenance, not correction.',
      insight: 'Your skin reads as <em>Tridoshic</em> — all three doshas in relative balance. This is the rarest and most resilient skin constitution. Your ritual focus is seasonal maintenance.',
      products: ['rose-jasmine-cleanser', 'rose-water-mist', 'saffron-glow-serum', 'bakuchiol-night-serum']
    }
  };

  // ─── STATE ───
  var currentDosha = 'vata';
  var resultSource = 'Quick Quiz';
  var scanMarkers = null;
  var cameraStream = null;
  var capturedImageBase64 = null;
  var scanMode = 'camera';
  var quickAnswers = {};
  var deepAnswers = {};
  var deepCurrent = 0;
  var deepScores = { V: 0, P: 0, K: 0, Vv: 0, Pv: 0, Kv: 0 };
  var shopifyProducts = [];
  var isProductsLoaded = false;

  // ─── DOM HELPERS ───
  function $(id) { return document.getElementById(id + '-' + SID); }
  function $s(id) { return document.getElementById(id); }

  // ─── NAVIGATION ───
  window.goToScreen = function(id) {
    document.querySelectorAll('#prana-quiz-' + SID + ' .screen').forEach(function(s) {
      s.classList.remove('active');
    });
    var target = document.getElementById(id);
    if (target) target.classList.add('active');
    window.scrollTo(0, 0);
  };

  // ─── FETCH SHOPIFY PRODUCTS ───
  function fetchShopifyProducts() {
    return fetch('/products.json?limit=250')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        shopifyProducts = data.products || [];
        isProductsLoaded = true;
        return shopifyProducts;
      })
      .catch(function(err) {
        console.log('Shopify products fetch failed:', err);
        shopifyProducts = [];
        isProductsLoaded = true;
        return shopifyProducts;
      });
  }

  // ─── GET PRODUCT IMAGE (FIXED) ───
  function getProductImage(product) {
    if (!product) return '';
    if (product.featured_image && product.featured_image.src) {
      return product.featured_image.src;
    }
    if (product.images && product.images.length > 0 && product.images[0].src) {
      return product.images[0].src;
    }
    return '';
  }

  // ─── MATCH PRODUCTS TO DOSHA (DYNAMIC AI) ───
  function matchProducts(dosha, products) {
    if (!products || products.length === 0) return [];

    var doshaKeywords = {
      vata: ['hydrating', 'nourishing', 'gentle', 'dry', 'sensitive', 'moisturizer', 'serum', 'oil', 'cream', 'rich', 'soothing', 'calming'],
      pitta: ['cooling', 'calming', 'sensitive', 'reactive', 'mist', 'soothing', 'mask', 'anti-inflammatory', 'aloe', 'rose', 'gentle'],
      kapha: ['clarifying', 'purifying', 'exfoliating', 'oily', 'mask', 'clay', 'clean', 'detox', 'brightening', 'light', 'awakening'],
      'dual-vata-pitta': ['balanced', 'gentle', 'calming', 'nourishing', 'serum', 'mist', 'adaptogenic', 'soothing'],
      'dual-vata-kapha': ['nourishing', 'cleansing', 'mask', 'moisturizer', 'gentle', 'rich'],
      'dual-kapha-pitta': ['purifying', 'cooling', 'mask', 'mist', 'clarifying', 'balancing'],
      balanced: ['gentle', 'balanced', 'all', 'basic', 'universal', 'everyday']
    };

    var keywords = doshaKeywords[dosha] || doshaKeywords.balanced;
    var matched = [];

    for (var i = 0; i < products.length; i++) {
      var p = products[i];
      var score = 0;
      var matchedKeywords = [];

      var content = (p.title || '').toLowerCase() + ' ' + 
                    ((p.tags || []).join(' ')).toLowerCase() + ' ' +
                    (p.product_type || '').toLowerCase() + ' ' +
                    (p.vendor || '').toLowerCase();

      for (var j = 0; j < keywords.length; j++) {
        var kw = keywords[j];
        if (content.indexOf(kw) > -1) {
          var weight = 10;
          if ((p.title || '').toLowerCase().indexOf(kw) > -1) {
            weight = 20;
          }
          var count = (content.match(new RegExp(kw, 'g')) || []).length;
          score += weight * (1 + (count * 0.2));
          if (matchedKeywords.indexOf(kw) === -1) matchedKeywords.push(kw);
        }
      }

      if (p.tags) {
        for (var k = 0; k < p.tags.length; k++) {
          var tag = p.tags[k].toLowerCase();
          if (tag.indexOf(dosha) > -1) score += 25;
          if (tag.indexOf('all') > -1) score += 15;
          var affinityMatch = tag.match(/dosha:(\w+):(\d+)/);
          if (affinityMatch && affinityMatch[1] === dosha) {
            score += parseInt(affinityMatch[2]) / 3;
          }
        }
      }

      // Normalize score (0-100)
      score = Math.min(Math.round(score), 100);

      var image = getProductImage(p);

      if (score > 0) {
        matched.push({
          title: p.title || 'Product',
          price: p.variants && p.variants[0] ? '$' + parseFloat(p.variants[0].price).toFixed(2) : '$0',
          image: image,
          handle: p.handle || '',
          score: score,
          tags: p.tags || [],
          matchedKeywords: matchedKeywords.slice(0, 3)
        });
      }
    }

    matched.sort(function(a, b) { return b.score - a.score; });

    if (matched.length < 2) {
      return matched;
    }
    return matched.slice(0, 4);
  }

  // ─── SHOW RESULT (FIXED WITH IMAGES) ───
  function showResult(dosha, customInsight, fromScan, S) {
    var d = DOSHA_DATA[dosha] || DOSHA_DATA.balanced;

    var hero = $s('result-hero-' + S);
    if (hero) hero.className = 'result-hero ' + d.heroClass;

    var doshaName = $s('rh-dosha-' + S);
    if (doshaName) doshaName.textContent = d.name;

    var sub = $s('rh-sub-' + S);
    if (sub) sub.textContent = d.sub;

    var essence = $s('rh-essence-' + S);
    if (essence) essence.textContent = d.essence;

    var source = $s('rh-source-' + S);
    if (source) source.textContent = 'via ' + resultSource;

    var insight = $s('result-insight-' + S);
    if (insight) insight.innerHTML = customInsight || d.insight;

    var learnBtn = $s('learn-dosha-btn-' + S);
    if (learnBtn) learnBtn.textContent = 'Explore your full ' + d.name + ' guide →';

    // ─── SKIN MARKERS ───
    var markerSection = $s('section-markers-' + S);
    if (fromScan && scanMarkers) {
      if (markerSection) markerSection.style.display = 'block';
      var grid = $s('skin-markers-grid-' + S);
      if (grid) {
        grid.innerHTML = '';
        for (var key in scanMarkers) {
          if (scanMarkers.hasOwnProperty(key)) {
            var m = scanMarkers[key];
            var level = m.score > 70 ? 'high' : m.score > 40 ? 'mid' : 'low';
            var label = key.charAt(0).toUpperCase() + key.slice(1);
            grid.innerHTML += '<div class="marker-item">' +
              '<div class="marker-bar"><div class="marker-fill ' + level + '" style="width:' + m.score + '%"></div></div>' +
              '<div class="marker-val">' + m.label + '</div>' +
              '<div class="marker-name">' + label + '</div>' +
              '</div>';
          }
        }
      }
    } else if (markerSection) {
      markerSection.style.display = 'none';
    }

    // ─── UPGRADE NUDGE ───
    var nudge = $s('upgrade-nudge-' + S);
    if (nudge) nudge.style.display = resultSource !== 'Deep Dosha' ? 'block' : 'none';

    // ─── PRODUCTS (FIXED IMAGES) ───
    var productContainer = $s('product-cards-' + S);
    if (productContainer) {
      var matchedProducts = matchProducts(dosha, shopifyProducts);

      // Fallback if no products matched
      if (matchedProducts.length === 0) {
        var fallbackProducts = [];
        var productNames = {
          'saffron-glow-serum': { title: 'Saffron Glow Serum', price: '$89', handle: 'saffron-glow-serum' },
          'saffron-radiance-moisturizer': { title: 'Saffron Radiance Moisturizer', price: '$72', handle: 'saffron-radiance-moisturizer' },
          'bakuchiol-night-serum': { title: 'Bakuchiol Night Serum', price: '$79', handle: 'bakuchiol-night-serum' },
          'turmeric-sandalwood-mask': { title: 'Turmeric & Sandalwood Mask', price: '$52', handle: 'turmeric-sandalwood-mask' },
          'rose-water-mist': { title: 'Pure Rose Water Mist', price: '$35', handle: 'rose-water-mist' },
          'rose-jasmine-cleanser': { title: 'Rose Jasmine Milk Cleanser', price: '$32', handle: 'rose-jasmine-cleanser' }
        };

        for (var i = 0; i < d.products.length; i++) {
          var handle = d.products[i];
          var found = null;
          for (var j = 0; j < shopifyProducts.length; j++) {
            if (shopifyProducts[j].handle === handle) {
              found = shopifyProducts[j];
              break;
            }
          }

          if (found) {
            var imgSrc = getProductImage(found);
            fallbackProducts.push({
              title: found.title,
              price: found.variants && found.variants[0] ? '$' + parseFloat(found.variants[0].price).toFixed(2) : '$0',
              image: imgSrc,
              handle: found.handle,
              score: 70 - (i * 5),
              tags: found.tags || []
            });
          } else {
            var fb = productNames[handle];
            if (fb) {
              fallbackProducts.push({
                title: fb.title,
                price: fb.price,
                image: '',
                handle: fb.handle,
                score: 70 - (i * 5),
                tags: []
              });
            }
          }
        }
        matchedProducts = fallbackProducts.slice(0, 4);
      }

      // ─── RENDER PRODUCT CARDS ───
      productContainer.innerHTML = '';
      for (var k = 0; k < matchedProducts.length; k++) {
        var p = matchedProducts[k];

        // Get image properly
        var imgSrc = p.image || '';
        if (!imgSrc && p.handle) {
          for (var m = 0; m < shopifyProducts.length; m++) {
            if (shopifyProducts[m].handle === p.handle) {
              imgSrc = getProductImage(shopifyProducts[m]);
              break;
            }
          }
        }

        var imgHtml = '';
        if (imgSrc) {
          imgHtml = '<img src="' + imgSrc + '" alt="' + p.title + '" loading="lazy" onerror="this.parentElement.innerHTML=\'<span class=\\"no-img\\">✦</span>\'">';
        } else {
          imgHtml = '<span class="no-img">✦</span>';
        }

        var scoreHtml = p.score ? '<div class="pc-why">Match: ' + p.score + '%</div>' : '';

        productContainer.innerHTML +=
          '<div class="product-card">' +
            '<div class="pc-img">' + imgHtml + '</div>' +
            '<div class="pc-body">' +
              '<div class="pc-name">' + p.title + '</div>' +
              scoreHtml +
              '<div class="pc-bottom">' +
                '<span class="pc-price">' + p.price + '</span>' +
                '<a class="btn-shop" href="/products/' + (p.handle || '') + '" target="_blank">Shop Now →</a>' +
              '</div>' +
            '</div>' +
          '</div>';
      }
    }

    goToScreen('screen-result-' + S);
  }

  // ─── SCANNER LOGIC ───
  window.selectMode = function(mode, S) {
    scanMode = mode;
    var btnCamera = $s('btnCamera-' + S);
    var btnUpload = $s('btnUpload-' + S);
    if (btnCamera) btnCamera.classList.toggle('active', mode === 'camera');
    if (btnUpload) btnUpload.classList.toggle('active', mode === 'upload');

    var cameraZone = $s('cameraZone-' + S);
    var uploadZone = $s('uploadZone-' + S);
    if (cameraZone) cameraZone.classList.toggle('active', mode === 'camera');
    if (uploadZone) uploadZone.classList.toggle('hidden', mode !== 'upload');

    var preview = $s('uploadPreview-' + S);
    if (preview) preview.style.display = 'none';

    var status = $s('scanStatus-' + S);
    if (status) {
      status.textContent = mode === 'camera'
        ? 'Position your face in the frame and hold still'
        : 'Upload a clear selfie in good lighting';
    }

    if (mode === 'camera') {
      startCamera(S);
    } else {
      stopCamera(S);
    }
  };

  function startCamera(S) {
    try {
      navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false })
        .then(function(stream) {
          cameraStream = stream;
          var feed = $s('cameraFeed-' + S);
          if (feed) feed.srcObject = stream;
          animateChips(S);
        })
        .catch(function(e) {
          var status = $s('scanStatus-' + S);
          if (status) status.textContent = 'Camera access denied — please use Upload instead';
          selectMode('upload', S);
        });
    } catch(e) {
      selectMode('upload', S);
    }
  }

  function stopCamera(S) {
    if (cameraStream) {
      cameraStream.getTracks().forEach(function(t) { t.stop(); });
      cameraStream = null;
    }
    clearInterval(window['chipInterval_' + S]);
  }

  function animateChips(S) {
    clearInterval(window['chipInterval_' + S]);
    var i = 1;
    window['chipInterval_' + S] = setInterval(function() {
      for (var c = 1; c <= 6; c++) {
        var chip = $s('chip' + c + '-' + S);
        if (chip) chip.classList.remove('lit');
      }
      var active = $s('chip' + ((i % 6) + 1) + '-' + S);
      if (active) active.classList.add('lit');
      i++;
    }, 800);
  }

  window.handleUpload = function(event, S) {
    var file = event.target.files[0];
    if (!file) return;
    var reader = new FileReader();
    reader.onload = function(ev) {
      capturedImageBase64 = ev.target.result.split(',')[1];
      var preview = $s('uploadPreview-' + S);
      if (preview) {
        preview.src = ev.target.result;
        preview.style.display = 'block';
      }
      var zone = $s('uploadZone-' + S);
      if (zone) zone.classList.add('hidden');
      var status = $s('scanStatus-' + S);
      if (status) status.textContent = 'Photo ready — tap Analyse My Skin';
      var btn = $s('btnScan-' + S);
      if (btn) btn.disabled = false;
    };
    reader.readAsDataURL(file);
  };

  // ─── AI ANALYSIS ───
  function analyzeLocally(imageBase64) {
    return {
      dosha: 'balanced',
      markers: {
        hydration: { score: 65, label: 'Good' },
        texture: { score: 60, label: 'Moderate' },
        pigmentation: { score: 70, label: 'Mostly Even' },
        radiance: { score: 55, label: 'Moderate' },
        elasticity: { score: 60, label: 'Good' },
        barrier: { score: 65, label: 'Good' }
      },
      insight: 'Your skin shows balanced characteristics with good resilience and moderate radiance. A nourishing Ayurvedic ritual will support your natural glow.'
    };
  }

  window.runScan = function(S) {
    var biometric = $s('consentBiometric-' + S);
    var age = $s('consentAge-' + S);
    var errEl = $s('consentError-' + S);

    if (!biometric || !biometric.checked || !age || !age.checked) {
      if (errEl) {
        errEl.classList.add('show');
        errEl.textContent = !biometric.checked && !age.checked
          ? 'Please accept the biometric processing consent and confirm your age before scanning.'
          : !biometric.checked
            ? 'Please accept the biometric processing consent to continue.'
            : 'Please confirm you are 18 or older to continue.';
        errEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return;
    }
    if (errEl) errEl.classList.remove('show');

    stopCamera(S);
    clearInterval(window['chipInterval_' + S]);

    if (scanMode === 'camera') {
      var video = $s('cameraFeed-' + S);
      if (video) {
        var canvas = document.createElement('canvas');
        canvas.width = video.videoWidth || 640;
        canvas.height = video.videoHeight || 480;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0);
        capturedImageBase64 = canvas.toDataURL('image/jpeg', 0.85).split(',')[1];
      }
    }

    if (!capturedImageBase64) {
      var status = $s('scanStatus-' + S);
      if (status) status.textContent = 'Please enable camera or upload a photo first';
      return;
    }

    showAnalyzing(S);

    // Use local analysis (fast, no API key needed)
    setTimeout(function() {
      var result = analyzeLocally(capturedImageBase64);
      var overlay = $s('analyzingOverlay-' + S);
      if (overlay) overlay.classList.remove('active');

      resultSource = 'AI Skin Scan';
      scanMarkers = result.markers;
      currentDosha = result.dosha || 'balanced';

      var insight = result.insight || DOSHA_DATA[currentDosha].insight;

      if (!isProductsLoaded) {
        fetchShopifyProducts().then(function() {
          showResult(currentDosha, insight, true, S);
        });
      } else {
        showResult(currentDosha, insight, true, S);
      }
    }, 3000);
  };

  // ─── ANALYZING OVERLAY ───
  function showAnalyzing(S) {
    var overlay = $s('analyzingOverlay-' + S);
    if (overlay) overlay.classList.add('active');

    var markers = ['am1', 'am2', 'am3', 'am4', 'am5', 'am6'];
    var texts = ['Reading hydration levels…', 'Analysing texture…', 'Mapping pigmentation…', 'Measuring radiance…', 'Checking elasticity…', 'Assessing barrier health…'];
    var i = 0;
    var textEl = $s('analyzingText-' + S);

    clearInterval(window['analyzeInterval_' + S]);
    window['analyzeInterval_' + S] = setInterval(function() {
      if (i < markers.length) {
        var el = $s(markers[i] + '-' + S);
        if (el) el.classList.add('done');
        if (textEl) textEl.textContent = texts[i];
        i++;
      } else {
        clearInterval(window['analyzeInterval_' + S]);
      }
    }, 700);
  }

  // ─── QUICK QUIZ ───
  var quickCurrent = 1;

  window.quickAnswer = function(step, val, el, S) {
    var container = el.closest('.q-options');
    if (container) {
      var opts = container.querySelectorAll('.q-opt');
      for (var i = 0; i < opts.length; i++) opts[i].classList.remove('selected');
    }
    el.classList.add('selected');
    quickAnswers['q' + step] = val;

    var nextBtn = $s('quick-next-' + S);
    if (nextBtn) nextBtn.classList.add('ready');
  };

  window.quickBack = function(S) {
    if (quickCurrent <= 1) return;
    var currentStep = $s('qq-' + quickCurrent + '-' + S);
    if (currentStep) currentStep.classList.remove('active');
    quickCurrent--;
    var prevStep = $s('qq-' + quickCurrent + '-' + S);
    if (prevStep) prevStep.classList.add('active');
    updateQuickProgress(S);
    var nextBtn = $s('quick-next-' + S);
    if (nextBtn) nextBtn.classList.toggle('ready', !!quickAnswers['q' + quickCurrent]);
    var backBtn = $s('quick-back-' + S);
    if (backBtn) backBtn.style.visibility = quickCurrent <= 1 ? 'hidden' : 'visible';
  };

  function updateQuickProgress(S) {
    var pct = Math.round((quickCurrent / 3) * 100);
    var fill = $s('qp-quick-' + S);
    if (fill) fill.style.width = pct + '%';

    var count = $s('quick-count-' + S);
    if (count) count.textContent = quickCurrent + ' of 3';

    var phases = ['Skin type', 'Primary concern', 'Ritual moment'];
    var phase = $s('quick-phase-' + S);
    if (phase) phase.textContent = phases[quickCurrent - 1];
  }

  document.addEventListener('click', function(e) {
    var target = e.target.closest ? e.target.closest('#quick-next-' + SID) : null;
    if (target) {
      var S = SID;
      if (!target.classList.contains('ready')) return;
      if (quickCurrent < 3) {
        var currentStep = $s('qq-' + quickCurrent + '-' + S);
        if (currentStep) currentStep.classList.remove('active');
        quickCurrent++;
        var nextStep = $s('qq-' + quickCurrent + '-' + S);
        if (nextStep) nextStep.classList.add('active');
        updateQuickProgress(S);
        target.classList.toggle('ready', !!quickAnswers['q' + quickCurrent]);
        var backBtn = $s('quick-back-' + S);
        if (backBtn) backBtn.style.visibility = 'visible';
      } else {
        computeQuickResult(S);
      }
    }
  });

  function computeQuickResult(S) {
    var type = quickAnswers.q1;
    var concern = quickAnswers.q2;
    var dosha = 'balanced';

    if (type === 'vata' || concern === 'aging') dosha = 'vata';
    else if (type === 'pitta' || concern === 'pigmentation') dosha = 'pitta';
    else if (type === 'kapha' || concern === 'texture') dosha = 'kapha';
    else if (type === 'vata' && concern === 'pigmentation') dosha = 'dual-vata-pitta';
    else if (type === 'balanced') dosha = 'balanced';

    resultSource = 'Quick Quiz';
    scanMarkers = null;
    currentDosha = dosha;

    if (!isProductsLoaded) {
      fetchShopifyProducts().then(function() {
        showResult(dosha, null, false, S);
      });
    } else {
      showResult(dosha, null, false, S);
    }
  }

  // ─── DEEP DOSHA ───
  var DEEP_QUESTIONS = [
    {layer:1,phase:'Prakriti · Your baseline nature',text:'Your body\'s natural relationship with temperature?',sub:'Your default state — not how you feel today.',opts:[{t:'I run cold — always reaching for warmth',h:'Hands and feet often cold',v:{V:3}},{t:'I run warm — often the hottest in the room',h:'Intense body heat, flushes easily',v:{P:3}},{t:'Comfortable in most temperatures',h:'Rarely extreme cold or heat',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'Your skin without any products — describe it.',sub:'Baseline skin, not during a breakout.',opts:[{t:'Thin, dry, dehydrated — tight without moisture',h:'Delicate texture, veins slightly visible',v:{V:3}},{t:'Combination or oily with redness or sensitivity',h:'Pores visible in T-zone, occasional flushing',v:{P:3}},{t:'Thick, smooth, naturally hydrated',h:'Porcelain quality, holds moisture well',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'How does stress show up in your body first?',sub:'Your primary stress response.',opts:[{t:'Anxiety, racing thoughts, insomnia',h:'Mind goes faster than the body',v:{V:3}},{t:'Irritability, inflammation, anger',h:'Body temperature rises with stress',v:{P:3}},{t:'Withdrawal, heaviness, oversleeping',h:'Body slows down and holds on',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'Your natural appetite and digestion?',sub:'When life is balanced — not when stressed.',opts:[{t:'Variable — sometimes hungry, sometimes not',h:'Irregular, easily disrupted',v:{V:3}},{t:'Strong, regular, irritable when delayed',h:'Sharp hunger on a schedule',v:{P:3}},{t:'Steady but slow — could skip meals easily',h:'Comfortable going long without eating',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'Your body\'s natural weight tendency?',sub:'Without intervention — your set point.',opts:[{t:'Lean, hard to gain weight',h:'Slight build, lighter bones',v:{V:3}},{t:'Medium build, gains and loses relatively easily',h:'Athletic or medium frame',v:{P:3}},{t:'Heavier build, gains weight easily',h:'Rounder, solid frame',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'How do you process information and make decisions?',sub:'Your natural cognitive style.',opts:[{t:'Quick to learn, quick to forget — scattered',h:'Ideas arrive fast, retention is harder',v:{V:3}},{t:'Sharp, analytical, decisive',h:'Cuts through complexity quickly',v:{P:3}},{t:'Slow and steady — strong long-term memory',h:'Takes time to process, remembers everything',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'Your hair at its natural baseline?',sub:'Without products — its default texture.',opts:[{t:'Dry, fine, frizzy or wavy',h:'Prone to breakage, flies away',v:{V:3}},{t:'Medium, oily at roots, or prematurely greying',h:'Heat-sensitive, fine-to-medium',v:{P:3}},{t:'Thick, lustrous, slow to grey',h:'Dense, holds moisture naturally',v:{K:3}}]},
    {layer:1,phase:'Prakriti · Your baseline nature',text:'Your energy across the day?',sub:'Without caffeine or external stimulants.',opts:[{t:'Burst and crash — high energy then sudden fatigue',h:'Variable, hard to sustain',v:{V:3}},{t:'Moderate, purposeful — burns out when pushed too hard',h:'Efficient but finite',v:{P:3}},{t:'Slow to start, strong endurance once moving',h:'Steady long-burn energy',v:{K:3}}]},
    {layer:2,phase:'Vikriti · Your current state',text:'How does your skin feel right now today?',sub:'This week — what you\'re actually experiencing.',opts:[{t:'Dry, tight, flaky, or dehydrated',h:'Needs moisture urgently',v:{Vv:3}},{t:'Reactive, red, sensitised, or breaking out',h:'Inflamed or irritated',v:{Pv:3}},{t:'Congested, dull, or heavier than usual',h:'Feeling sluggish and clogged',v:{Kv:3}}]},
    {layer:2,phase:'Vikriti · Your current state',text:'Your sleep quality recently?',sub:'The last two to three weeks.',opts:[{t:'Disrupted, light, mind won\'t switch off',h:'Anxiety-driven poor sleep',v:{Vv:3}},{t:'Adequate but vivid dreams, wake feeling hot',h:'Intense sleep',v:{Pv:3}},{t:'Heavy, long, hard to wake — still feel tired',h:'Oversleeping without rest',v:{Kv:3}}]},
    {layer:2,phase:'Vikriti · Your current state',text:'Your stress level right now?',sub:'Honestly — this week.',opts:[{t:'High anxiety, overwhelm, scattered',h:'Hard to focus or settle',v:{Vv:3}},{t:'High pressure, frustration, intensity',h:'Driven but burning',v:{Pv:3}},{t:'Feeling stuck, heavy, unmotivated',h:'Slow and resistant',v:{Kv:3}}]},
    {layer:2,phase:'Vikriti · Your current state',text:'Your diet recently?',sub:'What you\'ve actually been eating — honestly.',opts:[{t:'Irregular, cold foods, too much raw',h:'Skipping meals, erratic eating',v:{Vv:3}},{t:'Spicy, acidic, hot foods, caffeine or alcohol',h:'Stimulating diet',v:{Pv:3}},{t:'Heavy, sweet, processed, or dairy-rich',h:'Comfort eating or sluggish foods',v:{Kv:3}}]},
    {layer:2,phase:'Vikriti · Your current state',text:'Your primary skin concern right now?',sub:'What you\'d fix first if you could.',opts:[{t:'Dehydration, fine lines appearing, dullness',h:'Skin feels depleted',v:{Vv:3}},{t:'Redness, sensitivity, hyperpigmentation, breakouts',h:'Skin is reactive',v:{Pv:3}},{t:'Congestion, enlarged pores, excess oil, flat texture',h:'Skin feels heavy',v:{Kv:3}}]},
    {layer:2,phase:'Vikriti · Your current state',text:'How long have you felt this way?',sub:'When did your skin last feel truly balanced?',opts:[{t:'Recently — last few weeks',h:'Acute, triggered by something',v:{Vv:1,Pv:1,Kv:1}},{t:'Several months',h:'Chronic pattern building',v:{Vv:2,Pv:2,Kv:2}},{t:'This is just how my skin is',h:'Long-standing imbalance',v:{Vv:3,Pv:3,Kv:3}}]},
    {layer:3,phase:'Environment · Your external world',text:'Your climate right now?',sub:'Where you live — current conditions.',opts:[{t:'Cold, dry, or windy',h:'Autumn/winter or arid',v:{V:2}},{t:'Hot, humid, or intense sun',h:'Summer or tropical',v:{P:2}},{t:'Cool, damp, or overcast',h:'Spring or temperate',v:{K:2}}]},
    {layer:3,phase:'Environment · Your external world',text:'Your current season?',sub:'Seasonally, where are you right now?',opts:[{t:'Autumn or early winter',h:'Vata season — dry and mobile',v:{V:2}},{t:'Late spring or summer',h:'Pitta season — hot and intense',v:{P:2}},{t:'Late winter or spring',h:'Kapha season — heavy and damp',v:{K:2}}]},
    {layer:3,phase:'Environment · Your external world',text:'Your water quality at home?',sub:'What your skin absorbs daily in the shower.',opts:[{t:'Hard water — mineral-heavy',h:'May strip or irritate the skin barrier',v:{Pv:1,Vv:1}},{t:'Soft water or filtered',h:'Gentler on the skin',v:{K:1}},{t:'Unknown',h:'I\'ve never thought about it',v:{}}]},
    {layer:3,phase:'Environment · Your external world',text:'Your current skincare ritual consistency?',sub:'Honestly — how often do you actually do it?',opts:[{t:'Minimal or irregular — maybe 3-4 times a week',h:'No established ritual yet',v:{Vv:1}},{t:'Daily but quick — under 5 minutes',h:'Functional routine',v:{}},{t:'Consistent and intentional — morning and night',h:'Committed practice',v:{K:1}}]}
  ];

  function initDeepQuiz(S) {
    deepCurrent = 0;
    deepAnswers = {};
    deepScores = { V: 0, P: 0, K: 0, Vv: 0, Pv: 0, Kv: 0 };
    renderDeepQuestion(S);
  }

  function renderDeepQuestion(S) {
    var q = DEEP_QUESTIONS[deepCurrent];
    var pct = Math.round(((deepCurrent + 1) / 18) * 100);
    var fill = $s('qp-deep-' + S);
    if (fill) fill.style.width = pct + '%';

    var count = $s('deep-count-' + S);
    if (count) count.textContent = (deepCurrent + 1) + ' of 18';

    var phase = $s('deep-phase-' + S);
    if (phase) phase.textContent = q.phase;

    for (var i = 1; i <= 3; i++) {
      var pill = $s('lp' + i + '-' + S);
      if (pill) pill.classList.toggle('active', q.layer === i);
    }

    var area = $s('deep-question-area-' + S);
    if (!area) return;

    area.innerHTML = '<div class="q-step active"><div class="q-text">' + q.text + '</div><div class="q-sub">' + q.sub + '</div><div class="q-options" id="deep-opts-' + S + '"></div></div>';

    var optsContainer = $s('deep-opts-' + S);
    if (!optsContainer) return;

    for (var j = 0; j < q.opts.length; j++) {
      var opt = q.opts[j];
      var div = document.createElement('div');
      div.className = 'q-opt' + (deepAnswers['q' + deepCurrent] === j ? ' selected' : '');
      var dotContent = deepAnswers['q' + deepCurrent] === j ? '<span style="display:block;width:6px;height:6px;border-radius:50%;background:#fff;margin:auto;margin-top:3px"></span>' : '';
      div.innerHTML = '<div class="q-opt-dot">' + dotContent + '</div><div class="q-opt-text"><div class="q-opt-main">' + opt.t + '</div><div class="q-opt-hint">' + opt.h + '</div></div>';
      div.onclick = (function(idx) {
        return function() { selectDeepOpt(idx, S); };
      })(j);
      optsContainer.appendChild(div);
    }

    var nextBtn = $s('deep-next-' + S);
    if (nextBtn) nextBtn.classList.toggle('ready', deepAnswers['q' + deepCurrent] !== undefined);

    var backBtn = $s('deep-back-' + S);
    if (backBtn) backBtn.style.visibility = deepCurrent === 0 ? 'hidden' : 'visible';
  }

  function selectDeepOpt(idx, S) {
    deepAnswers['q' + deepCurrent] = idx;
    var opts = document.querySelectorAll('#deep-opts-' + S + ' .q-opt');
    for (var i = 0; i < opts.length; i++) opts[i].classList.remove('selected');
    if (opts[idx]) opts[idx].classList.add('selected');

    var nextBtn = $s('deep-next-' + S);
    if (nextBtn) nextBtn.classList.add('ready');
  }

  window.deepBack = function(S) {
    if (deepCurrent === 0) { goToScreen('screen-entry-' + S); return; }
    deepCurrent--;
    renderDeepQuestion(S);
  };

  window.deepNext = function(S) {
    if (deepAnswers['q' + deepCurrent] === undefined) return;
    var q = DEEP_QUESTIONS[deepCurrent];
    var chosen = q.opts[deepAnswers['q' + deepCurrent]];
    if (chosen && chosen.v) {
      for (var key in chosen.v) {
        if (chosen.v.hasOwnProperty(key)) {
          deepScores[key] = (deepScores[key] || 0) + chosen.v[key];
        }
      }
    }
    if (deepCurrent < 17) {
      deepCurrent++;
      renderDeepQuestion(S);
    } else {
      computeDeepResult(S);
    }
  };

  function computeDeepResult(S) {
    var V = deepScores.V || 0;
    var P = deepScores.P || 0;
    var K = deepScores.K || 0;
    var Vv = deepScores.Vv || 0;
    var Pv = deepScores.Pv || 0;
    var Kv = deepScores.Kv || 0;

    var max = Math.max(V, P, K);
    var vals = [V, P, K];
    var names = ['V', 'P', 'K'];
    var primaryIdx = vals.indexOf(max);
    var primary = names[primaryIdx];

    var remaining = vals.slice();
    remaining.splice(primaryIdx, 1);
    var secondMax = Math.max(remaining[0], remaining[1]);
    var secondIdx = vals.indexOf(secondMax);
    var secondName = names[secondIdx];

    var dosha = 'balanced';
    if (max - secondMax > 4) {
      dosha = primary === 'V' ? 'vata' : primary === 'P' ? 'pitta' : 'kapha';
    } else if (max - secondMax <= 4 && max > 10) {
      var pair = [primary, secondName].sort().join('-');
      dosha = pair === 'P-V' || pair === 'V-P' ? 'dual-vata-pitta' :
              pair === 'K-V' || pair === 'V-K' ? 'dual-vata-kapha' :
              'dual-kapha-pitta';
    }

    var vikMax = Math.max(Vv, Pv, Kv);
    var vikNames = ['Vv', 'Pv', 'Kv'];
    var vikVals = [Vv, Pv, Kv];
    var vikPrimary = vikNames[vikVals.indexOf(vikMax)];
    var imbalanceNote = '';
    if (vikMax > 6) {
      if (vikPrimary === 'Vv') imbalanceNote = ' Currently, Vata is elevated — your skin needs extra grounding and hydration.';
      else if (vikPrimary === 'Pv') imbalanceNote = ' Currently, Pitta is elevated — your skin needs cooling and anti-inflammatory support.';
      else imbalanceNote = ' Currently, Kapha is elevated — your skin needs clarifying and stimulating treatment.';
    }

    resultSource = 'Deep Dosha';
    scanMarkers = null;
    currentDosha = dosha;

    var insight = DOSHA_DATA[dosha] ? DOSHA_DATA[dosha].insight + imbalanceNote : 'Your dosha profile is complete.';

    if (!isProductsLoaded) {
      fetchShopifyProducts().then(function() {
        showResult(dosha, insight, false, S);
      });
    } else {
      showResult(dosha, insight, false, S);
    }
  }

  // ─── MODALS ───
  window.openDoshaModal = function(S) {
    var d = DOSHA_DATA[currentDosha] || DOSHA_DATA.balanced;
    var modalMap = {
      'vata': 'vataModal-' + S,
      'pitta': 'pittaModal-' + S,
      'kapha': 'kaphaModal-' + S,
      'dual-vata-pitta': 'vataModal-' + S,
      'dual-vata-kapha': 'vataModal-' + S,
      'dual-kapha-pitta': 'pittaModal-' + S,
      'balanced': 'tridoshicModal-' + S
    };
    var modalId = modalMap[currentDosha] || 'tridoshicModal-' + S;
    var el = $s(modalId);
    if (el) el.classList.add('active');
  };

  window.closeModal = function(id) {
    var el = $s(id);
    if (el) el.classList.remove('active');
  };

  // ─── EMAIL SAVE ───
  window.saveEmail = function(S) {
    var input = $s('ebEmail-' + S);
    if (!input || !input.value || input.value.indexOf('@') === -1) return;
    var confirm = $s('ebConfirm-' + S);
    if (confirm) confirm.classList.add('show');
    if (input) input.disabled = true;

    // Optional: Send to Shopify customer email capture
    var email = input.value;
    fetch('/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email })
    }).catch(function() {});
  };

  // ─── INIT ───
  function init() {
    fetchShopifyProducts().then(function() {
      initDeepQuiz(SID);
      selectMode('camera', SID);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

})();
</script>

