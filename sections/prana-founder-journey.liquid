<section class="prana-journey-about"><div class="section"><div class="pf-wrap">
<div class="pf-timeline-section">
      <div class="pf-tl-head">{{ section.settings.journey_label | escape }}</div>
      <h2 class="pf-tl-title">{{ section.settings.journey_heading | escape }}</h2>

<prana-journey-reveal>
<ol class="pf-timeline">
{% for block in section.blocks %}
{% if block.type == 'milestone' %}
<li class="pf-milestone" {{ block.shopify_attributes }}>
<div class="pf-tl-year">{{ block.settings.year | escape }}</div>
<h3 class="pf-tl-event">{{ block.settings.title | escape }}</h3>
<p class="pf-tl-desc">{{ block.settings.description | escape }}</p>
</li>
{% endif %}
{% endfor %}
</ol>
</prana-journey-reveal></div></div></div></section>
{% stylesheet %}
.prana-journey-about {
    background:var(--canvas);
    color:var(--heading-color);
    font-family:var(--U);
    padding:96px 24px 40px;
    overflow:hidden;
  }
.prana-journey-about .pf-wrap {max-width:1180px; margin:0 auto;}
.prana-journey-about .pf-timeline-section {margin-top:20px; padding-top:56px; border-top:1px solid var(--gold-line);}
.prana-journey-about .pf-tl-head {
    font-family:var(--U); font-size:12px; letter-spacing:0.18em; text-transform:uppercase;
    color:var(--ink3); margin-bottom:8px;
  }
.prana-journey-about .pf-tl-title {
    font-family:var(--D); font-weight:400; font-size:clamp(26px,2.6vw,34px);
    margin:0 0 56px; color:var(--heading-color);
  }
.prana-journey-about .pf-tl-year {font-family:var(--U); font-size:12.5px; letter-spacing:0.08em; color:var(--gold); margin-bottom:8px;}
.prana-journey-about .pf-tl-event {font-family:var(--D); font-weight:500; font-size:19px; color:var(--heading-color); margin-bottom:8px; line-height:1.3;}
.prana-journey-about .pf-tl-desc {font-size:14.5px; line-height:1.65; color:var(--ink3); max-width:36ch;}
.prana-journey-about { background:radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%); padding:60px 0; color:var(--ink3); }
.prana-journey-about .pf-wrap { width:100%; max-width:none; min-width:0; grid-column:2; }
.prana-journey-about .pf-tl-title { font-family:var(--font-h2--family); font-size:38px; font-weight:400; line-height:1.1; max-width:700px; }
.prana-journey-about .pf-tl-head { font-size:14px; letter-spacing:normal; text-transform:none; }
.prana-journey-about .pf-timeline { position:relative; list-style:none; margin:0; padding:0; }
.prana-journey-about .pf-timeline::before { content:''; position:absolute; left:50%; top:0; bottom:0; width:1px; background:var(--gold); }
.prana-journey-about .pf-milestone { position:relative; width:50%; padding:0 36px 40px 0; text-align:right; }
.prana-journey-about .pf-milestone:nth-child(even) { margin-left:50%; padding:0 0 40px 36px; text-align:left; }
.prana-journey-about .pf-milestone::before { content:''; position:absolute; right:-6px; top:5px; width:12px; height:12px; border-radius:50%; background:var(--gold); border:2px solid var(--canvas); }
.prana-journey-about .pf-milestone:nth-child(even)::before { left:-6px; right:auto; }
.prana-journey-about .pf-tl-year { font-size:14px; letter-spacing:normal; }
.prana-journey-about .pf-tl-event { font-family:var(--font-h3--family); font-size:24px; }
.prana-journey-about .pf-tl-desc { font-family:var(--U); font-size:16px; max-width:none; margin:0; }
@media(max-width:900px) {
.prana-journey-about .pf-timeline::before { left:6px; }
.prana-journey-about .pf-milestone, .prana-journey-about .pf-milestone:nth-child(even) { width:100%; margin-left:0; padding:0 0 32px 36px; text-align:left; }
.prana-journey-about .pf-milestone::before, .prana-journey-about .pf-milestone:nth-child(even)::before { left:0; right:auto; }
}
@media(max-width:749px) {
.prana-journey-about { padding:40px 0; }
.prana-journey-about .pf-tl-title { font-size:24px; line-height:1.2; margin-bottom:32px; }
.prana-journey-about .pf-tl-event { font-size:20px; line-height:1.25; margin-bottom:6px; }
.prana-journey-about .pf-tl-year { font-size:13px; margin-bottom:6px; }
.prana-journey-about .pf-tl-desc { font-size:15px; line-height:1.5; }
}

.prana-journey-about .pf-timeline-section { margin-top:0; padding-top:0; border-top:0; }
prana-journey-reveal { display:block; }
@media (prefers-reduced-motion: no-preference) {
  .prana-journey-about .pf-milestone.pf-revealed {
    animation: prana-journey-enter 650ms ease-out both;
  }
}
@keyframes prana-journey-enter {
  from { opacity:0; transform:translateY(24px); }
  to { opacity:1; transform:translateY(0); }
}
{% endstylesheet %}
{% javascript %}
if (!customElements.get('prana-journey-reveal')) {
  customElements.define('prana-journey-reveal', class extends HTMLElement {
    connectedCallback() {
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      this.observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('pf-revealed');
          this.observer.unobserve(entry.target);
        });
      }, { threshold:0.1 });
      this.querySelectorAll('.pf-milestone').forEach((item) => this.observer.observe(item));
    }
    disconnectedCallback() {
      this.observer?.disconnect();
    }
  });
}
{% endjavascript %}
