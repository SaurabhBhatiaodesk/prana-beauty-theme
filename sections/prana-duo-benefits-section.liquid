{% if request.design_mode %}
  <div
    id="BundlerLiveIds-{{ section.id }}"
    class="bundler-live-ids"
    data-shop="{{ shop.permanent_domain | escape }}"
  >
    <strong>Bundle IDs (live from Bundler — only visible while editing):</strong>
    <div class="bundler-live-ids__list">Loading bundles from Bundler...</div>
  </div>

  <style>
    #BundlerLiveIds-{{ section.id }} {
      margin: 16px 0;
      padding: 18px 20px;
      border: 1px dashed #c8a978;
      background: #fbfaf3;
      color: #40372f;
      font-family: monospace;
      font-size: 14px;
      line-height: 1.6;
    }

    #BundlerLiveIds-{{ section.id }} .bundler-live-ids__list {
      margin-top: 10px;
    }

    #BundlerLiveIds-{{ section.id }} .bundler-live-ids__item + .bundler-live-ids__item {
      margin-top: 4px;
    }
  </style>

  <script>
    (function () {
      const root = document.getElementById('BundlerLiveIds-{{ section.id }}');
      if (!root) return;

      const listEl = root.querySelector('.bundler-live-ids__list');
      const shop = root.dataset.shop;

      function getValue(obj, keys) {
        for (const key of keys) {
          if (obj && obj[key] !== undefined && obj[key] !== null) {
            return obj[key];
          }
        }
        return '';
      }

      function renderBundles() {
        if (
          typeof window.bndlr === 'undefined' ||
          typeof window.bndlr.getBundles !== 'function'
        ) {
          return false;
        }

        let bundles;

        try {
          bundles = window.bndlr.getBundles();
        } catch (error) {
          console.error('Bundler getBundles error:', error);
          listEl.textContent = 'Unable to read bundles from Bundler.';
          return true;
        }

        if (!Array.isArray(bundles)) {
          if (bundles && Array.isArray(bundles.bundles)) {
            bundles = bundles.bundles;
          } else if (bundles && typeof bundles === 'object') {
            bundles = Object.values(bundles);
          } else {
            bundles = [];
          }
        }

        if (!bundles.length) {
          listEl.textContent = 'No bundles found.';
          return true;
        }

        listEl.innerHTML = '';

        bundles.forEach(function (bundle) {
          const name = getValue(bundle, [
            'name',
            'title',
            'bundle_name',
            'bundleName'
          ]) || 'Unnamed bundle';

          const id = getValue(bundle, [
            'id',
            'bundle_id',
            'bundleId'
          ]);

          const enabledValue = getValue(bundle, [
            'enabled',
            'is_enabled',
            'active',
            'isActive'
          ]);

          let status = '';

          if (enabledValue !== '') {
            const isEnabled =
              enabledValue === true ||
              enabledValue === 1 ||
              enabledValue === '1' ||
              enabledValue === 'true';

            status = isEnabled ? ' (enabled)' : ' (disabled)';
          }

          const row = document.createElement('div');
          row.className = 'bundler-live-ids__item';
          row.textContent =
            name +
            ' = ' +
            (id !== '' ? id : 'ID not exposed') +
            status;

          listEl.appendChild(row);
        });

        return true;
      }

      function ensureBundlerScript() {
        if (renderBundles()) return;

        const existingScript = document.querySelector(
          'script[src*="cdn-bundler.nice-team.net/app/js/bundler.js"]'
        );

        if (!existingScript) {
          const script = document.createElement('script');
          script.type = 'text/javascript';
          script.async = true;
          script.src =
            'https://cdn-bundler.nice-team.net/app/js/bundler.js?shop=' +
            encodeURIComponent(shop);

          document.head.appendChild(script);
        }

        document.addEventListener(
          'bundler:loaded',
          function () {
            renderBundles();
          },
          { once: true }
        );

        let tries = 0;

        const timer = setInterval(function () {
          tries += 1;

          if (renderBundles() || tries >= 40) {
            clearInterval(timer);

            if (tries >= 40 && !renderBundles()) {
              listEl.textContent =
                'Bundler loaded slowly or did not expose bundle data.';
            }
          }
        }, 250);
      }

      ensureBundlerScript();
    })();
  </script>
{% endif %}
