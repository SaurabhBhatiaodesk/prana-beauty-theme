<section
  class="prana-bundle-section"
  data-bundle-id="{{ section.settings.bundle_id | escape }}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="section">
    {% if request.design_mode %}
      <div class="prana-bundler-editor-helper" id="PranaBundlerHelper-{{ section.id }}">
        <strong>Bundle IDs (live from Bundler — only visible while editing):</strong>
        <div class="prana-bundler-editor-helper__list">Loading bundles...</div>
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <div class="prana-bundle-section__header">
        <h2 class="prana-bundle-section__heading">{{ section.settings.heading }}</h2>

        {% if section.settings.description != blank %}
          <div class="prana-bundle-section__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div
      id="PranaBundlerWidget-{{ section.id }}"
      class="prana-bundle-section__widget"
      data-selected-bundle-id="{{ section.settings.bundle_id | escape }}"
    >
      {% if section.settings.bundle_shortcode != blank %}
        {{ section.settings.bundle_shortcode }}
      {% elsif request.design_mode %}
        <div class="prana-bundle-section__empty">
          Add the Bundle ID above, then paste this bundle's shortcode in the
          “Bundle shortcode” setting if Bundler does not expose widget HTML automatically.
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
.prana-bundle-section {
  background: var(--section-bg);
  padding-top: var(--padding-top);
  padding-bottom: var(--padding-bottom);
}

.prana-bundle-section__header {
  max-width: 760px;
  margin: 0 auto 28px;
  text-align: center;
}

.prana-bundle-section__heading {
  margin: 0;
  color: var(--heading-color);
  font-family: var(--D);
  font-size: 38px;
  font-weight: 400;
  line-height: 1.1;
}

.prana-bundle-section__description,
.prana-bundle-section__description p {
  margin: 10px 0 0;
  color: var(--text-color);
  font-family: var(--S);
  font-size: 16px;
  line-height: 1.55;
}

.prana-bundle-section__widget {
  width: 100%;
}

.prana-bundle-section__empty {
  padding: 18px 20px;
  border: 1px dashed var(--border-color);
  color: var(--text-color);
  font-family: var(--S);
  font-size: 14px;
  line-height: 1.5;
  text-align: center;
}

.prana-bundler-editor-helper {
  margin: 0 0 20px;
  padding: 16px 18px;
  border: 1px dashed #c8a978;
  background: #fbfaf3;
  color: #40372f;
  font-family: monospace;
  font-size: 13px;
  line-height: 1.6;
}

.prana-bundler-editor-helper__list {
  margin-top: 8px;
}

.prana-bundler-editor-helper__item + .prana-bundler-editor-helper__item {
  margin-top: 3px;
}

/* Native Bundler widget: keep it inside this section */
.prana-bundle-section__widget .bndlr-container {
  margin: 0 auto !important;
  max-width: 100% !important;
}

@media (max-width: 749px) {
  .prana-bundle-section__heading {
    font-size: 28px;
  }
}
{% endstylesheet %}

<script>
  (function () {
    const section = document.querySelector(
      '.prana-bundle-section[data-bundle-id="{{ section.settings.bundle_id | escape }}"]'
    );

    if (!section) return;

    const selectedBundleId = String(section.dataset.bundleId || '').trim();
    const widgetRoot = document.getElementById('PranaBundlerWidget-{{ section.id }}');

    {% if request.design_mode %}
      const helperRoot = document.getElementById('PranaBundlerHelper-{{ section.id }}');
      const helperList = helperRoot
        ? helperRoot.querySelector('.prana-bundler-editor-helper__list')
        : null;
    {% endif %}

    function normalizeBundles(raw) {
      if (Array.isArray(raw)) return raw;
      if (raw && Array.isArray(raw.bundles)) return raw.bundles;
      if (raw && typeof raw === 'object') return Object.values(raw);
      return [];
    }

    function getBundleId(bundle) {
      return String(
        bundle?.id ??
        bundle?.bundle_id ??
        bundle?.bundleId ??
        ''
      );
    }

    function getBundleName(bundle) {
      return (
        bundle?.name ||
        bundle?.title ||
        bundle?.bundle_name ||
        bundle?.bundleName ||
        'Unnamed bundle'
      );
    }

    function renderEditorList(bundles) {
      {% if request.design_mode %}
        if (!helperList) return;

        helperList.innerHTML = '';

        if (!bundles.length) {
          helperList.textContent = 'No bundles found.';
          return;
        }

        bundles.forEach(function (bundle) {
          const row = document.createElement('div');
          row.className = 'prana-bundler-editor-helper__item';
          row.textContent = getBundleName(bundle) + ' = ' + getBundleId(bundle);
          helperList.appendChild(row);
        });
      {% endif %}
    }

    function tryRenderSelectedBundle() {
      if (!window.bndlr || typeof window.bndlr.getBundles !== 'function') {
        return false;
      }

      let bundles = [];

      try {
        bundles = normalizeBundles(window.bndlr.getBundles());
      } catch (error) {
        console.error('Bundler getBundles error:', error);
        return true;
      }

      renderEditorList(bundles);

      if (!selectedBundleId || !widgetRoot) {
        return true;
      }

      const selectedBundle = bundles.find(function (bundle) {
        return getBundleId(bundle) === selectedBundleId;
      });

      if (!selectedBundle) {
        {% if request.design_mode %}
          if (widgetRoot && !widgetRoot.children.length) {
            widgetRoot.innerHTML =
              '<div class="prana-bundle-section__empty">Bundle ID ' +
              selectedBundleId +
              ' was not found in Bundler.</div>';
          }
        {% endif %}
        return true;
      }

      /*
        Bundler officially renders a specific bundle via its bundle shortcode.
        If the storefront object exposes shortcode/html, use it automatically.
      */
      const exposedHtml =
        selectedBundle.shortcode ||
        selectedBundle.bundle_shortcode ||
        selectedBundle.html ||
        selectedBundle.widget_html ||
        selectedBundle.widgetHtml ||
        '';

      if (exposedHtml && widgetRoot && !widgetRoot.querySelector('.bndlr-container')) {
        widgetRoot.innerHTML = exposedHtml;
      }

      if (typeof window.bndlr.refresh === 'function') {
        window.bndlr.refresh();
      }

      return true;
    }

    function loadBundler() {
      if (tryRenderSelectedBundle()) return;

      const existing = document.querySelector(
        'script[src*="cdn-bundler.nice-team.net/app/js/bundler.js"]'
      );

      if (!existing) {
        const script = document.createElement('script');
        script.type = 'text/javascript';
        script.async = true;
        script.src =
          'https://cdn-bundler.nice-team.net/app/js/bundler.js?shop={{ shop.permanent_domain | escape }}';
        document.head.appendChild(script);
      }

      document.addEventListener(
        'bundler:loaded',
        function () {
          tryRenderSelectedBundle();

          if (
            window.bndlr &&
            typeof window.bndlr.refresh === 'function'
          ) {
            window.bndlr.refresh();
          }
        },
        { once: true }
      );

      let tries = 0;

      const timer = setInterval(function () {
        tries += 1;

        if (tryRenderSelectedBundle() || tries >= 40) {
          clearInterval(timer);

          if (
            window.bndlr &&
            typeof window.bndlr.refresh === 'function'
          ) {
            window.bndlr.refresh();
          }
        }
      }, 250);
    }

    loadBundler();
  })();
</script>

{% schema %}
{
  "name": "PRANA Bundle Widget",
  "settings": [
    {
      "type": "header",
      "content": "Bundler"
    },
    {
      "type": "text",
      "id": "bundle_id",
      "label": "Bundle ID",
      "info": "Copy the ID from the live bundle list shown in Theme Editor."
    },
    {
      "type": "liquid",
      "id": "bundle_shortcode",
      "label": "Bundle shortcode",
      "info": "Paste the shortcode copied from Bundler > Bundle > Bundle shortcode. Leave blank if Bundler exposes the widget automatically."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PRANA Discovery Kit"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>The ultimate Ayurvedic skincare discovery kit.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F7F1E8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2E2925"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5C554F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#DED5CA"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "PRANA Bundle Widget"
    }
  ]
}
{% endschema %}
