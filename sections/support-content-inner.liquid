        {% case block.type %}
            {% when 'section_heading' %}
                <{{ block.settings.heading_level }} class="section-heading">
                    {{ block.settings.heading }}
                </{{ block.settings.heading_level }}>

            {% when 'paragraph' %}
                <div class="paragraph-block">
                    {{ block.settings.content }}
                </div>

            {% when 'paragraph_with_heading' %}
                <div class="paragraph-with-heading">
                    {% if block.settings.subheading != blank %}
                        <h3>{{ block.settings.subheading }}</h3>
                    {% endif %}
                    {{ block.settings.content }}
                </div>

            {% when 'bulleted_list' %}
                <div class="list-block">
                    {% if block.settings.list_title != blank %}
                        <h3>{{ block.settings.list_title }}</h3>
                    {% endif %}
                    {{ block.settings.list_items }}
                </div>

            {% when 'numbered_list' %}
