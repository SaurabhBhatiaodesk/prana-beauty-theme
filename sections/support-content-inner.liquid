<style>
.layout-support{
    max-width:800px;
    margin:0 auto;
    font-size: 14px;
    font-weight: 300;
    line-height: normal;
    color: #000;
}
.layout-support ul {
    margin: 0 0 20px 0;
    padding: 0;
}
.layout-support h2{
    font-size:22px;
    color:var(--heading-color);
    padding:10px 0;
}
{% comment %} .layout-support h3 {
    font-size: 16px;
    color: #000;
    padding-bottom: 10px;
} {% endcomment %}
.layout-support li{
    margin-left:30px;
}
.doc-header {
    background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
    display: flex;
    justify-content: center;
    padding: 60px 0;
    text-align: center;
}
h1.dh-title {
    font-size: 56px;
    color: var(--heading-color);
    font-weight: 500;
    margin:10px 0 15px 0;
}
.rights-grid .right-card {
    box-shadow: 2px 2px 4px 0px #4613244D;
    border: 1px solid var(--heading-color);
    background: #fff;
    border-radius: 7px;
    padding: 18px 16px 16px;
}
.promise-box {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    justify-content: center;
    align-items: stretch;
    gap:10px;
    margin:0 0 30px 0;
}
.promise-box-items {
    background: #E3C39F;
    border: 1px solid #461324;
    border-radius: 9px;
    padding: 22px 20px 18px;
    position: relative;
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    box-shadow: 2px 2px 4px 0px #4613244D;
    height: 100%;
    text-align: center;
}
.promise-box-items:hover {
    transform: translateY(-3px);
    box-shadow: 4px 4px 8px 0px #4613244D;
}
.pb-item-icon {
    margin-bottom: 0;
    display: flex;
    justify-content: center;
}
.pb-item-icon svg {
    width: 40px;
    height: 40px;
}
.paragraph-block h3,
.paragraph-with-heading h5,
.paragraph-with-heading h6,
.paragraph-with-heading h4{
    font-size:14px;
    color: #020202ff;
    font-weight:600;
    padding:10px 0;
}
.paragraph-with-heading h3,
.rc-title,
.toc-label,
.pb-item-title {
    font-size:18px;
    font-weight: 400;
    color: var(--heading-color, #2c1f18);
    margin: 0;
    line-height: 1.2;
    padding: 10px 0 5px 0;
}
.pb-item-body {
    font-size: 14px;
    color: #000;
    line-height: 1.5;
}
.toc {
    background: #F3E4CD;
    border: 1px solid #461324;
    border-radius: 10px;
    padding: 20px 18px 22px;
    box-shadow: 2px 2px 4px 0px #4613244D;
    margin-bottom: 40px;
}
.toc-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 40px;
    row-gap:10px;
}
/* Contents/Table of Contents with Arrows */
.contents-block {
    background: #F3E4CD;
    border: 1px solid #461324;
    border-radius: 10px;
    padding: 25px 30px 20px;
    box-shadow: 2px 2px 4px 0px #4613244D;
    margin-bottom: 30px;
}
.contents-title {
    font-size: 22px;
    font-weight: 500;
    color: var(--heading-color, #2c1f18);
    letter-spacing: 0.5px;
}
.contents-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 30px;
    row-gap: 8px;
}
.contents-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    padding:0;
    transition: color 0.2s;
    cursor: default;
}
.contents-item:hover {
    color: #461324;
}
.contents-arrow {
    color: #cb9646;
    font-size: 16px;
    font-weight: 400;
    min-width: 18px;
}
.contents-text {
    font-weight: 300;
}
.doc-wrap {
    padding:40px 0;
}
.rights-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 32px 0;
}
.warning-notice {
    background:#F3E4CD;
    border-left: 4px solid var(--heading-color);
    padding: 20px;
    margin: 20px 0;
    border-radius: 4px;
    box-shadow: 2px 2px 4px 0px #4613244D;
}
/* Terms Introduction Styles */
.terms-intro {
    margin: 20px 0 30px 0;
    background: #fff;
    border-radius: 10px;
    padding: 18px 16px 16px;
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    box-shadow: 2px 2px 4px 0px #4613244D;
    border: 1px solid var(--heading-color);
    color: #fff;
}
.terms-intro .intro-content {
    color:#000;
    font-size: 13px;
    line-height:normal;
}
.terms-intro .intro-content p {
    margin-bottom: 15px;
}
.terms-intro .intro-content p:last-child {
    margin-bottom: 0;
}
.terms-intro .intro-content strong {
    color: #461324;
}
/* Medical Disclaimer Styles */
.medical-disclaimer {
    background: #FDF6F0;
    border: 2px solid #cb9646;
    border-radius: 10px;
    padding: 25px 30px;
    margin: 25px 0;
    box-shadow: 0 2px 8px rgba(203, 150, 70, 0.15);
    position: relative;
}
.medical-disclaimer .disclaimer-icon {
    font-size: 24px;
    margin-right: 10px;
}
.medical-disclaimer .disclaimer-title {
    font-size: 18px;
    font-weight: 600;
    color: #461324;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
}
.medical-disclaimer .disclaimer-content {
    color: #6b5645;
    font-size: 14px;
    line-height: 1.6;
}
.medical-disclaimer .disclaimer-content strong {
    color: #461324;
}
/* Table Styles */
.policy-table-wrap {
    overflow-x: auto;
    margin: 20px 0 30px 0;
}
.policy-table {
    width: 100%;
    border-collapse: collapse;
    background: #fff;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.policy-table thead {
    background:var(--heading-color);
    color: #fff;
}
.paragraph-with-heading {
    border-top: 1px solid #000;
    padding-top: 20px;
    margin-top: 20px;
}
.policy-table th {
    padding: 14px 16px;
    text-align: left;
    font-weight: 500;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.policy-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--heading-color);
    color:#000;
}
.policy-table tbody tr:hover {
    background: #f9f4ed;
}
.policy-table tbody tr:last-child td {
    border-bottom: none;
}
/* Contact/Footer Styles */
.contact-footer {
    background: #E3C39F;
    border: 1px solid #461324;
    border-radius: 10px;
    padding: 20px 19px;
    margin: 25px 0 0 0;
    box-shadow: 2px 2px 4px 0px #4613244D;
}
.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap:15px;
    margin: 0px 0 9px 0;
}
.contact-item {
    text-align: center;
}
.contact-label {
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000;
    font-weight: 400;
    margin-bottom: 0;
}
.contact-value {
    font-size: 14px;
    font-weight: 400;
    color: var(--heading-color, #2c1f18);
    word-break: break-word;
}
.contact-value a {
    color: var(--heading-color, #2c1f18);
    text-decoration: none;
    transition: color 0.2s;
}
.contact-value a:hover {
    color: var(--heading-color);
    text-decoration: underline;
}
.contact-footer-note {
    text-align: center;
    font-size:14px;
    color: #000;
}
.contact-footer-note a {
    color: var(--heading-color);
    text-decoration: underline;
}
.contact-footer-note a:hover {
    color: #2c1f18;
}
.inner-policy-blocks {
  padding-top: {{ section.settings.padding_top_desktop | default: 60 }}px;
  padding-bottom: {{ section.settings.padding_bottom_desktop | default: 60 }}px;
  padding-inline:20px;
}


@media all and (max-width: 750px) {
   .inner-policy-blocks {
      padding-top: {{ section.settings.padding_top_mobile | default: 40 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
    }
    .policy-table {
      width: 800px;
    }
}


@media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 15px;
      row-gap: 8px;
    }
    .promise-box {
        grid-template-columns: 1fr;
    }
    .rights-grid {
        grid-template-columns: 1fr;
    }
    .contents-grid {
        grid-template-columns:1fr 1fr;
        gap: 0;
    }
    h1.dh-title {
        font-size: 32px;
    }
    .policy-table th,
    .policy-table td {
        padding: 10px 12px;
        font-size: 12px;
    }
    .contact-value {
        font-size: 13px;
        font-weight: 400;
        color: var(--heading-color, #2c1f18);
        word-break: break-word;
    }
    .contact-label {
      font-size: 14px;
    }
    .contact-footer {
        padding:20px;
    }
    .medical-disclaimer {
        padding: 20px;
    }
    .contents-block {
      padding: 19px 14px;
    }
    .terms-intro {
        padding: 20px;
    }
    .contents-item{
      gap:0;
    }
    .contents-arrow {
      display: none;
    }
    .promise-box-items {
        padding: 18px 15px;
    }
}
</style>

<div class="doc-header">
    <div class="section layout-support">
        {% if section.settings.brand_name != blank %}
            <div class="dh-logo">{{ section.settings.brand_name }}</div>
        {% endif %}
        {% if section.settings.title %}
        <h1 class="dh-title">{{ section.settings.title }}</h1>
        {% endif %}
        <div class="dh-meta">
            {% if section.settings.effective_date != blank %}
            <span>Effective: {{ section.settings.effective_date }}</span>
            <span>|</span>
            {% endif %}
            {% if section.settings.website_url != blank %}
            <span>{{ section.settings.website_url }}</span>
            <span>|</span>
            {% endif %}
            {% if section.settings.country != blank %}
            <span>{{ section.settings.country }}</span>
            {% endif %}
        </div>
    </div>
</div>


<div class="inner-policy-blocks layout-support">
