<section class="prana-founder-about"><div class="section">
  <div class="pf-wrap">

    <div class="pf-eyebrow">{{ section.settings.eyebrow | escape }}</div>
    <h2 class="pf-headline">{{ section.settings.heading }}</h2>
    <p class="pf-subhead">{{ section.settings.intro | escape }}</p>

    <div class="pf-tags">{% for block in section.blocks %}{% if block.type == 'tag' %}<span class="pf-tag" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</span>{% endif %}{% endfor %}</div>

    <div class="pf-media-grid{% if section.settings.image == blank and section.settings.video == blank %} pf-media-grid--text{% endif %}">
      {% if section.settings.image != blank or section.settings.video != blank %}
<div class="pf-media-col">
{% if section.settings.image != blank %}
<figure>{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 750, 1000, 1200', sizes: '(min-width: 901px) 40vw, 100vw', class: 'pf-photo' }}<figcaption class="pf-media-caption">{{ section.settings.location | escape }}</figcaption></figure>
{% endif %}
{% if section.settings.video != blank %}
<figure>{{ section.settings.video | video_tag: controls: true, autoplay: section.settings.video_autoplay, muted: section.settings.video_autoplay, playsinline: true, preload: 'metadata', image_size: '1000x', class: 'pf-video' }}<figcaption class="pf-media-caption">{{ section.settings.film_caption | escape }}</figcaption></figure>
{% endif %}
</div>
{% endif %}
<div class="pf-content">

        <blockquote class="pf-story-quote">{{ section.settings.quote | escape }}</blockquote>

        <div class="pf-body">{{ section.settings.story }}</div>

        <div class="pf-stats">{% for block in section.blocks %}{% if block.type == 'stat' %}<div class="pf-stat" {{ block.shopify_attributes }}><div class="pf-stat-num">{{ block.settings.number | escape }}</div><div class="pf-stat-label">{{ block.settings.title | escape }}</div></div>{% endif %}{% endfor %}</div>
<div class="pf-sign">
          <div class="pf-sign-name">{{ section.settings.founder_name | escape }}</div>
          <div class="pf-sign-title">{{ section.settings.founder_role | escape }}</div>
        </div>

      </div>
    </div>


    </div></div></section>
{% stylesheet %}
.prana-founder-about {
    background:var(--canvas);
    color:var(--heading-color);
    font-family:var(--U);
    padding:96px 24px 40px;
    overflow:hidden;
  }
.prana-founder-about .pf-wrap {max-width:1180px; margin:0 auto;}
.prana-founder-about .pf-eyebrow {
    display:flex; align-items:center; gap:14px;
    font-family:var(--U);
    font-size:12px; letter-spacing:0.22em; text-transform:uppercase;
    color:var(--ink3); margin-bottom:24px;
  }
.prana-founder-about .pf-eyebrow::before {content:""; width:34px; height:1px; background:var(--gold); display:inline-block;}
.prana-founder-about .pf-headline {
    font-family:var(--D); font-weight:400;
    font-size:clamp(32px, 3.6vw, 50px); line-height:1.12; letter-spacing:-0.01em;
    margin:0 0 20px; color:var(--heading-color); max-width:16ch;
  }
.prana-founder-about .pf-headline em {font-style:italic; font-weight:500; color:var(--heading-color);}
.prana-founder-about .pf-subhead {
    font-size:17px; line-height:1.6; color:var(--ink3); max-width:52ch; margin:0 0 36px;
  }
.prana-founder-about .pf-tags {
    display:flex; flex-wrap:wrap; gap:10px; margin-bottom:56px;
  }
.prana-founder-about .pf-tag {
    font-family:var(--U); font-size:11px; letter-spacing:0.05em;
    padding:7px 14px; border:1px solid var(--gold-line); border-radius:999px;
    color:var(--ink3); background:rgba(251,248,242,0.5);
  }
.prana-founder-about .pf-media-grid {
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:56px;
    align-items:start;
    margin-bottom:88px;
  }
.prana-founder-about .pf-media-col {
    display:flex; flex-direction:column; gap:20px;
  }
.prana-founder-about .pf-media-caption {
    display:flex; justify-content:space-between; align-items:baseline;
    font-family:var(--U); font-size:11px; letter-spacing:0.04em;
    color:var(--ink3); padding:0 2px;
  }
.prana-founder-about .pf-media-caption span:last-child {color:var(--gold);}
.prana-founder-about .pf-story-quote {
    font-family:var(--D); font-style:italic; font-weight:400;
    font-size:22px; line-height:1.5; color:var(--heading-color);
    padding-left:22px; border-left:2px solid var(--gold);
    margin:0 0 32px; max-width:48ch;
  }
.prana-founder-about .pf-body {font-size:16px; line-height:1.75; color:var(--ink3); max-width:58ch;}
.prana-founder-about .pf-body p {margin:0 0 18px;}
.prana-founder-about .pf-body p:last-child {margin-bottom:0;}
.prana-founder-about .pf-body strong {color:var(--heading-color); font-weight:600;}
.prana-founder-about .pf-stats {
    display:grid; grid-template-columns:repeat(3,1fr);
    gap:1px; background:var(--gold-line); border:1px solid var(--gold-line);
    margin:36px 0 32px;
  }
.prana-founder-about .pf-stat {background:var(--canvas); padding:20px 18px;}
.prana-founder-about .pf-stat-num {font-family:var(--D); font-weight:600; font-size:28px; color:var(--heading-color); line-height:1;}
.prana-founder-about .pf-stat-label {font-size:12px; color:var(--ink3); margin-top:6px; line-height:1.4;}
.prana-founder-about .pf-sign {display:flex; flex-direction:column; gap:2px;}
.prana-founder-about .pf-sign-name {font-family:var(--D); font-size:18px; font-weight:500;}
.prana-founder-about .pf-sign-title {font-family:var(--U); font-size:12px; letter-spacing:0.05em; color:var(--ink3); text-transform:uppercase;}
.prana-founder-about { background:radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%); padding:60px 0; color:var(--ink3); }
.prana-founder-about .pf-wrap { width:100%; max-width:none; min-width:0; grid-column:2; }
.prana-founder-about .pf-headline { font-family:var(--font-h2--family); font-size:38px; font-weight:400; line-height:1.1; max-width:700px; }
.prana-founder-about .pf-eyebrow { font-size:14px; letter-spacing:normal; text-transform:none; }
.prana-founder-about .pf-tag { font-size:14px; letter-spacing:normal; border-color:var(--gold); background:var(--canvas); }
.prana-founder-about .pf-body, .prana-founder-about .pf-body p { font-family:var(--U); font-size:17px; line-height:1.65; color:var(--ink3); }
.prana-founder-about .pf-story-quote { font-family:var(--S); font-size:24px; }
.prana-founder-about .pf-stat { background:#E3C39F; }
.prana-founder-about .pf-stat-label, .prana-founder-about .pf-media-caption, .prana-founder-about .pf-sign-title { font-size:14px; letter-spacing:normal; }
.prana-founder-about .pf-sign-name { font-size:24px; }
.prana-founder-about .pf-stats { border-radius:12px; overflow:hidden; }
.prana-founder-about figure { margin:0; }
.prana-founder-about .pf-photo { width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; border-radius:12px; }
.prana-founder-about .pf-video { width:100%; height:auto; border-radius:12px; }
.prana-founder-about .pf-media-caption { margin-top:10px; }
.prana-founder-about .pf-media-grid--text { grid-template-columns:1fr; }
.prana-founder-about .pf-media-grid--text .pf-content { max-width:850px; }
@media(max-width:900px) {
.prana-founder-about .pf-media-grid { grid-template-columns:1fr; gap:32px; }
.prana-founder-about .pf-stats { grid-template-columns:1fr; }
}
@media(max-width:749px) {
.prana-founder-about { padding:40px 0; }
.prana-founder-about .pf-headline { font-size:28px; }
.prana-founder-about .pf-body, .prana-founder-about .pf-body p, .prana-founder-about .pf-subhead { font-size:15px; line-height:1.5; }
.prana-founder-about .pf-story-quote { font-size:22px; }
}

.prana-founder-about .pf-media-grid { margin-bottom:0; }
{% endstylesheet %}
{% schema %}
{
  "name": "PRANA Meet the Founder",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Founder"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Where Ayurveda meets <em>modern science.</em>"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Blending a background in technology with a lifelong Ayurvedic inheritance — Prabha Iyer built PRANA to make ancient ritual as precise as anything she'd shipped in tech."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Founder quote",
      "default": "\"I carried a lifelong belief in the healing power of nature — a gift from my Ayurvedic roots. I decided to create something better.\""
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder name",
      "default": "Prabha Iyer"
    },
    {
      "type": "text",
      "id": "founder_role",
      "label": "Founder role",
      "default": "Founder, PRANA Beauty & Wellness"
    },
    {
      "type": "richtext",
      "id": "story",
      "label": "Founder story",
      "default": "<p>As an immigrant in New York, Prabha Iyer found mainstream skincare full of harsh chemicals and synthetic fragrances that didn't align with what she'd known since childhood. <strong>So she went back to the source</strong> — ethically sourced, all-natural Ayurvedic ingredients like saffron, turmeric, and sandalwood, paired with modern, science-backed formulation. Every batch is made small, to maximize potency and preserve purity.</p>\n\n          <p>In 2025, PRANA integrated AI-powered facial skin analysis into the ritual itself — reading skin tone, texture, and hydration, then mapping the result to Ayurvedic dosha balance to recommend the exact routine each woman needs.</p>\n\n          <p>As a mother navigating both motherhood and entrepreneurship, Prabha built PRANA on one belief: the most powerful beauty is the kind that doesn't demand compromise — on health, on ingredients, or on identity.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder photo"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Brand film"
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video",
      "default": false,
      "info": "Autoplay starts muted. Viewers can unmute using the video controls."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Photo caption",
      "default": "Jersey City, NJ"
    },
    {
      "type": "text",
      "id": "film_caption",
      "label": "Film caption",
      "default": "Watch the brand film"
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Heritage tag",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Text"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA Meet the Founder",
      "blocks": [
        {
          "type": "tag",
          "settings": {
            "title": "South Asian Heritage"
          }
        },
        {
          "type": "tag",
          "settings": {
            "title": "Ayurvedic Tradition"
          }
        },
        {
          "type": "tag",
          "settings": {
            "title": "Immigrant Founder"
          }
        },
        {
          "type": "tag",
          "settings": {
            "title": "Woman-Founded"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "11,000+",
            "title": "Women in ritual"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "5,000",
            "title": "Years of Ayurvedic science"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "100%",
            "title": "Woman-founded"
          }
        }
      ]
    }
  ]
}
{% endschema %}
