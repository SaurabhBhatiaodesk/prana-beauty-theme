{%- render 'ptm-assets' -%}
<div class="ptm">
<section class="tm-sec" aria-labelledby="sci-h-{{ section.id }}">
  <div class="tm-wrap">
    {%- if section.settings.heading != blank -%}<h2 id="sci-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="tm-intro">{{ section.settings.intro }}</p>{%- endif -%}
    {%- assign steps = section.blocks | where: 'type', 'step' -%}
    {%- if steps.size > 0 -%}
    <div class="tm-thread">
      {%- for block in steps -%}
      <div class="tm-step" {{ block.shopify_attributes }}>
        <div class="tm-node" aria-hidden="true">{{ block.settings.numeral }}</div>
        <h3>{{ block.settings.title }}</h3>
        {%- if block.settings.question != blank -%}<p class="tm-q">{{ block.settings.question }}</p>{%- endif -%}
        {{ block.settings.text }}
        {%- if block.settings.link_text != blank -%}<a href="{{ block.settings.link_url }}">{{ block.settings.link_text }}</a>{%- endif -%}
      </div>
      {%- endfor -%}
    </div>
    {%- endif -%}

    {%- assign rows = section.blocks | where: 'type', 'formula_row' -%}
    {%- if rows.size > 0 -%}
    <details class="tm-formula" id="formula">
      <summary><span class="tm-f-title">{{ section.settings.formula_title }}</span><span class="tm-formula-note">{{ section.settings.formula_subtitle }}</span></summary>
      <div class="tm-formula-scroll">
      <table>
        <thead><tr><th scope="col">{{ section.settings.col_ingredient }}</th><th scope="col">{{ section.settings.col_job }}</th><th scope="col">{{ section.settings.col_amount }}</th></tr></thead>
        <tbody>
          {%- for block in rows -%}<tr {{ block.shopify_attributes }}><td>{{ block.settings.ingredient }}</td><td>{{ block.settings.job }}</td><td>{{ block.settings.amount }}</td></tr>{%- endfor -%}
        </tbody>
      </table>
      </div>
      {%- if section.settings.formula_note != blank -%}<p class="tm-formula-note tm-formula-foot">{{ section.settings.formula_note }}</p>{%- endif -%}
    </details>
    {%- endif -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: Science & formula",
  "tag": "section",
  "class": "section-ptm",
  "max_blocks": 50,
  "blocks": [
    { "type": "step", "name": "Science step", "settings": [
      { "type": "text", "id": "numeral", "label": "Number" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "question", "label": "Subtitle" },
      { "type": "richtext", "id": "text", "label": "Text" },
      { "type": "text", "id": "link_text", "label": "Link text" },
      { "type": "text", "id": "link_url", "label": "Link", "info": "A page anchor like #bridal, or a URL" }
    ] },
    { "type": "formula_row", "name": "Formula row", "settings": [
      { "type": "text", "id": "ingredient", "label": "Ingredient" },
      { "type": "text", "id": "job", "label": "What it does" },
      { "type": "text", "id": "amount", "label": "Amount" }
    ] }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "header", "content": "Formula table" },
    { "type": "text", "id": "formula_title", "label": "Title", "default": "The full formula" },
    { "type": "text", "id": "formula_subtitle", "label": "Subtitle" },
    { "type": "text", "id": "col_ingredient", "label": "Column 1", "default": "Ingredient" },
    { "type": "text", "id": "col_job", "label": "Column 2", "default": "What it does" },
    { "type": "text", "id": "col_amount", "label": "Column 3", "default": "Amount" },
    { "type": "text", "id": "formula_note", "label": "Footnote" }
  ],
  "presets": [{ "name": "PDP: Science & formula" }]
}
{% endschema %}
