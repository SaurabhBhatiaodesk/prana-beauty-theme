

<!-- ═══ EMAIL CAPTURE ═══ -->

<div class="main-newsletter-form">

  <div class="section">

    <section class="ec-bar reveal newsletter_form-dev"

      style="

        background: {{ section.settings.bg_color }};

        padding-top: {{ section.settings.padding_top_desktop }}px;

        padding-bottom: {{ section.settings.padding_bottom_desktop }}px;">

      <div class="ec-left">



        {% if section.settings.caption != blank %}

          <div class="ec-eyebrow">{{ section.settings.caption }}</div>

        {% endif %}



        {% if section.settings.heading != blank %}

          <h3 class="ec-headline">{{ section.settings.heading }}</h3>

        {% endif %}



        {% if section.settings.heading != blank %}

          <h3 class="ec-highlight-heading">{{ section.settings.highlight_heading }}</h3>

        {% endif %}



        {% if section.settings.description != blank %}

          <p class="ec-sub">{{ section.settings.description }}</p>

        {% endif %}



        {% if section.settings.text1 != blank or section.settings.text2 != blank or section.settings.text3 != blank %}

          <div class="ec-perks">



            {% if section.settings.text1 != blank %}

              <li class="ec-perk">{{ section.settings.text1 }}</li>

            {% endif %}



            {% if section.settings.text2 != blank %}

              <li class="ec-perk">{{ section.settings.text2 }}</li>

            {% endif %}



            {% if section.settings.text3 != blank %}

              <li class="ec-perk">{{ section.settings.text3 }}</li>

            {% endif %}



          </div>

        {% endif %}



      </div>



      <div class="ec-right">

        <form

          id="emailCaptureForm-{{ section.id }}"

          class="ec-form contact-form__form"

          novalidate

        >



          <div

            id="emailCaptureError-{{ section.id }}"

            class="contact-form__error"

            role="alert"

            aria-live="polite"

            style="display: none; color: #8a1c1c;"

          ></div>



          <div class="ec-name-row">

            <input

              type="text"

              autocomplete="given-name"

              id="ContactForm-name-{{ section.id }}"

              class="ec-input"

              name="first_name"

              placeholder="First name"

            >



            <input

              type="text"

              autocomplete="family-name"

              id="ContactForm-last-name-{{ section.id }}"

              class="ec-input"

              name="last_name"

              placeholder="Last name"

            >

          </div>



          <input

            type="email"

            id="ContactForm-email-{{ section.id }}"

            class="ec-input ec-email"

            autocomplete="email"

            name="email"

            spellcheck="false"

            autocapitalize="off"

            aria-required="true"

            required

            placeholder="Email"

          >



          <input

            type="tel"

            id="ContactForm-phone-{{ section.id }}"

            class="ec-input ec-phone"

            autocomplete="tel"

            name="phone"

            inputmode="tel"

            placeholder="Phone number"

          >



          <button

            type="submit"

            class="ec-btn btn-gold"

            id="emailCaptureBtn-{{ section.id }}"

          >

            <span class="ec-btn-text">

              Start My Ritual — Join Free

            </span>



            <span class="ec-btn-arrow">→</span>

          </button>



        </form>



        <div

          id="emailCaptureSuccess-{{ section.id }}"

          class="contact-form__success ec-success-message"

          role="status"

          aria-live="polite"

          style="display: none;"

        >

          <span class="ec-success-check">✓</span>



          <span>

            Thank you for joining Women in Ritual. Your 10% off code is on its way to your email.

          </span>

        </div>



      </div>

    </section>

  </div>

</div>



<style>



/\* ── EMAIL CAPTURE BAR ──────────────────────────── \*/

.ec-bar {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 0;

  padding:0 40px;

  align-items: center;

  position: relative;

  overflow: hidden;

}



.ec-left {

  position: relative;

  z-index: 1;

  padding-right: 60px;

}



.ec-right {

  position: relative;

  z-index: 1;

  height: 100%;

  background: var(--canvas2);

  padding:40px;

  border-radius: 8px;

  box-sizing: border-box;

}



.ec-eyebrow {

  font-size: 17px;

  color: var(--ink3);

  margin-bottom: 11px;

}



.ec-headline {

  font-size: 30px;

  font-weight: 300;

  line-height: 1.1;

  color: var(--ink3);

  padding-bottom: 9px;

}



.ec-highlight-heading {

  color: var(--heading-color);

  font-size: 30px;

}



.ec-sub {

  font-family: var(--S);

  font-size: 18px;

  line-height: 1.7;

  color: var(--ink3);

  margin-bottom: 11px;

  max-width: 380px;

}



.ec-perks {

  display: flex;

  flex-direction: column;

  gap: 8px;

  padding-left: 17px;

}



.ec-perk {

  font-size: 17px;

  letter-spacing: .06em;

  color: var(--ink3);

  list-style: disc;

}



.section.main-newsletter-form {

  background:#f4e9d9;

}



.ec-form {

  display: flex;

  flex-direction: column;

  gap: 12px;

}



.ec-name-row {

  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 12px;

}



.ec-input {

  width: 100%;

  border: 1px solid rgba(168, 104, 26, .35);

  color: var(--canvas);

  font-family: var(--S);

  font-size: 15px;

  padding: 14px 18px;

  outline: none;

  transition: border-color .2s;

  box-sizing: border-box;

  background:#F1E2CF;

}



.ec-input::placeholder {

  color:var(--ink3);

}



.ec-btn {

  width: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 10px;

  padding: 10px 28px;

  background: var(--gold);

  color: var(--canvas);

  border: none;

  font-size: 17px;

  cursor: pointer;

  transition: background .2s;

  margin-top: 4px;

  border-radius: 5px;

}



.ec-btn:hover {

  background:var(--heading-color);

}



.ec-btn:disabled {

  cursor: not-allowed;

  opacity: .7;

}



.ec-btn-arrow {

  font-size: 14px;

  letter-spacing: 0;

}



/\* Success message inside right white box \*/

.ec-success-message {

    width: 100%;

    box-sizing: border-box;

    margin-top: 14px;

    padding: 10px 15px;

    align-items: center;

    justify-content: center;

    gap: 9px;

    background: #f0e8d6;

    border: 1px solid #a8681a;

    border-radius: 6px;

    color: #a8681a !important;

    font-size: 14px;

    font-weight: 600;

    line-height: 1.45;

    text-align: left;

}



.ec-success-check {

  flex: 0 0 22px;

  width: 22px;

  height: 22px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  background: #237a3b;

  color: #ffffff;

  border-radius: 50%;

  font-size: 13px;

  line-height: 1;

}



@media (max-width: 768px) {

  .ec-bar {

    grid-template-columns: 1fr;

    padding: 60px 17px;

    gap: 20px;

  }



  .ec-highlight-heading {

    font-size:20px;

    padding-bottom: 5px;

  }



  .ec-left {

    padding-right: 0;

  }



  .ec-name-row {

    grid-template-columns: 1fr;

  }

}



@media screen and (max-width: 767px) {

  .ec-bar {

    padding-top: {{ section.settings.padding_top_mobile }}px !important;

    padding-bottom: {{ section.settings.padding_bottom_mobile }}px !important;

  }



  .ec-right {

    background: transparent;

    padding: 0;

  }



  .ec-perks {

    gap: 3px;

  }



  .ec-perk {

    font-size:15px;

  }



  .ec-success-message {

    align-items: flex-start;

    font-size: 13px;

  }

}

</style>



<script>

(function () {

  const form = document.getElementById(

    'emailCaptureForm-{{ section.id }}'

  );



  if (!form || form.dataset.klaviyoConnected === 'true') {

    return;

  }



  form.dataset.klaviyoConnected = 'true';



  const firstNameInput = document.getElementById(

    'ContactForm-name-{{ section.id }}'

  );



  const lastNameInput = document.getElementById(

    'ContactForm-last-name-{{ section.id }}'

  );



  const emailInput = document.getElementById(

    'ContactForm-email-{{ section.id }}'

  );



  const submitButton = document.getElementById(

    'emailCaptureBtn-{{ section.id }}'

  );



  const buttonText = submitButton.querySelector('.ec-btn-text');



  const errorMessage = document.getElementById(

    'emailCaptureError-{{ section.id }}'

  );



  const successMessage = document.getElementById(

    'emailCaptureSuccess-{{ section.id }}'

  );



  const originalButtonText = buttonText.textContent;



  form.addEventListener('submit', async function (event) {

    event.preventDefault();



    errorMessage.style.display = 'none';

    errorMessage.textContent = '';

    successMessage.style.display = 'none';



    const email = emailInput.value.trim();

    const firstName = firstNameInput.value.trim();

    const lastName = lastNameInput.value.trim();



    if (!email || !emailInput.checkValidity()) {

      errorMessage.textContent =

        'Please enter a valid email address.';



      errorMessage.style.display = 'block';

      emailInput.focus();

      return;

    }



    submitButton.disabled = true;

    buttonText.textContent = 'Joining...';



    const profileAttributes = {

      email: email,

      subscriptions: {

        email: {

          marketing: {

            consent: 'SUBSCRIBED'

          }

        }

      }

    };



    if (firstName) {

      profileAttributes.first_name = firstName;

    }



    if (lastName) {

      profileAttributes.last_name = lastName;

    }



    const requestBody = {

      data: {

        type: 'subscription',

        attributes: {

          custom_source: 'Women in Ritual website form',

          profile: {

            data: {

              type: 'profile',

              attributes: profileAttributes

            }

          }

        },

        relationships: {

          list: {

            data: {

              type: 'list',

              id: 'UKs9eH'

            }

          }

        }

      }

    };



    try {

      const response = await fetch(

        'https\://a.klaviyo.com/client/subscriptions?company_id=XGnUFs',

        {

          method: 'POST',

          headers: {

            'accept': 'application/vnd.api+json',

            'content-type': 'application/vnd.api+json',

            'revision': '2026-04-15'

          },

          body: JSON.stringify(requestBody)

        }

      );



      if (!response.ok) {

        let errorText =

          'Unable to subscribe right now. Please try again.';



        try {

          const errorData = await response.json();



          if (

            errorData.errors &&

            errorData.errors[0] &&

            errorData.errors[0].detail

          ) {

            errorText = errorData.errors[0].detail;

          }

        } catch (parseError) {

          console.error(parseError);

        }



        throw new Error(errorText);

      }



      /\* Form visible rahega \*/

      form.reset();



      /\* Green success message right box ke andar show hoga \*/

      successMessage.style.display = 'flex';



      submitButton.disabled = false;

      buttonText.textContent = originalButtonText;



    } catch (error) {

      console.error('Klaviyo subscription error:', error);



      errorMessage.textContent =

        error.message ||

        'Unable to subscribe right now. Please try again.';



      errorMessage.style.display = 'block';



      submitButton.disabled = false;

      buttonText.textContent = originalButtonText;

    }

  });

})();

</script>



