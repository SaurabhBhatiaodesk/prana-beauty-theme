{%- comment -%}
  PRANA Turmeric & Sandalwood PDP — hero / buy box (from prana-turmeric-mask-pdp v19).
  Every text is a setting; checks, assurances and benefits are blocks. Price, subscription, images and the
  Loox rating come from the product. Placeholders from the source file use <mark class="fill"> (html settings).
  Compliance: describe a skin type ("for acne-prone skin"); never "treats / cures / clears acne".
{%- endcomment -%}
{%- render 'ptm-assets' -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign show_free_ship = false
  if section.settings.free_ship_threshold > 0 and localization.country.iso_code == section.settings.free_ship_country
    assign show_free_ship = true
  endif
  assign heading = section.settings.heading | default: product.title
  assign rating = product.metafields.loox.avg_rating
  assign rating_count = product.metafields.loox.num_reviews
-%}

<prana-tfm class="ptm ptm-has-sticky" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}" data-free-ship="{{ show_free_ship }}" data-free-ship-cents="{{ section.settings.free_ship_threshold | times: 100 }}" data-ship-free="{{ section.settings.ship_free_text | escape }}" data-ship-away="{{ section.settings.ship_away_text | escape }}" data-added-label="{{ section.settings.added_label | escape }}" data-error="{{ 'products.product.add_to_cart_error' | t | escape }}">
<section class="tm-wrap tm-hero" id="product">
  <div class="tm-gallery">
    <div class="tm-gallery-main">
      {%- if section.settings.skin_tag != blank -%}<span class="tm-skin-tag">{{ section.settings.skin_tag }}</span>{%- endif -%}
      {%- assign hero_image = variant.featured_image | default: product.featured_image -%}
      {%- if hero_image -%}{{ hero_image | image_url: width: 1200 | image_tag: id: 'mainImg', fetchpriority: 'high', widths: '600,800,1200', sizes: '(min-width: 980px) 50vw, 100vw' }}{%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
    <div class="tm-thumbs" role="group" aria-label="Product images">
      {%- for image in product.images -%}
        <button type="button" aria-current="{% if image.id == hero_image.id %}true{% else %}false{% endif %}" data-src="{{ image | image_url: width: 1200 }}" data-alt="{{ image.alt | escape }}">{{ image | image_url: width: 160 | image_tag: width: 160, height: 160, loading: 'lazy' }}</button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <div class="tm-buy">
    {%- if section.settings.for_text != blank -%}<span class="tm-for">{{ section.settings.for_text }}</span>{%- endif -%}
    <h1>{{ heading }}</h1>
    {%- if section.settings.subtitle != blank -%}<p class="tm-sub">{{ section.settings.subtitle }}</p>{%- endif -%}

    <div class="tm-rating">
      <span class="tm-stars" aria-hidden="true">★★★★★</span>
      {%- if rating != blank and rating_count > 0 -%}
        <a href="#reviews">{{ rating }} · {{ rating_count }} {{ section.settings.reviews_count_label }}</a>
      {%- else -%}
        <a href="#reviews">{{ section.settings.reviews_link_text }}</a>
      {%- endif -%}
      {%- if section.settings.tested_text != blank -%}<a class="tm-tested" href="#results">{{ section.settings.tested_text }}</a>{%- endif -%}
    </div>

    {%- if section.settings.proof != blank -%}<p class="tm-proof">{{ section.settings.proof }}{% if section.settings.proof_sub != blank %} <span>{{ section.settings.proof_sub }}</span>{% endif %}</p>{%- endif -%}
    {%- if section.settings.size_text != blank -%}<p class="tm-size">{{ section.settings.size_text }}</p>{%- endif -%}

    {%- form 'product', product, id: 'ptm-product-form', novalidate: 'novalidate' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1" data-qty-input>
      <fieldset class="tm-purchase" style="border:0;padding:0;margin:0 0 16px">
        <legend class="tm-sr">Purchase option</legend>
        {%- for allocation in variant.selling_plan_allocations -%}
          {%- assign compare = allocation.compare_at_price | default: variant.price -%}
          <label class="tm-opt">
            <input type="radio" name="selling_plan" value="{{ allocation.selling_plan.id }}" data-price="{{ allocation.price }}" {% if forloop.first %}checked{% endif %}>
            <span class="tm-t"><strong>{{ section.settings.subscribe_label }}{% if compare > allocation.price %} <span class="tm-save-pill">{{ compare | minus: allocation.price | times: 100 | divided_by: compare }}% off</span>{% endif %}</strong><span>{{ section.settings.subscribe_note }}</span></span>
            <span class="tm-p">{% if compare > allocation.price %}<s>{{ compare | money_without_trailing_zeros }}</s>{% endif %}{{ allocation.price | money_without_trailing_zeros }}</span>
          </label>
        {%- endfor -%}
        {%- unless product.requires_selling_plan -%}
          <label class="tm-opt">
            <input type="radio" name="selling_plan" value="" data-price="{{ variant.price }}" {% if variant.selling_plan_allocations.size == 0 %}checked{% endif %}>
            <span class="tm-t"><strong>{{ section.settings.onetime_label }}</strong><span>{{ section.settings.onetime_note }}</span></span>
            <span class="tm-p">{{ variant.price | money_without_trailing_zeros }}</span>
          </label>
        {%- endunless -%}
      </fieldset>

      <div class="tm-atc-row">
        <div class="tm-qty" aria-label="Quantity">
          <button type="button" data-q="-1" aria-label="Decrease quantity">−</button>
          <output id="qty">1</output>
          <button type="button" data-q="1" aria-label="Increase quantity">+</button>
        </div>
        <button class="tm-atc" id="atc" type="submit" {% unless variant.available %}disabled{% endunless %}>
          {%- if variant.available -%}{{ section.settings.atc_label }} — <span class="tm-price-now"></span>{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      </div>
      <p class="tm-sr" role="status" aria-live="polite" data-message></p>
    {%- endform -%}

    <p class="tm-ship" id="ship" aria-live="polite"></p>

    {%- if section.settings.formulated != blank -%}<p class="tm-formulated">{{ section.settings.formulated }}</p>{%- endif -%}

    {%- assign checks = section.blocks | where: 'type', 'check' -%}
    {%- if checks.size > 0 -%}
    <ul class="tm-checks">
      {%- for block in checks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
    </ul>
    {%- endif -%}

    <div class="tm-buy-acc">
      {%- if section.settings.ingredients != blank -%}
      <details>
        <summary>{{ section.settings.ingredients_title }}</summary>
        <div class="tm-body tm-inci">{{ section.settings.ingredients }}</div>
        {%- if section.settings.ingredients_link_text != blank -%}<p class="tm-acc-link"><a href="#formula">{{ section.settings.ingredients_link_text }}</a></p>{%- endif -%}
      </details>
      {%- endif -%}
      {%- if section.settings.how_to_use != blank -%}
      <details>
        <summary>{{ section.settings.how_to_use_title }}</summary>
        <div class="tm-body">{{ section.settings.how_to_use }}</div>
      </details>
      {%- endif -%}
      {%- if section.settings.shipping != blank -%}
      <details>
        <summary>{{ section.settings.shipping_title }}</summary>
        <div class="tm-body">{{ section.settings.shipping }}</div>
      </details>
      {%- endif -%}
    </div>

    {%- assign assures = section.blocks | where: 'type', 'assure' -%}
    {%- if assures.size > 0 -%}
    <div class="tm-assure">{%- for block in assures -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{%- endfor -%}</div>
    {%- endif -%}
  </div>

  {%- assign benefits = section.blocks | where: 'type', 'benefit' -%}
  {%- if benefits.size > 0 -%}
  <section class="tm-benefits tm-hero-benefits" aria-labelledby="ben-h-{{ section.id }}">
    {%- if section.settings.benefits_heading != blank -%}<h2 id="ben-h-{{ section.id }}">{{ section.settings.benefits_heading }}</h2>{%- endif -%}
    <ul>
      {%- for block in benefits -%}<li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>{%- endfor -%}
    </ul>
    {%- if section.settings.benefits_note != blank -%}<div class="tm-free">{{ section.settings.benefits_note }}</div>{%- endif -%}
  </section>
  {%- endif -%}
</section>

<div class="tm-sticky" id="sticky" aria-hidden="true">
  <div class="tm-n"><b>{{ section.settings.sticky_name | default: product.title }}</b><span class="tm-price-now"></span><span data-plan-note>{{ section.settings.sticky_plan_note }}</span></div>
  <button class="tm-atc" type="button" data-sticky tabindex="-1">{{ section.settings.atc_label }}</button>
</div>
</prana-tfm>

{% schema %}
{
  "name": "PDP: Hero & buy box",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [
    { "type": "check", "name": "Checklist item", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "assure", "name": "Assurance", "settings": [{ "type": "text", "id": "text", "label": "Text" }] },
    { "type": "benefit", "name": "Benefit", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "settings": [
    { "type": "header", "content": "Product info" },
    { "type": "text", "id": "skin_tag", "label": "Image badge" },
    { "type": "text", "id": "for_text", "label": "Skin type line" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the product title" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "reviews_link_text", "label": "Reviews link (when Loox has no rating yet)", "default": "Read verified customer reviews" },
    { "type": "text", "id": "reviews_count_label", "label": "Label after the Loox review count", "default": "verified reviews" },
    { "type": "text", "id": "tested_text", "label": "Results link" },
    { "type": "text", "id": "proof", "label": "Proof line" },
    { "type": "text", "id": "proof_sub", "label": "Proof source" },
    { "type": "text", "id": "size_text", "label": "Size line" },
    { "type": "header", "content": "Purchase options" },
    { "type": "text", "id": "subscribe_label", "label": "Subscription label", "default": "Subscribe & save" },
    { "type": "text", "id": "subscribe_note", "label": "Subscription note" },
    { "type": "text", "id": "onetime_label", "label": "One-time label", "default": "One-time purchase" },
    { "type": "text", "id": "onetime_note", "label": "One-time note" },
    { "type": "text", "id": "atc_label", "label": "Add to cart button", "default": "Add to cart" },
    { "type": "text", "id": "added_label", "label": "Added message", "default": "Added to cart" },
    { "type": "text", "id": "sticky_name", "label": "Sticky bar name", "info": "Mobile only. Leave empty to use the product title" },
    { "type": "text", "id": "sticky_plan_note", "label": "Sticky bar subscription note" },
    { "type": "header", "content": "Free shipping note" },
    { "type": "number", "id": "free_ship_threshold", "label": "Free shipping threshold", "info": "In the store currency. 0 hides the note", "default": 100 },
    { "type": "text", "id": "free_ship_country", "label": "Show only in country (ISO code)", "default": "US" },
    { "type": "text", "id": "ship_free_text", "label": "Text when the order ships free", "default": "This order ships free." },
    { "type": "html", "id": "ship_away_text", "label": "Text when below the threshold", "info": "[amount] is replaced with the amount left" },
    { "type": "textarea", "id": "formulated", "label": "Formulation text" },
    { "type": "header", "content": "Accordions" },
    { "type": "text", "id": "ingredients_title", "label": "Ingredients title", "default": "Full ingredients" },
    { "type": "html", "id": "ingredients", "label": "Ingredients" },
    { "type": "text", "id": "ingredients_link_text", "label": "Link to the formula table" },
    { "type": "text", "id": "how_to_use_title", "label": "How to use title", "default": "How to use" },
    { "type": "richtext", "id": "how_to_use", "label": "How to use" },
    { "type": "text", "id": "shipping_title", "label": "Shipping title", "default": "Shipping and returns" },
    { "type": "richtext", "id": "shipping", "label": "Shipping and returns" },
    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "benefits_heading", "label": "Heading" },
    { "type": "richtext", "id": "benefits_note", "label": "Footnote" }
  ],
  "presets": [{ "name": "PDP: Hero & buy box" }]
}
{% endschema %}
