<section class="prana-bestseller{% unless section.settings.show_content %} prana-bestseller--image-only{% endunless %}" style="--pb-height:{{ section.settings.height }}px;--pb-overlay:{{ section.settings.overlay | divided_by: 100.0 }};">
{% if section.settings.image != blank %}
  <picture class="prana-bestseller__background">
    {% if section.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{% endif %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy', class: 'prana-bestseller__image' }}
  </picture>
{% endif %}
{% if section.settings.show_content %}
<div class="prana-bestseller__shade"></div>
<div class="section"><div class="prana-bestseller__content">
  <p class="prana-bestseller__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h2 class="prana-bestseller__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
  <p class="prana-bestseller__subtitle">{{ section.settings.subtitle | escape }}</p>
  <div class="prana-bestseller__description">{{ section.settings.description }}</div>
  <div class="prana-bestseller__benefits">
  {% for block in section.blocks %}
    <div class="prana-bestseller__benefit" {{ block.shopify_attributes }}>
      <div class="prana-bestseller__icon">
      {% if block.settings.icon_image != blank %}
        {{ block.settings.icon_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}
      {% else %}
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      {% case block.settings.icon %}
      {% when 'leaf' %}<path d="M7 25C2 12 14 8 26 5c0 15-7 22-17 18M7 27 22 11M12 21l-1-7m6 2 6 1"/>
      {% when 'waves' %}<path d="M3 9q6-5 13 0t13 0M3 16q6-5 13 0t13 0M3 23q6-5 13 0t13 0"/>
      {% when 'drop' %}<path d="M16 3C13 9 6 15 6 21a10 10 0 0 0 20 0c0-6-7-12-10-18Z"/>
      {% when 'flower' %}<path d="M16 27C7 21 9 11 16 4c7 7 9 17 0 23ZM16 27C5 28 2 20 3 13c9 0 13 6 13 14ZM16 27c11 1 14-7 13-14-9 0-13 6-13 14Z"/>
      {% endcase %}
      </svg>
      {% endif %}
      </div>
      <p>{{ block.settings.label | escape | newline_to_br }}</p>
    </div>
  {% endfor %}
  </div>
  {% if section.settings.button_link != blank and section.settings.button_label != blank %}<a class="prana-bestseller__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}<span aria-hidden="true">&#10230;</span></a>{% endif %}
</div></div>
{% elsif section.settings.button_link != blank %}
<a class="prana-bestseller__full-link" href="{{ section.settings.button_link }}" aria-label="{{ section.settings.button_label | default: section.settings.heading | escape }}"></a>
{% endif %}
</section>
{% stylesheet %}
.prana-bestseller { position:relative; isolation:isolate; min-height:var(--pb-height); background:var(--canvas2); color:var(--heading-color); display:grid; align-items:center; }
.prana-bestseller__background,.prana-bestseller__shade { position:absolute; inset:0; z-index:-1; }
.prana-bestseller__image { width:100%; height:100%; object-fit:cover; object-position:center; }
.prana-bestseller__shade { background:linear-gradient(90deg,rgba(248,242,230,var(--pb-overlay)),rgba(248,242,230,0) 65%); }
.prana-bestseller__content { width:44%; padding:48px 0; }
.prana-bestseller .prana-bestseller__eyebrow { display:flex; align-items:center; gap:18px; font:400 12px/1.5 var(--U); letter-spacing:.25em; text-transform:uppercase; margin:0 0 20px; }
.prana-bestseller__eyebrow::before,.prana-bestseller__eyebrow::after { content:''; width:36px; height:1px; background:var(--gold); }
.prana-bestseller .prana-bestseller__heading { font:400 clamp(36px,4.3vw,64px)/.98 var(--D); color:var(--heading-color); margin:0 0 14px; letter-spacing:-.02em; }
.prana-bestseller .prana-bestseller__subtitle { font:400 28px/1.2 var(--D); margin:0 0 14px; }
.prana-bestseller__description,.prana-bestseller__description p { font:400 17px/1.5 var(--S); color:var(--ink3); margin:0; max-width:390px; }
.prana-bestseller__benefits { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; max-width:400px; margin:24px 0; }
.prana-bestseller__benefit { text-align:center; }
.prana-bestseller__icon { border:1px solid currentColor; border-radius:50%; width:44px; height:44px; display:grid; place-items:center; margin:0 auto 8px; }
.prana-bestseller__icon svg,.prana-bestseller__icon img { width:28px; height:28px; object-fit:contain; }
.prana-bestseller__benefit p { font:400 13px/1.2 var(--S); margin:0; color:var(--ink3); }
.prana-bestseller__button { display:inline-flex; align-items:center; justify-content:center; gap:24px; min-width:240px; padding:14px 24px; background:var(--heading-color); color:var(--canvas); font:400 12px/1.4 var(--U); letter-spacing:.18em; text-transform:uppercase; border-radius:2px; }
.prana-bestseller__button:hover { background:var(--gold); }
.prana-bestseller__button:focus-visible,.prana-bestseller__full-link:focus-visible { outline:2px solid var(--gold); outline-offset:4px; }
.prana-bestseller__full-link { position:absolute; inset:0; }
@media(max-width:749px) {
.prana-bestseller { min-height:0; }
.prana-bestseller__background { position:relative; height:320px; grid-row:1; }
.prana-bestseller__image { object-position:right center; }
.prana-bestseller__shade { display:none; }
.prana-bestseller__content { width:100%; padding:28px 0 36px; }
.prana-bestseller .prana-bestseller__heading { font-size:30px; line-height:1.05; }
.prana-bestseller .prana-bestseller__subtitle { font-size:22px; }
.prana-bestseller__description,.prana-bestseller__description p { font-size:15px; }
.prana-bestseller__benefits { gap:8px; }
.prana-bestseller--image-only .prana-bestseller__background { height:auto; }
.prana-bestseller--image-only .prana-bestseller__image { height:auto; object-fit:contain; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "PRANA Bestseller Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop background image",
      "info": "Use an image without text; keep the product on the right."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show text and benefits",
      "default": true,
      "info": "Turn off if your uploaded banner already includes text."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Best seller"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Turmeric &\nSandalwood\nFace Mask"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Brighten. Calm. Restore."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A golden ritual to visibly brighten skin, calm inflammation and reveal a healthy, radiant glow.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop minimum height",
      "min": 400,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Text background overlay",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 65
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "waves",
              "label": "Calm waves"
            },
            {
              "value": "drop",
              "label": "Water drop"
            },
            {
              "value": "flower",
              "label": "Flower"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "textarea",
          "id": "label",
          "label": "Label",
          "default": "Brightens\nDull Skin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PRANA Bestseller Banner",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "leaf",
            "label": "Brightens\nDull Skin"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "waves",
            "label": "Calms\nRedness"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "drop",
            "label": "Purifies\nPores"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "flower",
            "label": "Supports\nRadiant Skin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
