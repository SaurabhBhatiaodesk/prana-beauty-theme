<section
  class="prana-bestseller{% unless section.settings.show_content %} prana-bestseller--image-only{% endunless %}"

  style="
    --pb-height: {{ section.settings.height }}px;

    --pb-mobile-height: {{ section.settings.mobile_height }}px;



    --pb-overlay: {{ section.settings.overlay | divided_by: 100.0 }};
    --pb-mobile-overlay: {{ section.settings.mobile_overlay | divided_by: 100.0 }};







    --pb-bg: {{ section.settings.background_color }};



    --pb-eyebrow-color: {{ section.settings.eyebrow_color }};



    --pb-heading-color: {{ section.settings.heading_color }};



    --pb-subtitle-color: {{ section.settings.subtitle_color }};



    --pb-description-color: {{ section.settings.description_color }};



    --pb-benefit-color: {{ section.settings.benefit_color }};



    --pb-icon-color: {{ section.settings.icon_color }};



    --pb-button-bg: {{ section.settings.button_background }};



    --pb-button-text: {{ section.settings.button_text_color }};



    --pb-button-hover-bg: {{ section.settings.button_hover_background }};



    --pb-button-hover-text: {{ section.settings.button_hover_text_color }};







    --pb-eyebrow-size-desktop: {{ section.settings.eyebrow_size_desktop }}px;



    --pb-heading-size-desktop: {{ section.settings.heading_size_desktop }}px;



    --pb-subtitle-size-desktop: {{ section.settings.subtitle_size_desktop }}px;



    --pb-description-size-desktop: {{ section.settings.description_size_desktop }}px;



    --pb-benefit-size-desktop: {{ section.settings.benefit_size_desktop }}px;



    --pb-button-size-desktop: {{ section.settings.button_size_desktop }}px;







    --pb-eyebrow-size-mobile: {{ section.settings.eyebrow_size_mobile }}px;



    --pb-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;



    --pb-subtitle-size-mobile: {{ section.settings.subtitle_size_mobile }}px;



    --pb-description-size-mobile: {{ section.settings.description_size_mobile }}px;



    --pb-benefit-size-mobile: {{ section.settings.benefit_size_mobile }}px;



    --pb-button-size-mobile: {{ section.settings.button_size_mobile }}px;
  "
>
  {% if section.settings.image != blank %}
    <picture class="prana-bestseller__background">
      {% if section.settings.mobile_image != blank %}
        <source
          media="(max-width:749px)"

          srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
        >
      {% endif %}

      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy',
          class: 'prana-bestseller__image'
      }}
    </picture>
  {% endif %}

  {% if section.settings.show_content %}
    <div class="prana-bestseller__shade"></div>

    <div class="section">
      <div class="prana-bestseller__content">
        {% if section.settings.eyebrow != blank %}
          <p class="prana-bestseller__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="prana-bestseller__heading">
            {{ section.settings.heading | escape | newline_to_br }}
          </h2>
        {% endif %}

        {% if section.settings.subtitle != blank %}
          <p class="prana-bestseller__subtitle">
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="prana-bestseller__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="prana-bestseller__benefits">
            {% for block in section.blocks %}
              <div class="prana-bestseller__benefit" {{ block.shopify_attributes }}>
                <div class="prana-bestseller__icon">
                  {% if block.settings.icon_image != blank %}
                    {{ block.settings.icon_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: '' }}

                  {% else %}
                    <svg
                      viewBox="0 0 32 32"

                      fill="none"

                      stroke="currentColor"

                      stroke-width="1.2"

                      aria-hidden="true"
                    >
                      {% case block.settings.icon %}



                        {% when 'leaf' %}



                          <path d="M7 25C2 12 14 8 26 5c0 15-7 22-17 18M7 27 22 11M12 21l-1-7m6 2 6 1"/>



                        {% when 'waves' %}



                          <path d="M3 9q6-5 13 0t13 0M3 16q6-5 13 0t13 0M3 23q6-5 13 0t13 0"/>



                        {% when 'drop' %}



                          <path d="M16 3C13 9 6 15 6 21a10 10 0 0 0 20 0c0-6-7-12-10-18Z"/>



                        {% when 'flower' %}



                          <path d="M16 27C7 21 9 11 16 4c7 7 9 17 0 23ZM16 27C5 28 2 20 3 13c9 0 13 6 13 14ZM16 27c11 1 14-7 13-14-9 0-13 6-13 14Z"/>



                      {% endcase %}
                    </svg>
                  {% endif %}
                </div>

                <p>{{ block.settings.label | escape | newline_to_br }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if section.settings.button_link != blank and section.settings.button_label != blank %}
          <a
            class="prana-bestseller__button"

            href="{{ section.settings.button_link }}"
          >
            {{ section.settings.button_label | escape }}

            <span aria-hidden="true">&#10230;</span>
          </a>
        {% endif %}
      </div>
    </div>

  {% elsif section.settings.button_link != blank %}
    <a
      class="prana-bestseller__full-link"

      href="{{ section.settings.button_link }}"

      aria-label="{{ section.settings.button_label | default: section.settings.heading | escape }}"
    ></a>
  {% endif %}
</section>

{% stylesheet %}
  .prana-bestseller {



    position: relative;



    isolation: isolate;



    min-height: var(--pb-height);



    background: var(--pb-bg);



    color: var(--pb-heading-color);



    display: grid;



    align-items: center;



  }







  .prana-bestseller__background,



  .prana-bestseller__shade {



    position: absolute;



    inset: 0;



    z-index: -1;



  }







  .prana-bestseller__image {



    width: 100%;



    height: 100%;



    object-fit: cover;



    object-position: center;



  }







  .prana-bestseller__shade {



    background: linear-gradient(



      90deg,



      rgba(248, 242, 230, var(--pb-overlay)),



      rgba(248, 242, 230, 0) 65%



    );



  }







  .prana-bestseller__content {



    width: 44%;



    padding: 48px 0;



  }







  .prana-bestseller .prana-bestseller__eyebrow {



    display: flex;



    align-items: center;



    gap: 18px;



    margin: 0 0 20px;



    color: var(--pb-eyebrow-color);



    font: 400 var(--pb-eyebrow-size-desktop)/1.5 var(--U);



    letter-spacing: .25em;



    text-transform: uppercase;



  }







  .prana-bestseller__eyebrow::before,



  .prana-bestseller__eyebrow::after {



    content: '';



    width: 36px;



    height: 1px;



    background: var(--pb-eyebrow-color);



  }







  .prana-bestseller .prana-bestseller__heading {



    margin: 0 0 14px;



    color: var(--pb-heading-color);



    font: 400 var(--pb-heading-size-desktop)/.98 var(--D);



    letter-spacing: -.02em;



  }







  .prana-bestseller .prana-bestseller__subtitle {



    margin: 0 0 14px;



    color: var(--pb-subtitle-color);



    font: 400 var(--pb-subtitle-size-desktop)/1.2 var(--D);



  }







  .prana-bestseller__description,



  .prana-bestseller__description p {



    max-width: 390px;



    margin: 0;



    color: var(--pb-description-color);



    font: 400 var(--pb-description-size-desktop)/1.5 var(--S);



  }







  .prana-bestseller__benefits {



    display: grid;



    grid-template-columns: repeat(4, minmax(0, 1fr));



    gap: 12px;



    max-width: 400px;



    margin: 24px 0;



  }







  .prana-bestseller__benefit {



    text-align: center;



    color: var(--pb-benefit-color);



  }







  .prana-bestseller__icon {



    width: 44px;



    height: 44px;



    display: grid;



    place-items: center;



    margin: 0 auto 8px;



    border: 1px solid var(--pb-icon-color);



    border-radius: 50%;



    color: var(--pb-icon-color);



  }







  .prana-bestseller__icon svg,



  .prana-bestseller__icon img {



    width: 28px;



    height: 28px;



    object-fit: contain;



  }







  .prana-bestseller__benefit p {



    margin: 0;



    color: var(--pb-benefit-color);



    font: 400 var(--pb-benefit-size-desktop)/1.2 var(--S);



  }







  .prana-bestseller__button {



    display: inline-flex;



    align-items: center;



    justify-content: center;



    gap: 24px;



    min-width: 240px;



    padding: 14px 24px;



    border-radius: 2px;



    background: var(--pb-button-bg);



    color: var(--pb-button-text);



    font: 400 var(--pb-button-size-desktop)/1.4 var(--U);



    letter-spacing: .18em;



    text-transform: uppercase;



    transition: background .2s ease, color .2s ease;



  }







  .prana-bestseller__button:hover {



    background: var(--pb-button-hover-bg);



    color: var(--pb-button-hover-text);



  }







  .prana-bestseller__button:focus-visible,



  .prana-bestseller__full-link:focus-visible {



    outline: 2px solid var(--pb-button-hover-bg);



    outline-offset: 4px;



  }







  .prana-bestseller__full-link {



    position: absolute;



    inset: 0;



  }







  @media (max-width: 749px) {

    .prana-bestseller {

      min-height: var(--pb-mobile-height);

      display: grid;

      align-items: center;

      overflow: hidden;

    }



    .prana-bestseller__background {

      position: absolute;

      inset: 0;

      width: 100%;

      height: 100%;

      z-index: -2;

    }



    .prana-bestseller__image {

      width: 100%;

      height: 100%;

      object-fit: cover;

      object-position: center;

    }



    .prana-bestseller__shade {
    display: block;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(248, 242, 230, var(--pb-mobile-overlay)) 0%,
      rgba(248, 242, 230, calc(var(--pb-mobile-overlay) * 0.82)) 55%,
      rgba(248, 242, 230, var(--pb-mobile-overlay)) 100%
    );

    }



    .prana-bestseller__content {

      width: 100%;

      padding: 42px 0;

    }



    .prana-bestseller .prana-bestseller__eyebrow {

      font-size: var(--pb-eyebrow-size-mobile);

    }



    .prana-bestseller .prana-bestseller__heading {

      font-size: var(--pb-heading-size-mobile);

      line-height: 1.05;

    }



    .prana-bestseller .prana-bestseller__subtitle {

      font-size: var(--pb-subtitle-size-mobile);

    }



    .prana-bestseller__description,

    .prana-bestseller__description p {

      font-size: var(--pb-description-size-mobile);

    }



    .prana-bestseller__benefits {

      gap: 8px;

    }



    .prana-bestseller__benefit p {

      font-size: var(--pb-benefit-size-mobile);

    }



    .prana-bestseller__button {

      font-size: var(--pb-button-size-mobile);

    }



    .prana-bestseller--image-only {

      min-height: var(--pb-mobile-height);

    }



    .prana-bestseller--image-only .prana-bestseller__background {

      position: absolute;

      inset: 0;

      height: 100%;

    }



    .prana-bestseller--image-only .prana-bestseller__image {

      width: 100%;

      height: 100%;

      object-fit: cover;

    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "PRANA Bestseller Banner",

  "settings": [
    {
      "type": "image_picker",

      "id": "image",

      "label": "Desktop background image",

      "info": "Use an image without text; keep the product on the right."
    },

    {
      "type": "image_picker",

      "id": "mobile_image",

      "label": "Mobile background image"
    },

    {
      "type": "checkbox",

      "id": "show_content",

      "label": "Show text and benefits",

      "default": true,

      "info": "Turn off if your uploaded banner already includes text."
    },

    {
      "type": "text",

      "id": "eyebrow",

      "label": "Eyebrow",

      "default": "Best seller"
    },

    {
      "type": "textarea",

      "id": "heading",

      "label": "Heading",

      "default": "Turmeric &\nSandalwood\nFace Mask"
    },

    {
      "type": "text",

      "id": "subtitle",

      "label": "Subtitle",

      "default": "Brighten. Calm. Restore."
    },

    {
      "type": "richtext",

      "id": "description",

      "label": "Description",

      "default": "<p>A golden ritual to visibly brighten skin, calm inflammation and reveal a healthy, radiant glow.</p>"
    },

    {
      "type": "text",

      "id": "button_label",

      "label": "Button label",

      "default": "Shop now"
    },

    {
      "type": "url",

      "id": "button_link",

      "label": "Button link"
    },

    {
      "type": "header",

      "content": "Colors"
    },

    {
      "type": "color",

      "id": "background_color",

      "label": "Section background",

      "default": "#F8F2E6"
    },

    {
      "type": "color",

      "id": "eyebrow_color",

      "label": "Eyebrow color",

      "default": "#A4773D"
    },

    {
      "type": "color",

      "id": "heading_color",

      "label": "Heading color",

      "default": "#2E2925"
    },

    {
      "type": "color",

      "id": "subtitle_color",

      "label": "Subtitle color",

      "default": "#2E2925"
    },

    {
      "type": "color",

      "id": "description_color",

      "label": "Description color",

      "default": "#5C554F"
    },

    {
      "type": "color",

      "id": "benefit_color",

      "label": "Benefit text color",

      "default": "#5C554F"
    },

    {
      "type": "color",

      "id": "icon_color",

      "label": "Benefit icon color",

      "default": "#A4773D"
    },

    {
      "type": "color",

      "id": "button_background",

      "label": "Button background",

      "default": "#2E2925"
    },

    {
      "type": "color",

      "id": "button_text_color",

