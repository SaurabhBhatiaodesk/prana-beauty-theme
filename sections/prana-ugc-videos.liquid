{% assign video_count = 0 %}

{% assign desktop_gap_total = section.settings.desktop_videos | minus: 1 | times: 20 %}

{% assign desktop_width_total = section.settings.desktop_videos | times: 300 | plus: desktop_gap_total %}

{% for block in section.blocks %}
  {% if block.settings.video_file != blank %}
    {% assign video_count = video_count | plus: 1 %}
  {% endif %}
{% endfor %}

{% if video_count > 0 or request.design_mode %}
  <section
    class="prana-ugc"

    style="
      background: {{ section.settings.background_color }} !important;

      --ugc-desktop-count: {{ section.settings.desktop_videos }};



      --ugc-mobile-count: {{ section.settings.mobile_videos }};



      --ugc-desktop-max: {{ desktop_width_total }}px;

      --ugc-bg: {{ section.settings.background_color }};

      --ugc-eyebrow: {{ section.settings.eyebrow_color }};

      --ugc-line: {{ section.settings.eyebrow_line_color }};

      --ugc-heading: {{ section.settings.heading_color }};

      --ugc-text: {{ section.settings.text_color }};

      --ugc-card-bg: {{ section.settings.card_background_color }};

      --ugc-card-border: {{ section.settings.card_border_color }};

      --ugc-video-bg: {{ section.settings.video_background_color }};

      --ugc-placeholder-text: {{ section.settings.placeholder_text_color }};

      --ugc-nav-bg: {{ section.settings.nav_button_background_color }};

      --ugc-nav-border: {{ section.settings.nav_button_border_color }};

      --ugc-nav-icon: {{ section.settings.nav_button_icon_color }};

      --ugc-scrollbar-thumb: {{ section.settings.scrollbar_thumb_color }};

      --ugc-scrollbar-track: {{ section.settings.scrollbar_track_color }};
    "
  >
    <div class="section">
      <div class="prana-ugc__inner">
        <div class="prana-ugc__header">
          {% if section.settings.eyebrow != blank %}
            <p class="prana-ugc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h2 class="prana-ugc__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <div class="prana-ugc__intro">{{ section.settings.subheading }}</div>
          {% endif %}
        </div>

        <prana-ugc-videos
          data-autoplay="{{ section.settings.autoplay }}"
          data-slider-autoplay="{{ section.settings.slider_autoplay }}"
          data-slider-speed="{{ section.settings.slider_autoplay_speed }}"
          data-desktop-videos="{{ section.settings.desktop_videos }}"
          data-mobile-videos="{{ section.settings.mobile_videos }}"
        >
          <div
            class="swiper prana-ugc__swiper"
            id="UgcSwiper-{{ section.id }}"
            role="region"
            aria-label="{{ section.settings.heading | escape }}"
          >
            <div class="swiper-wrapper">
              {% for block in section.blocks %}
                {% if block.settings.video_file != blank or request.design_mode %}
                  <article class="swiper-slide prana-ugc__card" {{ block.shopify_attributes }}>
                    {% if block.settings.video_file != blank %}
                      {% assign video_poster = block.settings.video_file.preview_image | image_url: width: 700 %}

                      {{
                        block.settings.video_file
                        | video_tag:
                          autoplay: section.settings.autoplay,
                          loop: true,
                          muted: true,
                          controls: false,
                          playsinline: true,
                          preload: 'auto',
                          poster: video_poster,
                          class: 'prana-ugc__video'
                      }}

                    {% else %}
                      <div class="prana-ugc__placeholder">Select a video in this block.</div>
                    {% endif %}
                  </article>
                {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="prana-ugc__navigation">
            <button
              type="button"
              class="prana-ugc__prev"
              aria-label="Previous videos"
              aria-controls="UgcSwiper-{{ section.id }}"
            >
              &#8592;
            </button>

            <button
              type="button"
              class="prana-ugc__next"
              aria-label="Next videos"
              aria-controls="UgcSwiper-{{ section.id }}"
            >
              &#8594;
            </button>
          </div>
        </prana-ugc-videos>
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .prana-ugc {
    padding: 60px 0;
    background: var(--ugc-bg);
    color: var(--ugc-text);
    font-family: var(--U);
    position: relative;
    z-index: 1;
  }
  .prana-ugc > .section {
    background: transparent !important;
  }
  .prana-ugc__inner {
    width: 100%;
    min-width: 0;
  }
  .prana-ugc__header {
    max-width: 700px;
    margin: 0 auto 32px;
    text-align: center;
  }
  .prana-ugc .prana-ugc__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 0 0 12px;
    color: var(--ugc-eyebrow) !important;
    font: 400 14px/1.5 var(--U);
  }
  .prana-ugc__eyebrow::before,
  .prana-ugc__eyebrow::after {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--ugc-line);
  }
  .prana-ugc .prana-ugc__heading {
    margin: 0 0 12px;
    color: var(--ugc-heading) !important;
    font: 400 38px/1.15 var(--D);
  }

  .prana-ugc__intro,
  .prana-ugc__intro p {
    margin: 0;
    color: var(--ugc-text) !important;
    font: 400 17px/1.5 var(--U);
  }

  prana-ugc-videos {
    display: block;
  }
  .prana-ugc__swiper {
    width: 100%;
    max-width: min(100%, var(--ugc-desktop-max));
    margin: 0 auto;
    overflow: hidden;
  }
  .prana-ugc__card {
    max-width: none;
  }
  .prana-ugc__video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    object-position: center;
    background: var(--ugc-video-bg);
  }
  .prana-ugc__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 9 / 16;
    padding: 24px;
    color: var(--ugc-placeholder-text);
    text-align: center;
  }
  .prana-ugc__navigation {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }
  .prana-ugc__navigation button {
    width: 44px;
    height: 44px;
    border: 1px solid var(--ugc-nav-border) !important;
    border-radius: 50%;
    background: var(--ugc-nav-bg) !important;
    color: var(--ugc-nav-icon) !important;
    font-size: 24px;
    cursor: pointer;
  }
  .prana-ugc__navigation button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .prana-ugc__navigation button:focus-visible,
  .prana-ugc__swiper:focus-visible {
    outline: 2px solid var(--ugc-nav-border);
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .prana-ugc {
      padding: 40px 0;
    }
    .prana-ugc .prana-ugc__heading {
      font-size: 24px;
    }
    .prana-ugc__intro,
    .prana-ugc__intro p {
      font-size: 15px;
    }
    .prana-ugc__header {
      margin-bottom: 24px;
    }
    .prana-ugc__swiper {
      max-width: 100%;
      margin: 0 auto;
    }
    .prana-ugc__card {
      flex: 0 0 calc((100% - ((var(--ugc-mobile-count) - 1) * 14px))/ var(--ugc-mobile-count));
      max-width: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const SWIPER_CSS = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
    const SWIPER_JS = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';

    function loadSwiperAssets() {
      if (!document.querySelector('link[data-prana-swiper-css]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = SWIPER_CSS;
        link.setAttribute('data-prana-swiper-css', '');
        document.head.appendChild(link);
      }

      if (window.Swiper) return Promise.resolve();

      if (window.__pranaSwiperPromise) return window.__pranaSwiperPromise;

      window.__pranaSwiperPromise = new Promise((resolve, reject) => {
        const existing = document.querySelector('script[data-prana-swiper-js]');

        if (existing) {
          existing.addEventListener('load', resolve, { once: true });
          existing.addEventListener('error', reject, { once: true });
          return;
        }

        const script = document.createElement('script');
        script.src = SWIPER_JS;
        script.defer = true;
        script.setAttribute('data-prana-swiper-js', '');
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });

      return window.__pranaSwiperPromise;
    }

    if (!customElements.get('prana-ugc-videos')) {
      customElements.define(
        'prana-ugc-videos',
        class extends HTMLElement {
          connectedCallback() {
            this.controller = new AbortController();
            const signal = this.controller.signal;

            this.autoplayVideos = this.dataset.autoplay === 'true';
            this.sliderAutoplay = this.dataset.sliderAutoplay === 'true';
            this.sliderSpeed = Math.max(1000, Number(this.dataset.sliderSpeed || 3000));
            this.desktopVideos = Math.max(1, Number(this.dataset.desktopVideos || 4));
            this.mobileVideos = Math.max(1, Number(this.dataset.mobileVideos || 1));

            this.querySelectorAll('video').forEach((video) => {
              video.muted = true;
              video.loop = true;
              video.playsInline = true;
            });

            this.setupVideoAutoplay();
            this.initSwiper();

            this.addEventListener(
              'shopify:block:select',
              (event) => {
                const slide = event.target.closest('.swiper-slide');
                if (!slide || !this.swiper) return;

                const index = Array.from(this.querySelectorAll('.swiper-slide')).indexOf(slide);
                if (index >= 0) this.swiper.slideTo(index);
              },
              { signal }
            );
          }

          async initSwiper() {
            try {
              await loadSwiperAssets();

              if (!this.isConnected || this.swiper) return;

              const swiperEl = this.querySelector('.prana-ugc__swiper');
              const prevEl = this.querySelector('.prana-ugc__prev');
              const nextEl = this.querySelector('.prana-ugc__next');

              if (!swiperEl) return;

              const slideCount = swiperEl.querySelectorAll('.swiper-slide').length;

              this.swiper = new window.Swiper(swiperEl, {
                slidesPerView: this.mobileVideos,
                spaceBetween: 14,
                speed: 600,
                grabCursor: true,
                watchOverflow: true,
                loop: true,
                observer: true,
                observeParents: true,
                navigation: {
                  prevEl,
                  nextEl,
                },
                autoplay:
                  this.sliderAutoplay && slideCount > 1
                    ? {
                        delay: this.sliderSpeed,
                        disableOnInteraction: false,
                        pauseOnMouseEnter: true,
                      }
                    : false,
                breakpoints: {
                  750: {
                    slidesPerView: this.desktopVideos,
                    spaceBetween: 20,
                  },
                },
              });
            } catch (error) {
              console.error('PRANA UGC Swiper failed to load:', error);
            }
          }

          setupVideoAutoplay() {
            if (!this.autoplayVideos) return;

            if ('IntersectionObserver' in window) {
              this.visibilityObserver = new IntersectionObserver(
                (entries) => {
                  entries.forEach((entry) => {
                    const video = entry.target;

                    if (!entry.isIntersecting || entry.intersectionRatio < 0.25) {
                      video.pause();
                      return;
                    }

                    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                      video.muted = true;
                      video.play().catch(() => {});
                    }
                  });
                },
                { threshold: [0, 0.25] }
              );

              this.querySelectorAll('video').forEach((video) => {
                this.visibilityObserver.observe(video);
              });
            } else {
              this.querySelectorAll('video').forEach((video) => {
                video.play().catch(() => {});
              });
            }
          }

          disconnectedCallback() {
            this.controller?.abort();
            this.visibilityObserver?.disconnect();
            this.swiper?.destroy(true, true);

            this.querySelectorAll('video').forEach((video) => {
              video.pause();
            });
          }
        }
      );
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "PRANA UGC Videos",

  "max_blocks": 50,

  "settings": [
    {
      "type": "text",

      "id": "eyebrow",

      "label": "Eyebrow",

      "default": "The PRANA community"
    },

    {
      "type": "text",

      "id": "heading",

      "label": "Heading",

      "default": "Real rituals. Real stories."
    },

    {
      "type": "richtext",

      "id": "subheading",

      "label": "Description",

      "default": "<p>Discover PRANA through the rituals of our community.</p>"
    },

    {
      "type": "header",

      "content": "Colors"
    },

    {
      "type": "color",

      "id": "background_color",

      "label": "Section background",

      "default": "#F7F3EE"
    },

    {
      "type": "color",

      "id": "eyebrow_color",

      "label": "Eyebrow text",

      "default": "#A4773D"
    },

    {
      "type": "color",

      "id": "eyebrow_line_color",

      "label": "Eyebrow line",

      "default": "#C9B28F"
    },

    {
      "type": "color",

      "id": "heading_color",

      "label": "Heading",

      "default": "#2E2925"
    },

    {
      "type": "color",

      "id": "text_color",

      "label": "Description text",

      "default": "#5C554F"
    },

    {
      "type": "color",

      "id": "card_background_color",

      "label": "Video card background",

      "default": "#FFFFFF"
    },

    {
      "type": "color",

      "id": "card_border_color",

      "label": "Video card border",

      "default": "#DED5CA"
    },

    {
      "type": "color",

      "id": "video_background_color",

      "label": "Video background",

      "default": "#111111"
    },

    {
      "type": "color",

      "id": "placeholder_text_color",

      "label": "Placeholder text",

      "default": "#5C554F"
    },

    {
      "type": "color",

      "id": "nav_button_background_color",

      "label": "Arrow button background",

      "default": "#FFFFFF"
    },

    {
      "type": "color",

      "id": "nav_button_border_color",

      "label": "Arrow button border",

      "default": "#A4773D"
    },

    {
      "type": "color",

      "id": "nav_button_icon_color",

      "label": "Arrow icon",

      "default": "#2E2925"
    },

    {
      "type": "color",

      "id": "scrollbar_thumb_color",

      "label": "Scrollbar",

      "default": "#A4773D"
    },

    {
      "type": "color",

      "id": "scrollbar_track_color",

      "label": "Scrollbar track",

      "default": "#EDE6DD"
    },

    {
      "type": "header",

      "content": "Layout & autoplay"
    },

    {
      "type": "range",

      "id": "desktop_videos",

      "label": "Videos visible on desktop",

      "min": 2,

      "max": 6,

      "step": 1,

      "default": 4
    },

    {
      "type": "select",

      "id": "mobile_videos",

      "label": "Videos visible on mobile",

      "options": [
        {
          "value": "1",

          "label": "1"
        },

        {
          "value": "2",

          "label": "2"
        }
      ],

      "default": "1"
    },

    {
      "type": "checkbox",

      "id": "autoplay",

      "label": "Autoplay videos",

      "default": true,

      "info": "When enabled, all visible videos autoplay muted and loop continuously."
    },

    {
      "type": "checkbox",

      "id": "slider_autoplay",

      "label": "Autoplay slider",

      "default": true
    },

    {
      "type": "range",

      "id": "slider_autoplay_speed",

      "label": "Slider autoplay speed",

      "min": 2000,

      "max": 8000,

      "step": 500,

      "unit": "ms",

      "default": 3000
    }
  ],

  "blocks": [
    {
      "type": "video_item",

      "name": "UGC video",

      "settings": [
        {
          "type": "video",

          "id": "video_file",

          "label": "Video"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "PRANA UGC Videos",

      "blocks": [{ "type": "video_item" }, { "type": "video_item" }, { "type": "video_item" }]
    }
  ]
}
{% endschema %}
