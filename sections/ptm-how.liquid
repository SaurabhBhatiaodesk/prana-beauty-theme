{%- render 'ptm-assets' -%}
<div class="ptm">
<section class="tm-sec" aria-labelledby="how-h-{{ section.id }}">
  <div class="tm-wrap">
    {%- if section.settings.heading != blank -%}<h2 id="how-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="tm-intro">{{ section.settings.intro }}</p>{%- endif -%}
    <div class="tm-how">
      {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><b>{{ block.settings.number | default: forloop.index }}</b><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{%- endfor -%}
    </div>
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: How to use",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [{ "type": "how_step", "name": "Step", "settings": [
    { "type": "text", "id": "number", "label": "Number", "info": "Leave empty to number automatically" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ] }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" }
  ],
  "presets": [{ "name": "PDP: How to use" }]
}
{% endschema %}
