{%- render 'ptm-assets' -%}
{%- liquid
  assign set_product = section.settings.product
  assign price_now = section.settings.price_text
  assign price_was = section.settings.compare_text
  if set_product != blank
    assign price_now = set_product.price | money_without_trailing_zeros
    if set_product.compare_at_price > set_product.price
      assign price_was = set_product.compare_at_price | money_without_trailing_zeros
    else
      assign price_was = ''
    endif
  endif
  assign set_url = section.settings.button_url | default: set_product.url
-%}
<div class="ptm">
<section class="tm-wrap tm-set-wrap" aria-labelledby="set-h-{{ section.id }}">
  <div class="tm-set">
    <div>
      {%- if section.settings.heading != blank -%}<h2 id="set-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div>
      <div class="tm-price">{% if price_was != blank %}<s>{{ price_was }}</s>{% endif %}{{ price_now }}</div>
      {%- if section.settings.button_text != blank -%}<a class="tm-btn" href="{{ set_url }}">{{ section.settings.button_text }}</a>{%- endif -%}
    </div>
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: Ritual set",
  "tag": "section",
  "class": "section-ptm",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "product", "id": "product", "label": "Set product", "info": "When chosen, price and link come from this product" },
    { "type": "text", "id": "compare_text", "label": "Compare-at price text", "info": "Used when no product is chosen" },
    { "type": "text", "id": "price_text", "label": "Price text", "info": "Used when no product is chosen" },
    { "type": "text", "id": "button_text", "label": "Button text" },
    { "type": "url", "id": "button_url", "label": "Button link", "info": "Leave empty to link to the chosen product" }
  ],
  "presets": [{ "name": "PDP: Ritual set" }]
}
{% endschema %}
