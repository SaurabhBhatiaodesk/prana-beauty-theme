
<style>
    .list-select-btns{
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 14px;
        margin: 0 auto 24px;
        padding: 0 20px;
        flex-wrap:wrap;
    }
    .select-collection-shows{
        background: #F1E2DE;
        border: 1.16px solid #443531;
        padding: 12px 21px;
        list-style: none;
        cursor: pointer;
        width: max-content;
        border-radius: 40px;
        max-height: 35px;
        text-align: center;
        font-family: Josefin Sans;
        font-weight: 600;
        font-size: 14.08px;
        line-height: 1;
        letter-spacing: -0.04rem;
        text-transform: uppercase;
    }
.product-slide-algin-header{
    max-width:482px;
    margin-inline:auto;
    margin-bottom:27px;
}
.title-slides{
    font-family: Josefin Sans;
    font-weight: 400;
    font-size: 25.51px;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    color:#4E403C;
    text-align:center;

}
.content-slides{
    font-family: Josefin Sans;
    font-weight: 300;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: -0.04rem;
    margin: 6px auto 0;
    text-align: center;
}


.product-list-slider-{{ section.id }}{ 
    padding:50px 23px;
 }

.pls-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  padding: 0 16px;
  margin-top: 25px;
}
.pls-header div {
    display: flex;
    align-items: center;
}
.pls-des {
    margin: 0 0 0 15px;
    font-family: 'Josefin Sans';
    color: #4E403C;
    font-size: 21px;
    font-weight: 300;
}
.pls-title {
    font-family: 'Josefin Sans';
    letter-spacing: 1px !important;
    margin: 0;
    color: #4E403C;
    font-size: 25px;
}

.pls-button {
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  text-transform: uppercase;
  line-height: 14px;
  padding: 18px 37px;
  background: #ECCA6F;
  font-family: 'Josefin Sans';
  color: #1B1716;
}
.pls-button svg {
  margin-right: 8px;
}

.pls-image {
  width: 100%;
  aspect-ratio: 1/1;
  overflow: hidden;
  height: 300px;
}

.pls-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
}
.pls-prod-title {
    text-align: center;
    margin: 10px 0;
    font-weight: 400;
    font-size: 19px;
    font-family: 'Josefin Sans';
    color: #4E403C;
    text-transform: uppercase;
    height: 45px;
     letter-spacing: -1px;
}

.pls-price {
  text-align: center;
  font-size: 18px;
  margin: 0;
  font-weight: 400;
  font-family: 'Josefin Sans';
  color: #4E403C;
  text-transform: uppercase;
}

.pls-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 40px;
}

.swiper-scrollbar { background: #ddd; height: 4px; width: 85%; position: relative !important;}
.swiper-scrollbar-drag { background: #97371E; }

.custom-arrows {
  display: flex;
  gap: 20px;
  align-items: center;
}
.custom-arrow {
  cursor: pointer;
  font-size: 26px;
  user-select: none;
}
.product-list-slider .swiper-slide {
    background: #FDFCFB;
    padding: 15px;
}
.product-list-slider .pls-add-btn {
    background: #F4F1EA;
    border: none;
    font-size: 14px;
    font-weight: 700;
    font-family: 'Josefin Sans';
    display: flex;
    max-width: 100%;
    width: 100%;
    color: #1B1716;
    text-transform: uppercase;
    padding: 16px;
    margin-top: 15px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:.2s linear;
}
.product-list-slider .pls-add-btn svg {
    margin-right: 8px;
}
.svg{
    text-align: center;
    margin: 10px auto 15px;
    display: flex;
}

.select-collection-shows.active {
    background: #F5E5BC;
    color: #000;
}
.product-list-swiper-{{ section.id }}{
    max-width:1347px;
    margin-inline:auto;
}
.product-list-swiper-{{ section.id }} .swiper-slide{
    width:441px !important;
    background:#FAF8F4 !important;
    position:relative;
}
.custom-bnundle-tag,
.save-related-bedge{
  position:absolute;
}
.custom-bnundle-tag{
    font-family: Josefin Sans;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 11.12px;
    padding: 8px 12px;
    line-height: 1;
    letter-spacing: -0.04rem;
    border-radius: 20px;
    background: #fff;
    border: 1px solid #000;
    color: #443531;
    left: 22px;
    top: 17px;
    margin: 0;
}
.save-related-bedge{
    width: 66px;
    height: 66px;
    top: 15.09px;
    right: 32px;
    background: #F4E3B8;
    border: 1px solid #443531;
    border-radius: 50%;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: Josefin Sans;
    font-weight: 400;
    font-size: 15.04px;
    line-height: 1.1;
    letter-spacing: 0;
    color: #443531;
    margin: 0;
    padding: 4px;
  }


@media screen and (max-width: 767px) {
  .pls-button {
    display: none;
  }
  .pls-header div {
    align-items: baseline;
    flex-direction: column;
  }
  .pls-prod-title {
      font-size: 14px;
      height: 34px;
  }
  .pls-price {
      font-size: 14px;
  }
  .product-list-swiper-{{ section.id }} .swiper-slide{
      width:358px !important;
  }
  .custom-bnundle-tag {
    font-size: 9px;
    padding: 7px 10px;
    left: 18px;
    top: 14px;
  }
  .save-related-bedge {
    width: 54px;
    height: 54px;
    top: 12px;
    right: 26px;
    font-size: 12px;
  }

  .list-select-btns {
      gap: 12px;
      padding: 0;
  }
  .select-collection-shows {
      padding: 9px 15px;
      max-height: 30px;
      font-weight: 500;
      font-size: 12px;
  }
  .product-list-slider-{{ section.id }} .pls-controls {
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 24px;
      margin-top: 27px;
  }
  .product-list-slider-{{ section.id }} .swiper-pagination{
    width:100% !important;
  }
}

</style>


<section class="product-list-slider product-list-slider-{{ section.id }}">
    <div class="product-slide-algin-header">
      <h2 class="title-slides">{{ section.settings.main_heading }}</h2>
      <p class="content-slides">{{ section.settings.subtext }}</p>
