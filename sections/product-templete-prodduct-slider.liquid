                    </svg>
                </div>
                <div class="custom-arrow custom-next">
                    <svg width="39" height="20" viewBox="0 0 39 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M38.7292 9.17002L29.8689 0.30972C29.5506 -0.0618701 28.9909 -0.105273 28.6193 0.213015C28.2477 0.531304 28.2043 1.09097 28.5226 1.46256C28.5523 1.49759 28.5843 1.52957 28.6193 1.55927L35.9643 8.91341H0.886335C0.396718 8.91341 0 9.31013 0 9.79974C0 10.2894 0.396718 10.6861 0.886335 10.6861H35.9651L28.6201 18.0311C28.2485 18.3494 28.2051 18.909 28.5234 19.2806C28.8417 19.6522 29.4013 19.6956 29.7729 19.3773C29.8072 19.3476 29.8399 19.3157 29.8696 19.2806L38.7299 10.4203C39.0733 10.0746 39.0733 9.51648 38.7299 9.17078L38.7292 9.17002Z" fill="#443531"/>
                    </svg>
                </div>
            </div>
            </div>
        </div>
    {% endfor %}

</section>



{% schema %}
{
  "name": "collection Product Slider",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "bundle_text",
      "label": "Bundle Text",
      "default": "CUSTOM BUNDLE"
    },
    {
      "type": "text",
      "id": "save_text",
      "label": "Save text",
      "default": "Save BIG"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Select Collection"
    }
  ],
  "presets": [
    { "name": "collection Product Slider" }
  ]
}
{% endschema %}




<script>
document.addEventListener("DOMContentLoaded", () => {
  const sliders = document.querySelectorAll(".product-list-swiper-{{ section.id }}");

  sliders.forEach(slider => {
    new Swiper(slider, {
      spaceBetween: 11,
      slidesPerView: 'auto',
      centeredSlides: true,
      initialSlide: 1,
      navigation: {
        nextEl: slider.querySelector(".custom-next"),
        prevEl: slider.querySelector(".custom-prev"),
      },
      scrollbar: {
        el: slider.querySelector(".swiper-scrollbar-{{ section.id }}"),
        draggable: true,
        dragSize: 300
      },
     
    });
  });
});


document.addEventListener("DOMContentLoaded", () => {
    let allCollectioons = document.querySelectorAll('.select-collection-shows');
    let allCollectioonsSlider = document.querySelectorAll('.slider-of-collections');
    
    
    allCollectioons.forEach((eachCollection,i)=>{
        eachCollection.addEventListener('click', function(){
            allCollectioonsSlider.forEach((eachCollection,p)=>{
                allCollectioons[p].classList.remove('active');
                eachCollection.style.display = "none";
            })
            eachCollection.classList.add('active');
            allCollectioonsSlider[i].style.display = "block";
        });
    });
    // Auto trigger AFTER listeners are attached
    allCollectioons[0].click();
});
</script>