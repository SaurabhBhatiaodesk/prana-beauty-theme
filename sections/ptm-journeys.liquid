{%- render 'ptm-assets' -%}
<prana-tfm-journeys class="ptm">
<section class="tm-journeys" aria-labelledby="jr-h-{{ section.id }}">
  <div class="tm-wrap">
    {%- if section.settings.heading != blank -%}<h2 id="jr-h-{{ section.id }}" class="tm-sec-h">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="tm-intro tm-journeys-intro">{{ section.settings.intro }}</p>{%- endif -%}
    {%- if section.blocks.size > 1 -%}
    <div class="tm-journey-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}<button type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" data-j="{{ forloop.index0 }}">{{ block.settings.tab_label | default: block.settings.name }}</button>{%- endfor -%}
    </div>
    {%- endif -%}
    {%- for block in section.blocks -%}
    <div class="tm-ba-grid" data-journey="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
      <div class="tm-ba">
        <div class="tm-img tm-before">{%- if block.settings.before_image -%}{{ block.settings.before_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}<div class="tm-ph">{{ section.settings.before_placeholder }}</div>{%- endif -%}</div>
        <div class="tm-img tm-after">{%- if block.settings.after_image -%}{{ block.settings.after_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.name }}{%- else -%}<div class="tm-ph">{{ section.settings.after_placeholder }}</div>{%- endif -%}</div>
        <span class="tm-lbl tm-l">{{ section.settings.before_label }}</span><span class="tm-lbl tm-r">{{ section.settings.after_label }}</span>
        <div class="tm-handle"></div>
        <label class="tm-sr" for="baRange-{{ block.id }}">Compare before and after</label>
        <input type="range" id="baRange-{{ block.id }}" min="0" max="100" value="50">
      </div>
      <div class="tm-journey-copy">
        {%- if section.settings.sample_tag != blank -%}<span class="tm-sample-tag">{{ section.settings.sample_tag }}</span>{%- endif -%}
        <h3>{{ block.settings.name }}</h3>
        {%- if block.settings.skin != blank -%}<p>{{ block.settings.skin }}</p>{%- endif -%}
        <ul class="tm-timeline">
          {%- for i in (1..3) -%}
            {%- assign w_label = 'w' | append: i | append: '_label' -%}{%- assign w_text = 'w' | append: i | append: '_text' -%}
            {%- if block.settings[w_text] != blank -%}<li><b>{{ block.settings[w_label] }}</b><span>“{{ block.settings[w_text] }}”</span></li>{%- endif -%}
          {%- endfor -%}
        </ul>
        <p class="tm-disclose">{{ section.settings.disclosure }}{% if block.settings.other != blank %} {{ section.settings.other_label }} {{ block.settings.other }}.{% endif %} {{ section.settings.results_vary }}</p>
      </div>
    </div>
    {%- endfor -%}
  </div>
</section>
</prana-tfm-journeys>
{% schema %}
{
  "name": "PDP: Customer journeys",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [{ "type": "journey", "name": "Journey", "settings": [
    { "type": "text", "id": "name", "label": "Name and age" },
    { "type": "text", "id": "tab_label", "label": "Tab label", "info": "Leave empty to use the name" },
    { "type": "text", "id": "skin", "label": "Skin type" },
    { "type": "image_picker", "id": "before_image", "label": "Before photo", "info": "Real, unretouched customer photo with signed consent" },
    { "type": "image_picker", "id": "after_image", "label": "After photo" },
    { "type": "text", "id": "w1_label", "label": "Step 1 label", "default": "Week 1" },
    { "type": "textarea", "id": "w1_text", "label": "Step 1 quote" },
    { "type": "text", "id": "w2_label", "label": "Step 2 label", "default": "Week 4" },
    { "type": "textarea", "id": "w2_text", "label": "Step 2 quote" },
    { "type": "text", "id": "w3_label", "label": "Step 3 label", "default": "Week 8" },
    { "type": "textarea", "id": "w3_text", "label": "Step 3 quote" },
    { "type": "text", "id": "other", "label": "Other products used" }
  ] }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "sample_tag", "label": "Sample data tag", "info": "Clear this once real customer data is in" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Week 0" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "Week 8" },
    { "type": "textarea", "id": "before_placeholder", "label": "Before photo placeholder" },
    { "type": "textarea", "id": "after_placeholder", "label": "After photo placeholder" },
    { "type": "text", "id": "disclosure", "label": "Disclosure" },
    { "type": "text", "id": "other_label", "label": "Other products label", "default": "Other products used:" },
    { "type": "text", "id": "results_vary", "label": "Results disclaimer", "default": "Individual results vary." }
  ],
  "presets": [{ "name": "PDP: Customer journeys" }]
}
{% endschema %}
