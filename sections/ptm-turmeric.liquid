{%- render 'ptm-assets' -%}
<div class="ptm">
<section class="tm-dossier" id="turmeric" aria-labelledby="tur-h-{{ section.id }}">
  <div class="tm-wrap tm-dossier-grid">
    <div class="tm-tur-copy">
      {%- if section.settings.heading != blank -%}<h2 id="tur-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p class="tm-tur-lede">{{ section.settings.lede }}</p>{%- endif -%}
      {{ section.settings.text }}
      <div class="tm-tur-pics">
        <figure class="tm-tur-pic">
          {%- if section.settings.image_1 -%}{{ section.settings.image_1 | image_url: width: 700 | image_tag: loading: 'lazy' }}{%- else -%}<div class="tm-ph-harvest">{{ section.settings.image_1_placeholder }}</div>{%- endif -%}
          {%- if section.settings.caption_1 != blank -%}<figcaption>{{ section.settings.caption_1 }}</figcaption>{%- endif -%}
        </figure>
        <figure class="tm-tur-pic">
          {%- if section.settings.image_2 -%}{{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', class: 'tm-harvest-crop' }}{%- else -%}<div class="tm-ph-harvest">{{ section.settings.image_2_placeholder }}</div>{%- endif -%}
          {%- if section.settings.caption_2 != blank -%}<figcaption>{{ section.settings.caption_2 }}</figcaption>{%- endif -%}
        </figure>
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
    <div class="tm-spec">
      <dl>
        {%- for block in section.blocks -%}<div class="tm-row" {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd></div>{%- endfor -%}
      </dl>
    </div>
    {%- endif -%}
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: Ingredient dossier",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [{ "type": "spec", "name": "Spec row", "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "html", "id": "value", "label": "Value" }
  ] }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "lede", "label": "Lead line" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "caption_1", "label": "Caption 1" },
    { "type": "text", "id": "image_1_placeholder", "label": "Image 1 placeholder" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2", "info": "Use a real supplier photo" },
    { "type": "text", "id": "caption_2", "label": "Caption 2" },
    { "type": "text", "id": "image_2_placeholder", "label": "Image 2 placeholder" }
  ],
  "presets": [{ "name": "PDP: Ingredient dossier" }]
}
{% endschema %}
