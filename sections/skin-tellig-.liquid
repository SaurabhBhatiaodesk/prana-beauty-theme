{% comment %}
  Skin Concern · Sutra · Solution Section
  Fixed: cart functionality, variant IDs, success state, loading state
{% endcomment %}

<style>
/* ── SECTION ── */
.sc-section {
  background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

/* ── HEADER ── */
.sc-eyebrow {
  font-size: 14px;
  font-weight: 400;
  color: var(--ink3, #6b5645);
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
.sc-eyebrow::after {
  content: '';
  height: 0.5px;
  width: 70px;
  background: var(--gold);
  display: block;
}
.sc-heading {
  font-size: 34px;
  font-weight: 400;
  color: var(--heading-color, #2c1f18);
  line-height: 1.1;
  margin: 0 0 6px;
}
.sc-subtext {
  font-size: 16px;
  font-weight: 300;
  line-height: normal;
  color: var(--ink3, #6b5645);
  margin: 0 0 14px;
  max-width: 100%;
}

/* ── TAB NAV ── */
.sc-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 24px;
}
.sc-tab-btn {
  background: transparent;
  border: 1px solid var(--ink3, #6b5645);
  border-radius: 30px;
  padding: 5px 16px;
  font-size: 15px;
  font-weight: 400;
  color: var(--ink3, #6b5645);
  cursor: pointer;
  transition: background 0.2s, color 0.2s, border-color 0.2s;
  white-space: nowrap;
}
.sc-tab-btn:hover,
.sc-tab-btn.active {
  background: var(--gold);
  color: white;
  border-color: var(--gold);
}

/* ── PANEL ── */
.sc-panel { display: none; }
.sc-panel.active { display: block; }

/* ── CONCERN CARD ── */
.sc-concern-card {
  background: #F3E4CD;
  border: 1px solid #461324;
  border-radius: 10px;
  padding: 20px 18px 22px;
  margin-bottom: 14px;
  box-shadow: 2px 2px 4px 0px #4613244D;
}
.sc-concern-num {
  font-size: 16px;
  font-weight: 400;
  color: var(--ink3, #6b5645);
  margin-bottom: 10px;
}
.sc-concern-title {
  font-size: 26px;
  font-weight: 400;
  color: var(--ink3, #6b5645);
  line-height: 1.15;
  margin: 0;
}
.sc-concern-title.highlight {
  color: var(--heading-color, #2c1f18);
  margin-bottom: 14px;
}
.sc-concern-desc {
  font-size: 16px;
  font-weight: 300;
  line-height: normal;
  color: var(--ink3, #6b5645);
  margin: 0 0 14px;
}
.sc-concern-divider {
  height: 0.5px;
  background: var(--gold);
  margin-bottom: 14px;
}
.sc-concern-meta {
  font-size: 16px;
  font-weight: 400;
  color: var(--gold, #A8681A);
  margin-bottom: 18px;
}

/* Stats */
.sc-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.sc-stat {
  background: #E3C39F;
  border: 1px solid #461324;
  border-radius: 6px;
  padding: 30px 10px;
}
.sc-stat-value {
  font-size: 28px;
  font-weight: 400;
  color: var(--heading-color, #2c1f18);
  line-height: 1;
  margin-bottom: 4px;
  text-align: center;
}
.sc-stat-label {
  font-size: 16px;
  font-weight: 300;
  color: var(--ink3, #6b5645);
  line-height: 1.3;
  text-align: center;
}

/* ── SUTRA CARD ── */
.sc-sutra-card {
  background: #E3C39F;
  border-radius: 10px;
  padding: 20px 18px 0;
  box-shadow: 0px -3px 4px 0px #D3B18A inset;
  position: relative;
  overflow:hidden;
}
.sc-sutra-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 4px;
  gap: 10px;
}
.sc-sutra-name {
  font-size: 20px;
  font-weight: 500;
  letter-spacing: 0.12em;
  color: var(--gold, #A8681A);
  text-transform: uppercase;
}
.sc-sutra-badge {
  background: var(--heading-color, #461324);
  color: #F2E4D3;
  font-size: 14px;
  font-weight: 400;
  letter-spacing: 0.06em;
  padding: 4px 10px;
  border-radius: 6px 0 0 6px;
  white-space: nowrap;
  flex-shrink: 0;
  position: absolute;
  right: 0;
}
.sc-sutra-subtitle {
  font-size: 16px;
  font-weight: 300;
  color: var(--ink3, #6b5645);
  margin: 3px 0 7px 0;
}

/* Product rows */
.sc-product {
  border-top: 1px solid var(--gold);
  padding: 14px 0;
  display: flex;
  align-items: center;
  gap: 12px;
}
.sc-product-image {
  width: 60px;
  height: 60px;
  flex-shrink: 0;
  border-radius: 8px;
  overflow:hidden;
  box-shadow: 2px 2px 4px 0px #4613244D;
  border:1px solid var(--heading-color);
}
.sc-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #f3e4cd;
}
.sc-product-info {
  flex: 1;
  min-width: 0;
}
.sc-product-name {
  font-size: 18px;
  font-weight: 500;
  color: var(--heading-color, #2c1f18);
  margin: 0 0 4px;
  line-height: 1.2;
}
.sc-product-description {
  font-size: 13px;
  font-weight: 300;
  color: var(--ink3, #6b5645);
  line-height: 1.4;
  margin: 0 0 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sc-product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top:7px;
}
.sc-product-tag {
    font-size: 11px;
    font-weight: 400;
    color: white;
    background: var(--gold);
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.5px;
}
.sc-product-meta {
  font-size: 13px;
  font-weight: 300;
  color: var(--ink3, #6b5645);
}
.sc-product-right {
  display: flex;
  align-items:center;
  gap: 6px;
  flex-shrink: 0;
}
.sc-product-price {
    font-size: 18px;
    font-weight: 500;
    color: #000;
    white-space: nowrap;
}
.sc-product-actions {
  display: flex;
  gap: 6px;
  align-items: center;
}

/* VIEW button */
.sc-btn-view {
  background: var(--gold);
  color: #F2E4D3;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.06em;
  padding: 7px 12px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  transition: background 0.2s;
  line-height: 1;
}
.sc-btn-view:hover { background: var(--heading-color, #461324); }

/* ADD button */
.sc-btn-add {
  padding: 7px 13px;
  background: var(--gold);
  color: #F2E4D3;
  border: none;
  border-radius: 4px;
  font-size:14px;
  line-height: 1;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
  font-family: inherit;
  min-width: 36px;
}
.sc-btn-add:hover { background: var(--heading-color, #461324); }
.sc-btn-add:disabled {
  pointer-events: none;
  opacity: 0.6;
}
.sc-btn-add.sc-success {
  background: var(--gold);
}
.sc-btn-add.sc-loading {
  pointer-events: none;
  opacity: 0.7;
}

/* Footer */
.sc-sutra-footer {
  margin: 0 -18px;
  padding: 16px 18px;
  border-top: 1px solid var(--gold);
  background: rgba(70,19,36,0.04);
}
.sc-footer-row {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.sc-btn-ritual {
    flex: 1;
    min-width: 120px;
    font-size: 15px;
    font-weight: 400;
    padding:10px 16px;
    border-radius:6px;
    cursor: pointer;
    text-align: center;
    transition: background 0.2s, opacity 0.2s;
    text-decoration: none;
    display: block;
    font-family: inherit;
    line-height: 1.3;
    position: relative;
    overflow: hidden;
}
.sc-btn-ritual.dark {
  background: var(--gold);
  color:white;
  border: none;
}
.sc-btn-ritual.dark:hover { 
  background: var(--heading-color);
}

.sc-btn-ritual.light {
  background: transparent;
  color: var(--gold);
  border: 1px solid var(--gold);
}
.sc-btn-ritual.light:hover { 
  background: var(--heading-color); 
  color:white;
  border-color:var(--heading-color); 
}
.sc-btn-ritual:disabled,
.sc-btn-ritual.sc-loading {
  pointer-events: none;
  opacity: 0.6;
}

/* Spinner */
@keyframes sc-spin { to { transform: rotate(360deg); } }
.sc-spinner {
  display: none;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: sc-spin 0.6s linear infinite;
  position: absolute;
  top: 50%;
  left: 50%;
  margin: -7px 0 0 -7px;
}
.sc-btn-ritual.sc-loading .sc-spinner { display: block; }
.sc-btn-ritual.sc-loading .sc-btn-label { visibility: hidden; }
.sc-total-badge {
    background: #fff;
    border: 1px solid var(--gold);
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 19px;
    font-weight: 400;
    color: black;
    white-space: nowrap;
    flex-shrink: 0;
}
.sc-footer-quote {
    font-size: 15px;
    font-weight: 300;
    color: var(--ink3, #6b5645);
    margin: 0;
    text-align: center;
}
.sc-no-products {
  text-align: center;
  padding: 40px 20px;
  color: var(--ink3, #6b5645);
  font-style: italic;
}

/* ── DESKTOP ── */
@media (min-width: 900px) {
  .sc-panel-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }
  .sc-concern-card { margin-bottom: 0; }
  .sc-concern-title { font-size: 30px; }
  .sc-product-name { font-size: 20px; }
  .sc-product-image { width: 70px; height: 70px; }
  .sc-product-description { font-size: 14px; }
}
@media (min-width: 1200px) {
  .sc-concern-card { padding: 26px 24px 26px; }
  .sc-sutra-card { padding: 24px 22px 0; }
  .sc-sutra-footer { margin: 0 -22px; padding: 18px 22px; }
  .sc-concern-title { font-size: 34px; }
  .sc-product-image { width: 80px; height: 80px; }
}

@media all and (max-width:768px){
  .sc-heading{
    font-size:26px;
  }
}

/* ── MOBILE ── */
@media (max-width: 639px) {
  .sc-section {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  .sc-subtext {
    font-size: 14px;
    line-height: 20px;
  }
  .sc-tab-btn { 
    font-size: 12px; 
    padding: 6px 11px; 
  }
  .sc-concern-card {
    margin-bottom: 3px;
    padding: 16px 14px;
  }
  .sc-concern-num {
    font-size: 14px;
    margin-bottom: 3px;
  }
  .sc-sutra-badge {
    font-size: 13px;
    letter-spacing: unset;
  }
  .sc-panel-inner {
    background: #E3C39F;
    border-radius: 10px;
    box-shadow: 0px -3px 4px 0px #D3B18A inset;
  }
  .sc-btn-ritual {
    flex: 1;
    min-width: fit-content;
    font-size: 14px;
    padding: 9px 16px;
    border-radius:5px;
  }
  .sc-total-badge {
    font-size: 17px;
  }
  .sc-stat {
    padding: 8px;
    display: flex;
    border-radius: 4px;
    flex-wrap: wrap;
    flex-direction: column;
    align-items: center;
  }
  .sc-stat-value {
    font-size: 16px;
  }
  .sc-stat-label {
    font-size: 13px;
    line-height: 13px;
  }
  .sc-product-image {
    width: 57px;
    height: 57px;
  }
  .sc-sutra-name {
    font-size: 17px;
  }
  .sc-product-name { 
    font-size: 15px; 
  }
  .sc-product-description {
    font-size: 13px;
    line-height: 16px;
    overflow-wrap: anywhere;
    white-space: normal;
    max-width: 100%;
  }
  .sc-sutra-subtitle {
    font-size: 14px;
    margin: 14px 0 7px 0;
  }
  .sc-product {
    display: grid;
    grid-template-columns: 57px 1fr;
  }
  .sc-product-info {
    flex: 1;
    min-width: calc(100% - 57px);
  }
  .sc-footer-row {
    justify-content: center;
  }
  .sc-product-tag { 
    font-size: 12px; 
    padding: 2px 6px; 
  }
  .sc-btn-view {
    font-size: 11px;
    padding: 8px 19px;
  }
  .sc-product-price {
    font-size: 17px;
    min-width: 61px;
  }
  .sc-btn-ritual.light{
    display:none;
  }
  .sc-concern-title {
    font-size: 18px;
    line-height: normal;
  }
  .sc-concern-meta {
    font-size: 14px;
    margin-bottom: 13px;
  }
  .sc-concern-desc {
    font-size: 14px;
    line-height: 20px;
    margin: 0 0 14px;
  }
  .sc-concern-title.highlight {
    margin-bottom: 2px;
  }
  .sc-btn-add { 
    font-size: 16px; 
    padding: 6px 10px; 
    min-width: 30px; 
  }
}
</style>

<section class="sc-section" id="skin-concern-section">
  <div class="section">

    {% if section.settings.eyebrow != blank %}
      <div class="sc-eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    <h2 class="sc-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.subtext != blank %}
      <p class="sc-subtext">{{ section.settings.subtext }}</p>
    {% endif %}

    <!-- TAB NAV -->
    <div class="sc-tabs" role="tablist">
      {% for block in section.blocks %}
        <button
          class="sc-tab-btn{% if forloop.first %} active{% endif %}"
          role="tab"
          data-tab="sc-panel-{{ block.id }}"
          onclick="scGoTo('sc-panel-{{ block.id }}', this)"
        >{{ block.settings.concern_name }}</button>
      {% endfor %}
    </div>

    <!-- PANELS -->
    {% for block in section.blocks %}
      {% assign collection = collections[block.settings.product_collection] %}
      {% assign product_limit = block.settings.product_limit | default: 3 %}

      {%- comment -%} Build comma-separated variant IDs, no trailing comma {%- endcomment -%}
      {%- assign variant_ids_arr = "" -%}
      {%- assign total_price = 0 -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: product_limit -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          {%- if v -%}
            {%- assign total_price = total_price | plus: v.price -%}
            {%- if forloop.first -%}
              {%- assign variant_ids_arr = v.id | append: "" -%}
            {%- else -%}
              {%- assign variant_ids_arr = variant_ids_arr | append: "," | append: v.id -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      <div
        id="sc-panel-{{ block.id }}"
        class="sc-panel{% if forloop.first %} active{% endif %}"
        role="tabpanel"
        {{ block.shopify_attributes }}
      >
        <div class="sc-panel-inner">

          <!-- CONCERN CARD -->
          <div class="sc-concern-card">
            <div class="sc-concern-num">Concern · {{ forloop.index }}</div>
            <h3 class="sc-concern-title">{{ block.settings.concern_title }}</h3>
            {% if block.settings.concern_titled != blank %}
              <h3 class="sc-concern-title highlight">{{ block.settings.concern_titled }}</h3>
            {% endif %}
            <p class="sc-concern-desc">{{ block.settings.concern_desc }}</p>
            <div class="sc-concern-divider"></div>
            {% if block.settings.concern_meta != blank %}
              <p class="sc-concern-meta">{{ block.settings.concern_meta }}</p>
            {% endif %}
            <div class="sc-stats">
              {% if block.settings.stat_1_value != blank %}
                <div class="sc-stat">
                  <div class="sc-stat-value">{{ block.settings.stat_1_value }}</div>
                  <div class="sc-stat-label">{{ block.settings.stat_1_label }}</div>
                </div>
              {% endif %}
              {% if block.settings.stat_2_value != blank %}
                <div class="sc-stat">
                  <div class="sc-stat-value">{{ block.settings.stat_2_value }}</div>
                  <div class="sc-stat-label">{{ block.settings.stat_2_label }}</div>
                </div>
              {% endif %}
              {% if block.settings.stat_3_value != blank %}
                <div class="sc-stat">
                  <div class="sc-stat-value">{{ block.settings.stat_3_value }}</div>
                  <div class="sc-stat-label">{{ block.settings.stat_3_label }}</div>
                </div>
              {% endif %}
            </div>
          </div>

          <!-- SUTRA CARD -->
          <div class="sc-sutra-card">
            <div class="sc-sutra-header">
              <div>
                {% if block.settings.sutra_name != blank %}
                  <div class="sc-sutra-name">{{ block.settings.sutra_name }}</div>
                {% endif %}
                {% if block.settings.sutra_subtitle != blank %}
                  <div class="sc-sutra-subtitle">{{ block.settings.sutra_subtitle }}</div>
                {% endif %}
              </div>
              {% if block.settings.sutra_badge != blank %}
                <span class="sc-sutra-badge">{{ block.settings.sutra_badge }}</span>
              {% endif %}
            </div>

            {% if collection != blank and collection.products.size > 0 %}
              {% for product in collection.products limit: product_limit %}
                {% assign variant = product.selected_or_first_available_variant %}
                <div class="sc-product">
                  {% if product.featured_image %}
                    <div class="sc-product-image">
                      <img
                        src="{{ product.featured_image | image_url: width: 160 }}"
                        alt="{{ product.title | escape }}"
                        width="80" height="80"
                        loading="lazy"
                      >
                    </div>
                  {% endif %}
                  <div class="sc-product-info">
                    <div class="sc-product-name">{{ product.title }}</div>
                    {% if product.description != blank %}
                      <div class="sc-product-description">{{ product.description | strip_html | truncatewords: 18 }}</div>
                    {% endif %}
                    {% if product.metafields.custom.product_meta != blank %}
                      <div class="sc-product-meta">{{ product.metafields.custom.product_meta }}</div>
                    {% elsif product.type != blank %}
                      <div class="sc-product-meta">{{ product.type }}</div>
                    {% endif %}
                    {% if product.tags.size > 0 %}
                      <div class="sc-product-tags">
                        {% for tag in product.tags limit: 2 %}
                          <span class="sc-product-tag">{{ tag | replace: '_', ' ' }}</span>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                  <div class="sc-product-right">
                    <div class="sc-product-price">{{ variant.price | money }}</div>
                    <div class="sc-product-actions">
                      <a href="{{ product.url }}" class="sc-btn-view">VIEW</a>
                      <button
                        class="sc-btn-add"
                        data-variant="{{ variant.id }}"
                        aria-label="Add {{ product.title | escape }} to cart"
                      >+</button>
                    </div>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="sc-no-products">Select a collection in the theme editor to show products.</div>
            {% endif %}

            <!-- FOOTER -->
            <div class="sc-sutra-footer">
              <div class="sc-footer-row">
                {% if variant_ids_arr != blank %}
                  <button
                    class="sc-btn-ritual dark"
                    data-variants="{{ variant_ids_arr }}"
                  >
                    <span class="sc-btn-label">{{ block.settings.ritual_btn_label | default: 'Add Full Ritual To Bag' }}</span>
                    <span class="sc-spinner"></span>
                  </button>
                  {% if block.settings.ritual_btn_label_2 != blank %}
                    <button
                      class="sc-btn-ritual light"
                      data-variants="{{ variant_ids_arr }}"
                    >
                      <span class="sc-btn-label">{{ block.settings.ritual_btn_label_2 }}</span>
                      <span class="sc-spinner"></span>
                    </button>
                  {% endif %}
                {% endif %}
                <div class="sc-total-badge">
                  {% if total_price > 0 %}{{ total_price | money }}{% else %}{{ block.settings.ritual_total | default: '$0.00' }}{% endif %}
                </div>
              </div>
              {% if block.settings.ritual_quote != blank %}
                <p class="sc-footer-quote">"{{ block.settings.ritual_quote }}"</p>
              {% endif %}
            </div>

          </div><!-- /sutra-card -->
        </div><!-- /panel-inner -->
      </div><!-- /panel -->
    {% endfor %}

  </div>
</section>

<script>
(function () {
  'use strict';

  /* ── Tab switching ── */
  window.scGoTo = function (panelId, btn) {
    document.querySelectorAll('#skin-concern-section .sc-panel').forEach(function (p) {
      p.classList.remove('active');
    });
    document.querySelectorAll('#skin-concern-section .sc-tab-btn').forEach(function (b) {
      b.classList.remove('active');
    });
    var panel = document.getElementById(panelId);
    if (panel) panel.classList.add('active');
    if (btn) btn.classList.add('active');
  };

  /* ── Cart helpers ── */

  // Step 1: POST items to /cart/add.js
  function addToCart(items) {
    return fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ items: items })
    }).then(function (r) {
      if (!r.ok) throw new Error('Cart add failed: ' + r.status);
      return r.json();
    });
  }

  // Step 2: Fetch latest cart state then open drawer via CartUpdateEvent
  function openCartDrawer() {
    var cartDrawer = document.querySelector('cart-drawer-component');

    fetch(window.Shopify.routes.root + 'cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {

        // Primary: use your theme's CartUpdateEvent from @theme/events
        import('@theme/events')
          .then(function (module) {
            var CartUpdateEvent = module.CartUpdateEvent;
            var event = new CartUpdateEvent(cart, 'manual-trigger', {
              itemCount: cart.item_count,
              source: 'skin-concern-section',
              sections: {}
            });
            document.dispatchEvent(event);
            // Open after event so drawer has time to update its state
            if (cartDrawer && typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            }
          })
          .catch(function () {
            // Fallback if @theme/events import fails (e.g. in theme editor preview)
            // cart:refresh with open:true is the secondary trigger your theme uses
            document.dispatchEvent(new CustomEvent('cart:refresh', {
              bubbles: true,
              detail: { open: true, cart: cart }
            }));
            document.dispatchEvent(new CustomEvent('cart:updated', {
              bubbles: true,
              detail: { cart: cart }
            }));
            // Try direct open as last resort
            if (cartDrawer && typeof cartDrawer.open === 'function') {
              cartDrawer.open();
            }
          });
      })
      .catch(function (err) {
        console.error('[SC Section] Cart fetch error:', err);
      });
  }

  /* ── Single product add ── */
  function handleSingleAdd(btn) {
    var variantId = parseInt(btn.getAttribute('data-variant'), 10);
    if (!variantId || btn.disabled) return;

    btn.disabled = true;
    btn.classList.add('sc-loading');
    var originalText = btn.textContent;
    btn.textContent = '…';

    addToCart([{ id: variantId, quantity: 1 }])
      .then(function () {
        btn.textContent = '✓';
        btn.classList.remove('sc-loading');
        btn.classList.add('sc-success');
        openCartDrawer();
        setTimeout(function () {
          btn.textContent = originalText;
          btn.classList.remove('sc-success');
          btn.disabled = false;
        }, 1800);
      })
      .catch(function (err) {
        console.error('[SC Section] Add to cart error:', err);
        btn.textContent = originalText;
        btn.classList.remove('sc-loading');
        btn.disabled = false;
      });
  }

  /* ── Full ritual add (multiple products) ── */
  function handleRitualAdd(btn) {
    var variantsRaw = btn.getAttribute('data-variants');
    if (!variantsRaw || btn.classList.contains('sc-loading')) return;

    var items = variantsRaw.split(',')
      .map(function (s) { return parseInt(s.trim(), 10); })
      .filter(function (id) { return !isNaN(id) && id > 0; })
      .map(function (id) { return { id: id, quantity: 1 }; });

    if (!items.length) return;

    btn.classList.add('sc-loading');

    addToCart(items)
      .then(function () {
        openCartDrawer();
        var label = btn.querySelector('.sc-btn-label');
        var original = label ? label.textContent : '';
        btn.classList.remove('sc-loading');
        if (label) label.textContent = 'Added!';
        setTimeout(function () {
          if (label) label.textContent = original;
        }, 2000);
      })
      .catch(function (err) {
        console.error('[SC Section] Ritual add error:', err);
        btn.classList.remove('sc-loading');
      });
  }

  /* ── Event delegation (one listener, handles all panels) ── */
  function init() {
    var section = document.getElementById('skin-concern-section');
    if (!section) return;

    section.addEventListener('click', function (e) {
      /* Single add */
      var addBtn = e.target.closest('.sc-btn-add');
      if (addBtn) { handleSingleAdd(addBtn); return; }

      /* Ritual add */
      var ritualBtn = e.target.closest('.sc-btn-ritual[data-variants]');
      if (ritualBtn) { handleRitualAdd(ritualBtn); return; }
    });
  }

  /* Run after DOM ready */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  /* Shopify theme editor re-init */
  document.addEventListener('shopify:section:load', function (e) {
    if (e.target && e.target.querySelector('#skin-concern-section')) init();
  });
})();
</script>

