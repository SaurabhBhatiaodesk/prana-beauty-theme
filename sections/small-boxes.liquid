<style>
.ai-skin-scan-section{
  background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
  padding:60px 0;
}
.ai-skin-scan-heading {
    margin-bottom: 25px;
    font-size: 38px;
    line-height: 1.1;
    color: var(--heading-color);
    font-weight: 400;
    text-align:center;
}

.ai-skin-scan-heading span {
    font-style: italic;
}

.ai-skin-scan-description {
    margin-bottom: 40px;
    font-family: Josefin Sans;
    font-weight: 300;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: 0;
    text-align: center;
    color: #525252;
    max-width: 1300px;
    margin-inline: auto;
}

.ai-skin-scan-section-{{ section.id }} .ai-skin-scan-grid {
    display: grid;
    justify-content: center;
    grid-gap:16px;
    grid-template-columns: repeat({{ section.settings.clmcount }}, 1fr);
}
.ai-skin-scan-card {
    position: relative;
    padding: 41px 18px;
    background: #E3C39F;
    border-radius: 10px;
}
.ai-skin-scan-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 18px;
    margin-inline: auto;
    border-radius: 50%;
    overflow: hidden;
}

.ai-skin-scan-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.ai-skin-scan-title {
    font-weight: 500;
    font-size: 18px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: capitalize;
    margin:0 auto 5px;
    margin-inline: auto;
    color: var(--heading-color);
    text-align: center;
}
.ai-skin-scan-content {
    font-weight: 400;
    font-size: 17px;
    line-height: 22px;
    letter-spacing: 0;
    text-align: center;
    color: var(--ink3);
    margin-inline: auto;
}

/* Tablet Styles */
@media (max-width: 980px) {
    .ai-skin-scan-section-{{ section.id }} .ai-skin-scan-grid {
      gap: 7px;
      grid-template-columns:1fr 1fr;
    }
}

/* Mobile Styles */
@media (max-width: 749px) {
  .ai-skin-scan-heading {
    font-size: 28px;
    line-height: 35px;
    margin: 0 0 17px 0;
  }
  .ai-skin-scan-section {
    padding: 40px 0;
  }
  .ai-skin-scan-card {
      padding:18px 20px;
      display: flex;
      align-items: center;
      gap: 10px;
  }
    
    .ai-skin-scan-description {
        font-size: 16px;
        line-height: 25px;
    }
    .ai-skin-scan-text-wrapper {
      width: calc(100% - 53px);
    }
    .ai-skin-scan-icon {
        width: 53px;
        height: 53px;
        margin: 0;
    }
    
    .ai-skin-scan-title {
        font-size: 15px;
        margin-bottom:5px;
        text-align: left;
    }
    .ai-skin-scan-content {
        font-size: 13px;
        line-height: 16px;
        text-align: left;
    }
    .ai-skin-scan-section-{{ section.id }} .ai-skin-scan-grid {
      gap: 7px;
      grid-template-columns:1fr;
    }
}
</style>

<section class="ai-skin-scan-section ai-skin-scan-section-{{ section.id }}">
    <div class="section">
        {% if section.settings.header_text != blank %}
            <h2 class="ai-skin-scan-heading">{{ section.settings.header_text }}</h2>
        {% endif %}

        {% if section.settings.main_content != blank %}
            <div class="ai-skin-scan-description rte">
                {{ section.settings.main_content }}
            </div>
        {% endif %}
        {% if section.blocks.size > 0 %}
            <div class="ai-skin-scan-grid">
                {% for block in section.blocks %}
                    <div class="ai-skin-scan-card" {{ block.shopify_attributes }}>
                        {% if block.settings.Icon != blank %}
                            <div class="ai-skin-scan-icon">
                                <img src="{{ block.settings.Icon | img_url: 'master' }}" alt="{{ block.settings.title }}" loading="lazy">
                            </div>
                        {% endif %}
                        <div class="ai-skin-scan-text-wrapper">
                            {% if block.settings.title != blank %}
                                <h3 class="ai-skin-scan-title">{{ block.settings.title }}</h3>
                            {% endif %}
                            {% if block.settings.content != blank %}
                                <div class="ai-skin-scan-content">
                                    {{ block.settings.content }}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>

{% schema %}
{
    "name": "What Is the PRANA",
    "settings": [
        {
            "type": "text",
            "id": "header_text",
            "label": "Header Title",
            "default": "What Is the PRANA AI Skin Scan?"
        },
        {
            "type": "text",
            "id": "clmcount",
            "label": "Desktop Column Count",
            "default": "3"
        },
        {
            "type": "richtext",
            "id": "main_content",
            "label": "Main Content / Description",
            "default": "<p>Our AI-powered skin analysis technology that reads your skin's unique signals</p>"
        }
    ],
    "blocks": [
        {
            "type": "items",
            "name": "Card",
            "limit": 6,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "Icon",
                    "label": "Card Icon"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Card Title"
                },
                {
                    "type": "richtext",
                    "id": "content",
                    "label": "Card Content"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "What Is the PRANA",
            "category": "Custom"
        }
    ]
}
{% endschema %}