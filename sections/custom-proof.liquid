<style>
  .proof-section {
    background: linear-gradient(90deg, #813850 0%, #461324 100%);
    color: {{ section.settings.text_color }};
  }
  .header-proof-set h3 {
      font-size: 34px;
      color: var(--ink3);
      text-align: center;
      padding: 30px 0 15px;
  }
  .header-proof-set {
    background: radial-gradient(100.75% 105.17% at 95.4% 0%, #cb964675 0%, #e3c39f2e 100%);
  }
  p.last-proof {
    text-align: center;
    font-size: 20px;
    padding: 10px 0;
  }
  .proof {
    display: grid;
    grid-template-columns: repeat({{ section.settings.desktop_grid }}, 1fr);
    align-items: center;
  }
  .proof-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 19px;
      height: 100%;
      justify-content: center;
  }


  .proof-num {
      font-family: Ponomar;
      font-weight: 400;
      font-size: 29px;
      line-height: normal;
      letter-spacing: 0%;
      text-align: center;
  }

  .proof-lbl {
      font-size: 21px;
      opacity: 1;
      text-align:center;
  }

  @media(max-width: 768px) {
    .proof {
        grid-template-columns: repeat(2, 1fr);
        padding: 12px 0px;
    }
      .proof-item:nth-child(3),
    .proof-item:nth-child(4){
      border-bottom:0;
    }

    .proof-item:nth-child(2),
    .proof-item:last-child {
      border-right: 0;
    }

    .proof-item{
      border-right: 1px solid #CB9646;
      border-bottom: 1px solid #CB9646;
      padding:10px;
    }
    .proof-num{
      font-size:22px;
    }

    .proof-lbl{
      font-size:20px;
    }
  }

  @media(max-width: 575px) {
    .proof {
      grid-template-columns: repeat(2, 1fr);
    }
    p.last-proof {
      font-size: 15px;
      line-height: 18px;
    }
    .proof-num{
      font-size:20px;
      text-align:center;
    }
    .header-proof-set h3 {
      font-size:19px;
      line-height:normal;
    }
    .proof-lbl{
      font-size:14px;
    }
  }
</style>

{% if section.settings.title != blank %}
  <div class="header-proof-set">
    <div class="section">
      <h3>{{ section.settings.title }}</h3>
    </div>
  </div>
{% endif %}
<div class="proof-section">
<div class="section">
  <!-- PROOF -->
  <div class="proof">
    <div class="proof-item">
      <div>
        <div class="proof-num">{{ section.settings.number1 }}</div>
        <div class="proof-lbl">{{ section.settings.text1 }}</div>
      </div>
    </div>

    <div class="proof-item">
      <div>
        <div class="proof-num">{{ section.settings.number2 }}</div>
        <div class="proof-lbl">{{ section.settings.text2 }}</div>
      </div>
    </div>

    <div class="proof-item">
      <div>
        <div class="proof-num">{{ section.settings.number3 }}</div>
        <div class="proof-lbl">{{ section.settings.text3 }}</div>
      </div>
    </div>

    <div class="proof-item">
      <div>
        <div class="proof-num">{{ section.settings.number4 }}</div>
        <div class="proof-lbl">{{ section.settings.text4 }}</div>
      </div>
    </div>
  </div>

  {% if section.settings.last-proof != blank %}
    <p class="last-proof">{{ section.settings.last-proof }}</p>
  {% endif %}

  {% comment %} <!-- MARQUEE -->
  <div class="marquee">
    <div class="mq-track">
      {% for block in section.blocks %}
        <span class="mq-item">
          {{ block.settings.marquee_text }}
          <span class="mq-dot">✦</span>
        </span>
      {% endfor %}
    </div>
  </div> {% endcomment %}
</div>
</div>

{% schema %}
{
  "name": "Custom Proof",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Proof Text"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_grid",
      "label": "Desktop Columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4
    },

    { "type": "text", "id": "number1", "label": "Number 1" },
    { "type": "text", "id": "text1", "label": "Text 1" },

    { "type": "text", "id": "number2", "label": "Number 2" },
    { "type": "text", "id": "text2", "label": "Text 2" },

    { "type": "text", "id": "number3", "label": "Number 3" },
    { "type": "text", "id": "text3", "label": "Text 3" },

    { "type": "text", "id": "number4", "label": "Number 4" },
    { "type": "text", "id": "text4", "label": "Text 4" },
    {
      "type": "text",
      "id": "last-proof",
      "label": "Last Proof Text"
    }
  ],

  //"blocks": [
  //  {
  //    "type": "item",
  //    "name": "item",
  //    "settings": [
  //      {
  //       "type": "text",
  //       "id": "marquee_text",
  //        "label": "Marquee text"
  //      }
  //    ]
  //  }
  // ],

  "presets": [
    {
      "name": "Custom Proof"
    }
  ]
}
{% endschema %}