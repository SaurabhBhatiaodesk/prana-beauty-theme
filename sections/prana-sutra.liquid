<div class="sutra-page" id="page-sutra">
  <div class="section">
    <a href="{{ section.settings.bread_link }}" class="sutra-back">{{ section.settings.bread_text }}</a>

    <div class="sutra-nav-cards" id="sutra-sibling-nav">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'sutra-tabs' %}
            <a href="{{ block.settings.link }}" id="{{ block.settings.id }}" class="sutra-nav-card {% if request.path == block.settings.link %}active{% endif %}">
              {{- block.settings.title -}}
            </a>
        {% endcase %}
      {% endfor %}
    </div>
  </div>

  <div class="surtas-details">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'tab-details' %}
          <div class="sutra-detail">
            <div class="sutra-banner" id="sutra-banner">
              {% if block.settings.banner_image != blank %}
                <img
                  width=""
                  height=""
                  loading="lazy"
                  id="sutra-banner-img"
                  class="sutra-banner-img"
                  src="{{ block.settings.banner_image | img_url: 'master' }}"
                  alt=""
                >
              {% endif %}
            </div>

            {% if block.settings.sp_number1 != blank or block.settings.sp_label1 != blank
              or block.settings.sp_number2 != blank or block.settings.sp_label2 != blank
              or block.settings.sp_number3 != blank or block.settings.sp_label3 != blank
              or block.settings.sp_number4 != blank or block.settings.sp_label4 != blank
            %}
              <div class="sutra-proof-bar-main" id="sutra-proof">
                <div class="section">
                  <div class="sutra-proof-bar">
                    {% if block.settings.sp_number1 != blank or block.settings.sp_label1 != blank %}
                      <div class="sp-item">
                        <div class="sp-num">{{ block.settings.sp_number1 }}</div>
                        <div class="sp-lbl">{{ block.settings.sp_label1 }}</div>
                      </div>
                    {% endif %}

                    {% if block.settings.sp_number2 != blank or block.settings.sp_label2 != blank %}
                      <div class="sp-item">
                        <div class="sp-num">{{ block.settings.sp_number2 }}</div>
                        <div class="sp-lbl">{{ block.settings.sp_label2 }}</div>
                      </div>
                    {% endif %}

                    {% if block.settings.sp_number3 != blank or block.settings.sp_label3 != blank %}
                      <div class="sp-item">
                        <div class="sp-num">{{ block.settings.sp_number3 }}</div>
                        <div class="sp-lbl">{{ block.settings.sp_label3 }}</div>
                      </div>
                    {% endif %}

                    {% if block.settings.sp_number4 != blank or block.settings.sp_label4 != blank %}
                      <div class="sp-item">
                        <div class="sp-num">{{ block.settings.sp_number4 }}</div>
                        <div class="sp-lbl">{{ block.settings.sp_label4 }}</div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}

            <div class="section">
              <div class="sutra-intro">
                <div class="sutra-intro-copy reveal vis">
                  <a href="{{ section.settings.btn-link }}" class="sutra-breadcrumb">
                    {{- section.settings['btn-text'] -}}
                    <div class="fv-cap-line"></div>
                  </a>

                  <div class="sutra-sanskrit-big" id="sutra-sanskrit">{{ block.settings.title }}</div>
                  <div class="sutra-pronounce" id="sutra-pronounce">{{ block.settings.sub_title }}</div>
                  <div class="sutra-meaning" id="sutra-meaning">{{ block.settings.caption }}</div>

                  {% if block.settings.sutra_pill1 != blank
                    or block.settings.sutra_pill2 != blank
                    or block.settings.sutra_pill3 != blank
                  %}
                    <div class="sutra-meta-pills" id="sutra-meta">
                      {% if block.settings.sutra_pill1 != blank %}
                        <span class="s-pill">
                          <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g clip-path="url(#clip0_161_2092)">
                              <path d="M14.0462 3.30996L12.4718 1.73555C12.2429 1.50671 11.872 1.50671 11.6431 1.73555C11.4143 1.96438 11.4143 2.33537 11.6431 2.56418L12.016 2.93707L11.2513 3.70178C10.2559 2.87133 9.04551 2.37 7.75439 2.25331V1.17188H8.28174C8.60535 1.17188 8.86767 0.909551 8.86767 0.585938C8.86767 0.262324 8.60535 0 8.28174 0H6.05518C5.73156 0 5.46924 0.262324 5.46924 0.585938C5.46924 0.909551 5.73156 1.17188 6.05518 1.17188H6.58252V2.25331C3.36795 2.54382 0.781738 5.2432 0.781738 8.61328C0.781738 12.143 3.63821 15 7.16846 15C10.6982 15 13.5552 12.1435 13.5552 8.61328C13.5552 7.10417 13.035 5.67521 12.08 4.53041L12.8447 3.7657L13.2176 4.13859C13.4464 4.3674 13.8174 4.36743 14.0462 4.13859C14.275 3.90979 14.275 3.5388 14.0462 3.30996ZM7.16846 13.8281C4.293 13.8281 1.95361 11.4887 1.95361 8.61328C1.95361 5.73782 4.293 3.39844 7.16846 3.39844C10.0439 3.39844 12.3833 5.73782 12.3833 8.61328C12.3833 11.4887 10.0439 13.8281 7.16846 13.8281ZM10.2131 8.61328C10.2131 8.93689 9.95075 9.19922 9.62714 9.19922H7.16849C6.84487 9.19922 6.58255 8.93689 6.58255 8.61328V5.16577C6.58255 4.84216 6.84487 4.57983 7.16849 4.57983C7.4921 4.57983 7.75442 4.84216 7.75442 5.16577V8.02734H9.62714C9.95075 8.02734 10.2131 8.28967 10.2131 8.61328Z" fill="#A8681A"/>
                            </g>
                            <defs>
                              <clipPath id="clip0_161_2092">
                                <rect width="15" height="15" fill="white"/>
                              </clipPath>
                            </defs>
                          </svg>
                          {{ block.settings.sutra_pill1 }}
                        </span>
                      {% endif %}

                      {% if block.settings.sutra_pill2 != blank %}
                        <span class="s-pill">
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 0L6.35045 3.64955L10 5L6.35045 6.35045L5 10L3.64955 6.35045L0 5L3.64955 3.64955L5 0Z" fill="#A8681A"/>
                          </svg>
                          {{ block.settings.sutra_pill2 }}
                        </span>
                      {% endif %}

                      {% if block.settings.sutra_pill3 != blank %}
                        <span class="s-pill">
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 0L6.35045 3.64955L10 5L6.35045 6.35045L5 10L3.64955 6.35045L0 5L3.64955 3.64955L5 0Z" fill="#A8681A"/>
                          </svg>
                          {{ block.settings.sutra_pill3 }}
                        </span>
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="sutra-body-text" id="sutra-desc">{{ block.settings.sutra_body_text }}</div>

                  <div class="sutra-ayurveda-block">
                    <div class="sutra-ayurveda-label">{{ block.settings.sutra_ayurveda_label }}</div>
                    <div class="sutra-ayurveda-text" id="sutra-ayurveda">{{ block.settings.sutra_ayurveda_text }}</div>
                  </div>
                </div>

                {% assign sutra_products = blank %}
                {% assign total_original_price = 0 %}
                {% assign total_selling_price = 0 %}
                {% assign total_save_price = 0 %}
                {% assign count = 0 %}
                {% assign bundle_items_json = '' %}

                {% for sutra_product in sutra_products %}
                  {% assign count = count | plus: 1 %}
                  {% assign sutra_variant = sutra_product.selected_or_first_available_variant %}
                  {% assign sutra_plan = sutra_variant.selling_plan_allocations.first %}

                  {% assign item_original_price = sutra_variant.price %}
                  {% assign item_selling_price = sutra_variant.price %}

                  {% if sutra_plan != blank %}
                    {% if sutra_plan.compare_at_price != blank and sutra_plan.compare_at_price > 0 %}
                      {% assign item_original_price = sutra_plan.compare_at_price %}
                    {% else %}
                      {% assign item_original_price = sutra_variant.price %}
                    {% endif %}

                    {% if sutra_plan.price != blank and sutra_plan.price > 0 %}
                      {% assign item_selling_price = sutra_plan.price %}
                    {% endif %}
                  {% endif %}

                  {% assign total_original_price = total_original_price | plus: item_original_price %}
                  {% assign total_selling_price = total_selling_price | plus: item_selling_price %}

                  {% capture bundle_item_json %}
{"id":{{ sutra_variant.id }},"quantity":1}
                  {% endcapture %}

                  {% if bundle_items_json != blank %}
                    {% assign bundle_items_json = bundle_items_json | append: ',' %}
                  {% endif %}

                  {% assign bundle_items_json = bundle_items_json | append: bundle_item_json %}
                {% endfor %}

                {% assign total_save_price = total_original_price | minus: total_selling_price %}

                <div class="sutra-intro-aside reveal d1 vis">
                  <div class="sutra-aside-label">
                    <div class="sutra-aside-header">
                      <span>({{ count }} {{ section.settings.products_label }})</span>
                      <div class="fv-cap-line"></div>
                    </div>
                    <h3>{{ section.settings.whats_included_label }}</h3>
                  </div>

                  <div class="sutra-aside-products">
                    {% for sutra_product in sutra_products %}
                      {% assign sutra_variant = sutra_product.selected_or_first_available_variant %}
                      {% assign sutra_plan = sutra_variant.selling_plan_allocations.first %}

                      {% assign item_original_price = sutra_variant.price %}
                      {% assign item_selling_price = sutra_variant.price %}

                      {% if sutra_plan != blank %}
                        {% if sutra_plan.compare_at_price != blank and sutra_plan.compare_at_price > 0 %}
                          {% assign item_original_price = sutra_plan.compare_at_price %}
                        {% else %}
                          {% assign item_original_price = sutra_variant.price %}
                        {% endif %}

                        {% if sutra_plan.price != blank and sutra_plan.price > 0 %}
                          {% assign item_selling_price = sutra_plan.price %}
                        {% endif %}
                      {% endif %}

                      <input
                        type="hidden"
                        class="variant-id"
                        value="{{ sutra_variant.id }}"
                      >

                      <a class="sutra-product-row" href="{{ sutra_product.url }}">
                        <div class="sutra-product-name">{{ sutra_product.title }}</div>
                        <div class="sutra-product-price">
                          {% if item_original_price > item_selling_price %}
                            <span class="sutra-product-original-price">{{ item_original_price | money | split: '.' | first }}</span>
                            <span class="sutra-product-selling-price">{{ item_selling_price | money | split: '.' | first }}</span>
                          {% else %}
                            <span class="sutra-product-selling-price">{{ item_selling_price | money | split: '.' | first }}</span>
                          {% endif %}
                        </div>
                      </a>
                    {% endfor %}
                  </div>

                  <div class="sutra-image-with-action">
                    <div class="sutra-imgs">
                      {% for sutra_product in sutra_products %}
                        <div class="sutra-img-box">
                          <img
                            width="auto"
                            height="auto"
                            loading="lazy"
                            class="sutra-product-img"
                            src="{{ sutra_product.featured_image | img_url: 'original' }}"
                            alt="{{ sutra_product.title | escape }}"
                          >
                        </div>
                      {% endfor %}
                    </div>

                    <div class="content-right">
                      <div class="sutra-pricing-row">
                        <div class="sutra-was" id="sutra-was">
                          {{ section.settings.individually_label }}
                          {% if total_original_price > total_selling_price %}
                            <s>{{ total_original_price | money | split: '.' | first }}</s>
                          {% else %}
                            {{ total_original_price | money | split: '.' | first }}
                          {% endif %}
                        </div>

                        <div class="sutra-set-price" id="sutra-price">
                          {{ total_selling_price | money | split: '.' | first }}
                        </div>
                      </div>

                      {% if total_save_price > 0 %}
                        <div class="sutra-save-badge" id="sutra-save">
                          {{ section.settings.save_label }}
                          <span class="save-price">{{ total_save_price | money | split: '.' | first }}</span>
                          {{ section.settings.save_as_label }}
                        </div>
                      {% endif %}
                    </div>
                  </div>

                  <button
                    type="button"
                    class="sutra-atc-btn"
                    id="sutra-atc-btn"
                    data-sutra-bundle-atc
                    data-bundle-items='[{{ bundle_items_json | strip_newlines | escape }}]'
                  >
                    ADD FULL SET
                  </button>

                  <div class="sutra-or-row">
                    <span>{{ section.settings.sutra_or_row }}</span>
                  </div>

                  <a class="sutra-view-all" href="{{ section.settings.sutra_link }}">{{ section.settings.view_sutra }}</a>

                  {% if block.settings.sutra_trust1 != blank
                    or block.settings.sutra_trust2 != blank
                    or block.settings.sutra_trust3 != blank
                  %}
                    <div class="sutra-trust">
                      {% if block.settings.sutra_trust1 != blank %}
                        <li class="sutra-trust-item">{{ block.settings.sutra_trust1 }}</li>
                      {% endif %}

                      {% if block.settings.sutra_trust2 != blank %}
                        <li class="sutra-trust-item">{{ block.settings.sutra_trust2 }}</li>
                      {% endif %}

                      {% if block.settings.sutra_trust3 != blank %}
                        <li class="sutra-trust-item">{{ block.settings.sutra_trust3 }}</li>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="sutra-ritual">
              <div class="section">
                <div class="sutra-ritual-label">
                  {{ section.settings.ritual_label }}
                  <div class="fv-cap-line"></div>
                </div>

                <div class="sutra-steps" id="sutra-steps"></div>
              </div>
            </div>

                        <div class="sutra-also-section">
              <div class="section">
                <div class="sutra-also-label">
                  <p>{{ section.settings.explore_other_label }}</p>
                  <div class="fv-cap-line"></div>
                </div>

                <div class="sutra-also-grid" id="sutra-also" data-bundler-dynamic-explore></div>
              </div>
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "prana sutra",
  "settings": [
    {
      "type": "text",
      "id": "bread_text",
      "label": "Back Button Text",
      "default": "← Back"
    },
    {
      "type": "url",
      "id": "bread_link",
      "label": "Back Link",
      "default": "/"
    },
    {
      "type": "text",
      "id": "btn-text",
      "label": "Breadcrumb Button Text",
      "default": "PRANA SUTRA"
    },
    {
      "type": "url",
      "id": "btn-link",
      "label": "Breadcrumb Button Link",
      "default": "/"
    },
    {
      "type": "text",
      "id": "whats_included_label",
      "label": "What's Included Heading",
      "default": "What's Included"
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Products Label (plural)",
      "default": "products"
    },
    {
      "type": "text",
      "id": "individually_label",
      "label": "Individually Text",
      "default": "Individually"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Save Text",
      "default": "Save"
    },
    {
      "type": "text",
      "id": "save_as_label",
      "label": "Save As Text",
      "default": "as a curated set"
    },
    {
      "type": "text",
      "id": "bundler_bundle_name",
      "label": "Bundler bundle name",
      "info": "Optional. Leave blank to auto-match from current page handle/title, for example /pages/abhyanga will find ABHYANGA BUNDLE. Enter exact Bundler name only if auto-match is not correct."
    },
    {
      "type": "text",
      "id": "sutra_or_row",
      "label": "Or Divider Text",
      "default": "or"
    },
    {
      "type": "text",
      "id": "view_sutra",
      "label": "View All Link Text",
      "default": "View All Products →"
    },
    {
      "type": "url",
      "id": "sutra_link",
      "label": "View All Link URL",
      "default": "/"
    },
    {
      "type": "text",
      "id": "ritual_label",
      "label": "Ritual Section Heading",
      "default": "The Ritual · Step by Step"
    },
    {
      "type": "text",
      "id": "how_to_use_label",
      "label": "How To Use Label",
      "default": "How to use"
    },
    {
      "type": "text",
      "id": "why_this_step_label",
      "label": "Why This Step Label",
      "default": "Why this step"
    },
    {
      "type": "text",
      "id": "view_product_label",
      "label": "View Product Link Text",
      "default": "View Product"
    },
    {
      "type": "text",
      "id": "add_to_bag_label",
      "label": "Add To Bag Button Text",
      "default": "Add to Bag"
    },
    {
      "type": "text",
      "id": "explore_other_label",
      "label": "Explore Other Sutras Heading",
      "default": "Explore Other Sutras"
    },
    {
      "type": "text",
      "id": "explore_arrow_label",
      "label": "Explore Arrow Text",
      "default": "Explore"
    }
  ],
  "blocks": [
    {
      "type": "sutra-tabs",
      "name": "sutra tabs",
      "settings": [
        {
          "type": "text",
          "id": "id",
          "label": "Id",
          "default": "sutra-tab-1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The Ritual"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/"
        }
      ]
    },
    {
      "type": "tab-details",
      "name": "tab details",
      "settings": [
        {
          "type": "image_picker",
          "id": "banner_image",
          "label": "Banner image"
        },
        {
          "type": "inline_richtext",
          "id": "sp_number1",
          "label": "Social Proof Number 1",
          "default": "50K+"
        },
        {
          "type": "inline_richtext",
          "id": "sp_label1",
          "label": "Social Proof Label 1",
          "default": "Happy Customers"
        },
        {
          "type": "inline_richtext",
          "id": "sp_number2",
          "label": "Social Proof Number 2",
          "default": "4.9"
        },
        {
          "type": "inline_richtext",
          "id": "sp_label2",
          "label": "Social Proof Label 2",
          "default": "Star Rating"
        },
        {
          "type": "inline_richtext",
          "id": "sp_number3",
          "label": "Social Proof Number 3",
          "default": "100%"
        },
        {
          "type": "inline_richtext",
          "id": "sp_label3",
          "label": "Social Proof Label 3",
          "default": "Natural"
        },
        {
          "type": "inline_richtext",
          "id": "sp_number4",
          "label": "Social Proof Number 4",
          "default": "30 Days"
        },
        {
          "type": "inline_richtext",
          "id": "sp_label4",
          "label": "Social Proof Label 4",
          "default": "Return Policy"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Sanskrit Title",
          "default": "Śuddhi"
        },
        {
          "type": "inline_richtext",
          "id": "sub_title",
          "label": "Pronunciation",
          "default": "shudd-hee"
        },
        {
          "type": "inline_richtext",
          "id": "caption",
          "label": "Caption",
          "default": "Purification · Cleansing"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_pill1",
          "label": "Meta Pill 1",
          "default": "15 mins"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_pill2",
          "label": "Meta Pill 2",
          "default": "Daily Ritual"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_pill3",
          "label": "Meta Pill 3",
          "default": "Beginner Friendly"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_body_text",
          "label": "Body Text",
          "default": "Śuddhi is the ancient Ayurvedic practice of internal and external purification. This ritual cleanses your energy channels and prepares you for deeper practices."
        },
        {
          "type": "inline_richtext",
          "id": "sutra_ayurveda_label",
          "label": "Ayurveda Label",
          "default": "Ayurveda Perspective"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_ayurveda_text",
          "label": "Ayurveda Text",
          "default": "According to Ayurveda, śuddhi removes āma (toxins) from the body and mind, restoring your natural state of balance and vitality."
        },
        {
          "type": "inline_richtext",
          "id": "sutra_trust1",
          "label": "Trust Badge 1",
          "default": "✓ Ayurveda Certified"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_trust2",
          "label": "Trust Badge 2",
          "default": "✓ Free Shipping"
        },
        {
          "type": "inline_richtext",
          "id": "sutra_trust3",
          "label": "Trust Badge 3",
          "default": "✓ 30-Day Guarantee"
        },
        {
          "type": "header",
          "content": "Step 1 - Content"
        },
        {
          "type": "text",
          "id": "sutra_step1",
          "label": "Step Tag 1",
          "default": "Step 01"
        },
        {
          "type": "text",
          "id": "sutra_benefit1",
          "label": "Benefit Text 1",
          "default": "Removes surface impurities"
        },
        {
          "type": "text",
          "id": "sutra_instruction1",
          "label": "Instruction Text 1",
          "default": "Apply to damp face, massage gently for 60 seconds, then rinse."
        },
        {
          "type": "text",
          "id": "sutra_why1",
          "label": "Why Text 1",
          "default": "This step prepares your skin by removing daily buildup, allowing deeper absorption of subsequent products."
        },
        {
          "type": "header",
          "content": "Step 2 - Content"
        },
        {
          "type": "text",
          "id": "sutra_step2",
          "label": "Step Tag 2",
          "default": "Step 02"
        },
        {
          "type": "text",
          "id": "sutra_benefit2",
          "label": "Benefit Text 2",
          "default": "Balances and tones"
        },
        {
          "type": "text",
          "id": "sutra_instruction2",
          "label": "Instruction Text 2",
          "default": "Spritz onto face after cleansing, before serums or moisturizer."
        },
        {
          "type": "text",
          "id": "sutra_why2",
          "label": "Why Text 2",
          "default": "Toning restores your skin's natural pH balance and prepares it to receive maximum benefits."
        },
        {
          "type": "header",
          "content": "Step 3 - Content"
        },
        {
          "type": "text",
          "id": "sutra_step3",
          "label": "Step Tag 3",
          "default": "Step 03"
        },
        {
          "type": "text",
          "id": "sutra_benefit3",
          "label": "Benefit Text 3",
          "default": "Locks in hydration"
        },
        {
          "type": "text",
          "id": "sutra_instruction3",
          "label": "Instruction Text 3",
          "default": "Apply to face and neck, morning and night."
        },
        {
          "type": "text",
          "id": "sutra_why3",
          "label": "Why Text 3",
          "default": "This final step seals in all the previous layers, providing lasting hydration and protection."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "prana sutra"
    }
  ]
}
{% endschema %}

