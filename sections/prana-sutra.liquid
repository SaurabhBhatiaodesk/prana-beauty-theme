<script type="application/json" id="sutra-bundle-source-{{ section.id }}">
{
  "money_format": {{ shop.money_format | json }},
  "individually_label": {{ section.settings.individually_label | json }},
  "save_label": {{ section.settings.save_label | json }},
  "save_as_label": {{ section.settings.save_as_label | json }},
  "products_label": {{ section.settings.products_label | json }},
  "bundler_bundle_name": {{ section.settings.bundler_bundle_name | json }},
  "page_handle": {{ page.handle | default: request.path | split: '/' | last | json }},
  "page_title": {{ page.title | json }},
  "request_path": {{ request.path | json }},
  "view_product_label": {{ section.settings.view_product_label | json }},
  "add_to_bag_label": {{ section.settings.add_to_bag_label | json }},
  "how_to_use_label": {{ section.settings.how_to_use_label | json }},
  "why_this_step_label": {{ section.settings.why_this_step_label | json }},
  "step_content": [
    {% for block in section.blocks %}
      {% if block.type == 'tab-details' %}
        {
          "tag": {{ block.settings.sutra_step1 | json }},
          "benefit": {{ block.settings.sutra_benefit1 | json }},
          "instruction": {{ block.settings.sutra_instruction1 | json }},
          "why": {{ block.settings.sutra_why1 | json }}
        },
        {
          "tag": {{ block.settings.sutra_step2 | json }},
          "benefit": {{ block.settings.sutra_benefit2 | json }},
          "instruction": {{ block.settings.sutra_instruction2 | json }},
          "why": {{ block.settings.sutra_why2 | json }}
        },
        {
          "tag": {{ block.settings.sutra_step3 | json }},
          "benefit": {{ block.settings.sutra_benefit3 | json }},
          "instruction": {{ block.settings.sutra_instruction3 | json }},
          "why": {{ block.settings.sutra_why3 | json }}
        }
        {% break %}
      {% endif %}
    {% endfor %}
  ],
  "fallback_products": [
    {% for block in section.blocks %}
      {% if block.type == 'tab-details' %}
        {% assign sutra_products_for_json = block.settings.collection.products %}
        {% for sutra_product in sutra_products_for_json %}
          {% assign sutra_variant = sutra_product.selected_or_first_available_variant %}
          {
            "product_id": "{{ sutra_product.id }}",
            "variant_id": "{{ sutra_variant.id }}",
            "title": {{ sutra_product.title | json }},
            "handle": {{ sutra_product.handle | json }},
            "price": {{ sutra_variant.price }},
            "quantity": 1
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
        {% break %}
      {% endif %}
    {% endfor %}
  ]
}
</script>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var sourceEl = document.getElementById('sutra-bundle-source-' + sectionId);
  var sourceData = {};

  try {
    sourceData = sourceEl ? JSON.parse(sourceEl.textContent || '{}') : {};
  } catch (error) {
    console.error('Sutra bundle source JSON error:', error);
    sourceData = {};
  }

  function loadBundlerEarly() {
    if (window.bndlr) return;

    var existingBundlerScript = document.querySelector('script[src*="cdn-bundler.nice-team.net/app/js/bundler.js"]');

    if (existingBundlerScript) return;

    var bundlerScript = document.createElement('script');
    bundlerScript.type = 'text/javascript';
    bundlerScript.async = true;
    bundlerScript.defer = true;
    bundlerScript.src = 'https://cdn-bundler.nice-team.net/app/js/bundler.js?shop={{ shop.permanent_domain | escape }}';

    (document.head || document.documentElement).appendChild(bundlerScript);
  }

  loadBundlerEarly();

  function rootPath() {
    if (window.Shopify && Shopify.routes && Shopify.routes.root) {
      return Shopify.routes.root;
    }

    return '/';
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function escapeAttr(value) {
    return escapeHtml(value).replace(/`/g, '&#096;');
  }

  function formatMoney(cents, moneyFormat) {
    cents = Math.round(Number(cents) || 0);

    if (window.Shopify && typeof Shopify.formatMoney === 'function') {
      var fallbackFormat = '${' + '{amount}}';
      var formattedMoney = Shopify.formatMoney(cents, moneyFormat || fallbackFormat);
      return formattedMoney.replace(/\.\d{1,2}/g, '');
    }

    return '$' + Math.floor(cents / 100);
  }

  function moneyValueToCents(value) {
    var number = parseFloat(String(value || '0').replace(/[^0-9.]/g, ''));
    return Math.round(number * 100);
  }

  function getDynamicSetLabel(bundleName) {
    var name = String(bundleName || '')
      .replace(/\s+/g, ' ')
      .trim();

    if (!name) {
      name = 'BUNDLE';
    }

    return 'ADD FULL ' + name.toUpperCase() + ' SET';
  }

  function refreshCartUI() {
    fetch(rootPath() + 'cart.js', {
      credentials: 'same-origin',
      cache: 'no-store'
    })
      .then(function(response) {
        return response.json();
      })
      .then(function(cart) {
        document.querySelectorAll('[data-cart-count], .cart-count, .cart__count, .header__cart-count').forEach(function(el) {
          el.textContent = cart.item_count;
        });

        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            cart: cart,
            data: {
              itemCount: cart.item_count,
              source: 'sutra-section'
            }
          }
        }));
      })
      .catch(function(error) {
        console.log('Cart refresh error:', error);
      });
  }

  function setButtonLoading(button, loadingText) {
    button.dataset.originalText = button.dataset.originalText || button.textContent;
    button.textContent = loadingText || 'Adding...';
    button.disabled = true;
    button.style.opacity = '0.7';
  }

  function resetButton(button, successText) {
    var originalText = button.dataset.originalText || button.textContent;

    button.textContent = successText || 'Added ✓';
    button.disabled = false;
    button.style.opacity = '1';

    setTimeout(function() {
      button.textContent = originalText;
    }, 2000);
  }

  function errorButton(button) {
    var originalText = button.dataset.originalText || button.textContent;

    button.textContent = 'Error!';
    button.disabled = false;
    button.style.opacity = '1';

    setTimeout(function() {
      button.textContent = originalText;
    }, 2000);
  }

  function addItemsToCart(items, button, successText) {
    if (!items || !items.length || !button) return;

    setButtonLoading(button, 'Adding...');

    fetch(rootPath() + 'cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        items: items
      })
    })
      .then(function(response) {
        if (!response.ok) throw new Error('Add to cart failed');
        return response.json();
      })
      .then(function() {
        resetButton(button, successText || 'Added ✓');
        refreshCartUI();

        if (window.bndlr && typeof window.bndlr.updateCartDiscounts === 'function') {
          window.bndlr.updateCartDiscounts();
        }

        if (window.bndlr && typeof window.bndlr.refresh === 'function') {
          window.bndlr.refresh();
        }
      })
      .catch(function(error) {
        console.error('Sutra add error:', error);
        errorButton(button);
      });
  }

  function getBundleProductVariantIds(bundle) {
    var ids = [];

    if (!bundle || !bundle.products) return ids;

    Object.keys(bundle.products).forEach(function(productId) {
      var product = bundle.products[productId];

      if (product.variants) {
        Object.keys(product.variants).forEach(function(variantId) {
          ids.push(String(variantId));
        });
      }
    });

    return ids;
  }

  function getFallbackMatchingBundle(bundles) {
    var fallbackProducts = sourceData.fallback_products || [];

    if (!Array.isArray(bundles) || !fallbackProducts.length) return null;

    var sourceVariantIds = fallbackProducts.map(function(product) {
      return String(product.variant_id);
    });

    return bundles.find(function(bundle) {
      if (!bundle || bundle.status !== 'enabled') return false;

      var bundleVariantIds = getBundleProductVariantIds(bundle);

      return sourceVariantIds.every(function(variantId) {
        return bundleVariantIds.includes(String(variantId));
      });
    }) || null;
  }

  function normalizeText(value) {
    return String(value || '')
      .trim()
      .toLowerCase()
      .replace(/&/g, 'and')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();
  }

  function compactText(value) {
    return normalizeText(value).replace(/\s+/g, '');
  }

  function getAutoPageKeys() {
    var keys = [];
    var pageHandle = normalizeText(sourceData.page_handle);
    var pageTitle = normalizeText(sourceData.page_title);
    var pathHandle = normalizeText(String(sourceData.request_path || '').split('/').filter(Boolean).pop());

    [pageHandle, pageTitle, pathHandle].forEach(function(key) {
      if (key && !keys.includes(key)) keys.push(key);
    });

    return keys;
  }

  function findBundleByName(bundles, expectedName) {
    var expected = normalizeText(expectedName);
    var expectedCompact = compactText(expectedName);

    if (!expected) return null;

    return bundles.find(function(bundle) {
      if (!bundle || bundle.status !== 'enabled') return false;

      var bundleName = normalizeText(bundle.name);
      var bundleNameCompact = compactText(bundle.name);

      return bundleName === expected || bundleNameCompact === expectedCompact;
    }) || null;
  }

  function findBundlerBundle() {
    if (!window.bndlr || typeof window.bndlr.getBundles !== 'function') return null;

    var bundles = window.bndlr.getBundles();

    if (!Array.isArray(bundles) || !bundles.length) return null;

    var pageKeys = getAutoPageKeys();

    for (var i = 0; i < pageKeys.length; i++) {
      var key = pageKeys[i];
      var exactBundle = findBundleByName(bundles, key + ' bundle') || findBundleByName(bundles, key);
      if (exactBundle) return exactBundle;
    }

    var containsBundle = bundles.find(function(bundle) {
      if (!bundle || bundle.status !== 'enabled') return false;

      var bundleNameCompact = compactText(bundle.name);

      return pageKeys.some(function(key) {
        return key && bundleNameCompact.indexOf(compactText(key)) !== -1 && bundleNameCompact.indexOf('bundle') !== -1;
      });
    });

    if (containsBundle) return containsBundle;

    var selectedName = sourceData.bundler_bundle_name;

    if (String(selectedName || '').trim()) {
      var namedBundle = findBundleByName(bundles, selectedName);
      if (namedBundle) return namedBundle;
    }

    return getFallbackMatchingBundle(bundles);
  }

  function getBundleProducts(bundle) {
    if (!bundle || !bundle.products) return [];

    return Object.keys(bundle.products).map(function(productId) {
      var bundleProduct = bundle.products[productId] || {};
      var variantIds = Object.keys(bundleProduct.variants || {});
      var activeVariantId = variantIds.find(function(variantId) {
        return String((bundleProduct.variants[variantId] || {}).was_deleted) !== '1';
      }) || variantIds[0];
      var variantConfig = (bundleProduct.variants || {})[activeVariantId] || {};
      var quantity = parseInt(variantConfig.quantity || bundleProduct.quantity || 1, 10);
      var sequence = parseInt(variantConfig.sequence || bundleProduct.sequence || 9999, 10);

      return {
        product_id: String(productId),
        variant_id: String(activeVariantId || ''),
        title: bundleProduct.title || '',
        handle: bundleProduct.handle || '',
        quantity: isNaN(quantity) || quantity < 1 ? 1 : quantity,
        sequence: isNaN(sequence) ? 9999 : sequence
      };
    }).filter(function(item) {
      return item.handle && item.variant_id;
    }).sort(function(a, b) {
      return a.sequence - b.sequence;
    });
  }

  function fetchProductByHandle(handle) {
    return fetch(rootPath() + 'products/' + handle + '.js', {
      credentials: 'same-origin',
      cache: 'force-cache'
    })
      .then(function(response) {
        if (!response.ok) throw new Error('Product fetch failed: ' + handle);
        return response.json();
      })
      .catch(function(error) {
        console.error(error);
        return null;
      });
  }

  function getDiscountedTotal(bundle, originalTotal) {
    if (!bundle || !originalTotal) return originalTotal;

    var discountType = bundle.discount_type;

    if (discountType === 'fixed_price') {
      return moneyValueToCents(bundle.fixed_price_value);
    }

    if (discountType === 'percentage') {
      var percentage = parseFloat(bundle.percentage_value || '0');
      return Math.round(originalTotal - (originalTotal * percentage / 100));
    }

    if (discountType === 'fixed_amount') {
      var fixedAmount = moneyValueToCents(bundle.fixed_amount_value);
      return Math.max(0, originalTotal - fixedAmount);
    }

    return originalTotal;
  }

  function distributeDiscount(items, discountedTotal, originalTotal) {
    var runningDiscountedTotal = 0;

    return items.map(function(item, index) {
      var itemOriginalTotal = Math.round((Number(item.price) || 0) * (Number(item.quantity) || 1));
      var itemDiscountedTotal;

      if (index === items.length - 1) {
        itemDiscountedTotal = discountedTotal - runningDiscountedTotal;
      } else {
        itemDiscountedTotal = originalTotal > 0 ? Math.round(itemOriginalTotal * discountedTotal / originalTotal) : itemOriginalTotal;
        runningDiscountedTotal += itemDiscountedTotal;
      }

      item.original_total = itemOriginalTotal;
      item.discounted_total = Math.max(0, itemDiscountedTotal);

      return item;
    });
  }


  function twoDigit(number) {
    number = Number(number) || 0;
    return number < 10 ? '0' + number : String(number);
  }

  function updateDynamicProofBar(productsCount, saveAmount, moneyFormat) {
    var proofItems = document.querySelectorAll('.sutra-proof-bar .sp-item');

    proofItems.forEach(function(item) {
      var numEl = item.querySelector('.sp-num');
      var labelEl = item.querySelector('.sp-lbl');
      var labelText = labelEl ? compactText(labelEl.textContent || '') : '';

      if (!numEl) return;

      if (labelText.indexOf('product') !== -1) {
        numEl.textContent = productsCount;
      }

      if (labelText.indexOf('buyingseparately') !== -1 || labelText.indexOf('vsbuying') !== -1) {
        numEl.textContent = saveAmount > 0 ? ('Save ' + formatMoney(saveAmount, moneyFormat)) : '';
      }
    });
  }

  function renderDynamicSteps(pricedItems, moneyFormat) {
    var stepsEl = document.querySelector('#sutra-steps');

    if (!stepsEl || !Array.isArray(pricedItems) || !pricedItems.length) return;

    var stepContent = sourceData.step_content || [];
    var viewProductLabel = sourceData.view_product_label || 'View Product';
    var addToBagLabel = sourceData.add_to_bag_label || 'Add to Bag';
    var howToUseLabel = sourceData.how_to_use_label || 'How to use';
    var whyThisStepLabel = sourceData.why_this_step_label || 'Why this step';

    stepsEl.innerHTML = pricedItems.map(function(item, index) {
      var number = twoDigit(index + 1);
      var content = stepContent[index] || {};
      var tag = content.tag || ('Step ' + number);
      var benefit = content.benefit || '';
      var instruction = content.instruction || '';
      var why = content.why || '';
      var productUrl = rootPath() + 'products/' + item.handle;
      var originalMoney = formatMoney(item.original_total, moneyFormat);
      var discountedMoney = formatMoney(item.discounted_total, moneyFormat);

      return '' +
        '<div class="sutra-step reveal vis">' +
          '<div class="sutra-step-body">' +
            '<a href="' + escapeAttr(productUrl) + '" class="sutra-step-img-wrap">' +
              '<div class="sutra-step-num">' + number + '</div>' +
              '<img width="" height="" loading="lazy" src="' + escapeAttr(item.image || '') + '" alt="' + escapeAttr(item.title) + '">' +
            '</a>' +
            '<div class="sutra-step-content">' +
              '<div class="sutra-step-tag">' + escapeHtml(tag) + '</div>' +
              '<a href="' + escapeAttr(productUrl) + '" class="sutra-step-name">' + escapeHtml(item.title) + '</a>' +
              (benefit ? '<div class="sutra-step-benefit">' + escapeHtml(benefit) + '</div>' : '') +
              '<div class="sutra-step-instruction-label accordion-trigger" style="cursor: pointer;">' +
                escapeHtml(howToUseLabel) +
                '<span class="accordion-icon" style="display: inline-block; margin-left: 8px; transition: transform 0.3s ease;">' +
                  '<svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                    '<path d="M0.708496 0.708252L4.9585 4.95825L9.2085 0.708252" stroke="#A8681A" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round"/>' +
                  '</svg>' +
                '</span>' +
              '</div>' +
              '<div class="sutra-step-instruction accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">' + escapeHtml(instruction) + '</div>' +
              '<div class="sutra-step-why-label accordion-trigger" style="cursor: pointer;">' +
                escapeHtml(whyThisStepLabel) +
                '<span class="accordion-icon" style="display: inline-block; margin-left: 8px; transition: transform 0.3s ease;">' +
                  '<svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                    '<path d="M0.708496 0.708252L4.9585 4.95825L9.2085 0.708252" stroke="#A8681A" stroke-width="1.41667" stroke-linecap="round" stroke-linejoin="round"/>' +
                  '</svg>' +
                '</span>' +
              '</div>' +
              '<div class="sutra-step-why accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">' + escapeHtml(why) + '</div>' +
              '<div class="sutra-step-aside">' +
                '<div class="sutra-action">' +
                  '<div class="sutra-step-price">' +
                    (item.original_total > item.discounted_total ? '<span class="sutra-step-original-price">' + originalMoney + '</span>' : '') +
                    '<span class="sutra-step-selling-price">' + discountedMoney + '</span>' +
                  '</div>' +
                  '<a href="' + escapeAttr(productUrl) + '" class="sutra-step-view">' + escapeHtml(viewProductLabel) + ' →</a>' +
                '</div>' +
                '<button type="button" pid="' + escapeAttr(item.variant_id) + '" data-sutra-step-atc data-variant-id="' + escapeAttr(item.variant_id) + '" data-quantity="' + escapeAttr(item.quantity || 1) + '" class="sutra-step-atc">' +
                  '+ ' + escapeHtml(addToBagLabel) +
                '</button>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>';
    }).join('');
  }


  function getBundleBaseName(bundleName) {
    return String(bundleName || '')
      .replace(/\s+BUNDLE$/i, '')
      .replace(/\s+SET$/i, '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function toTitleCase(value) {
    return String(value || '').toLowerCase().replace(/\b\w/g, function(letter) {
      return letter.toUpperCase();
    });
  }

  function bundleNameToPageUrl(bundleName) {
    var handle = getBundleBaseName(bundleName)
      .toLowerCase()
      .replace(/&/g, 'and')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');

    return handle ? (rootPath() + 'pages/' + handle) : rootPath();
  }

  function getBundleOriginalTotalFromItems(items) {
    return items.reduce(function(total, item) {
      return total + (Number(item.price) || 0) * (Number(item.quantity) || 1);
    }, 0);
  }

  function fetchPricedItemsForBundle(bundle) {
    var bundleProducts = getBundleProducts(bundle);

    if (!bundleProducts.length) return Promise.resolve([]);

    return Promise.all(bundleProducts.map(function(bundleProduct) {
      return fetchProductByHandle(bundleProduct.handle).then(function(productData) {
        if (!productData) return null;

        var variant = (productData.variants || []).find(function(productVariant) {
          return String(productVariant.id) === String(bundleProduct.variant_id);
        }) || (productData.variants || [])[0];

        if (!variant) return null;

        return {
          product_id: String(productData.id || bundleProduct.product_id),
          variant_id: String(variant.id || bundleProduct.variant_id),
          title: productData.title || bundleProduct.title,
          handle: productData.handle || bundleProduct.handle,
          quantity: bundleProduct.quantity,
          price: Number(variant.price) || 0,
          sequence: bundleProduct.sequence
        };
      });
    })).then(function(items) {
      return items.filter(Boolean).sort(function(a, b) {
        return a.sequence - b.sequence;
      });
    });
  }

  function getEnabledBundlesInSequence(bundles) {
    if (!Array.isArray(bundles)) return [];

    return bundles.filter(function(bundle) {
      return bundle &&
        bundle.status === 'enabled' &&
        bundle.products &&
        Object.keys(bundle.products).length;
    }).sort(function(a, b) {
      var aPriority = Number(a.priority);
      var bPriority = Number(b.priority);

      if (isNaN(aPriority)) aPriority = 9999;
      if (isNaN(bPriority)) bPriority = 9999;

      if (aPriority !== bPriority) return aPriority - bPriority;
      return (Number(a.id) || 0) - (Number(b.id) || 0);
    });
  }

  function getCurrentBundleIndex(bundles, currentBundle) {
    if (!currentBundle || !bundles.length) return -1;

    var currentId = currentBundle.id ? String(currentBundle.id) : '';
    var currentName = currentBundle.name ? compactText(currentBundle.name) : '';

    return bundles.findIndex(function(bundle) {
      if (currentId && String(bundle.id) === currentId) return true;
      if (currentName && compactText(bundle.name) === currentName) return true;
      return false;
    });
  }

  function getNextBundlesInSequence(bundles, currentBundle, limit) {
    var enabledBundles = getEnabledBundlesInSequence(bundles);

    if (!enabledBundles.length) return [];

    var currentIndex = getCurrentBundleIndex(enabledBundles, currentBundle);
    var startIndex = currentIndex >= 0 ? currentIndex + 1 : 0;
    var cards = [];

    for (var i = 0; i < enabledBundles.length && cards.length < limit; i++) {
      var bundle = enabledBundles[(startIndex + i) % enabledBundles.length];

      if (currentBundle) {
        if (String(bundle.id) === String(currentBundle.id)) continue;
        if (compactText(bundle.name) === compactText(currentBundle.name)) continue;
      }

      cards.push(bundle);
    }

    return cards;
  }

  function getFastExplorePrice(bundle) {
    if (!bundle) return '';

    if (bundle.discount_type === 'fixed_price' && String(bundle.fixed_price_value || '').trim()) {
      return formatMoney(moneyValueToCents(bundle.fixed_price_value), sourceData.money_format);
    }

    return '';
  }

  function buildExploreCard(bundle, price) {
    var baseName = getBundleBaseName(bundle.name);
    var productCount = Object.keys(bundle.products || {}).length || 0;

    return {
      bundle: bundle,
      title: toTitleCase(baseName || bundle.name || 'Bundle'),
      subtitle: productCount + ' Product Ritual',
      price: price || getFastExplorePrice(bundle),
      url: bundleNameToPageUrl(bundle.name)
    };
  }

  function renderExploreCards(cards) {
    var gridEl = document.querySelector('#sutra-also');

    if (!gridEl) return;

    if (!cards || !cards.length) {
      gridEl.innerHTML = '';
      return;
    }

    gridEl.innerHTML = cards.map(function(card) {
      return '' +
        '<a href="' + escapeAttr(card.url) + '" class="s-also-card">' +
          '<div class="box-inner">' +
            '<div class="s-also-name">' + escapeHtml(card.title) + '</div>' +
            '<div class="s-also-sub">' + escapeHtml(card.subtitle) + '</div>' +
          '</div>' +
          '<div class="box-innered">' +
            '<div class="s-also-price">' + escapeHtml(card.price) + '</div>' +
            '<div class="s-also-arrow">Explore →</div>' +
          '</div>' +
        '</a>';
    }).join('');
  }

  function renderDynamicExploreBundles(currentBundle) {
    var gridEl = document.querySelector('#sutra-also');

    if (!gridEl || !window.bndlr || typeof window.bndlr.getBundles !== 'function') return;

    var bundles = window.bndlr.getBundles();

    if (!Array.isArray(bundles) || !bundles.length) return;

    var nextBundles = getNextBundlesInSequence(bundles, currentBundle, 3);

    if (!nextBundles.length) {
      gridEl.innerHTML = '';
      return;
    }

    var instantCards = nextBundles.map(function(bundle) {
      return buildExploreCard(bundle, getFastExplorePrice(bundle));
    });

    renderExploreCards(instantCards);

    var needsAsyncPrice = nextBundles.some(function(bundle) {
      return !getFastExplorePrice(bundle);
    });

    if (!needsAsyncPrice) return;

    Promise.all(nextBundles.map(function(bundle) {
      var fastPrice = getFastExplorePrice(bundle);

      if (fastPrice) {
        return Promise.resolve(buildExploreCard(bundle, fastPrice));
      }

      return fetchPricedItemsForBundle(bundle).then(function(items) {
        var originalTotal = getBundleOriginalTotalFromItems(items);
        var discountedTotal = Math.min(originalTotal, getDiscountedTotal(bundle, originalTotal));

        return buildExploreCard(bundle, discountedTotal > 0 ? formatMoney(discountedTotal, sourceData.money_format) : '');
      });
    })).then(function(cards) {
      renderExploreCards(cards);
    }).catch(function(error) {
      console.error('Dynamic explore bundles error:', error);
    });
  }

  function renderDynamicBundle(bundle, items) {
    var productsListEl = document.querySelector('.sutra-aside-products');
    var imagesEl = document.querySelector('.sutra-imgs');
    var countEl = document.querySelector('.sutra-aside-header span');
    var wasEl = document.querySelector('#sutra-was');
    var priceEl = document.querySelector('#sutra-price');
    var saveEl = document.querySelector('#sutra-save');
    var buttonEl = document.querySelector('[data-sutra-bundle-atc]');

    var originalTotal = items.reduce(function(total, item) {
      return total + (Number(item.price) || 0) * (Number(item.quantity) || 1);
    }, 0);

    var discountedTotal = Math.min(originalTotal, getDiscountedTotal(bundle, originalTotal));
    var saveAmount = Math.max(0, originalTotal - discountedTotal);
    var pricedItems = distributeDiscount(items, discountedTotal, originalTotal);
    var moneyFormat = sourceData.money_format;

    if (countEl) {
      countEl.textContent = '(' + pricedItems.length + ' ' + (sourceData.products_label || 'products') + ')';
    }

    updateDynamicProofBar(pricedItems.length, saveAmount, moneyFormat);

    if (productsListEl) {
      productsListEl.innerHTML = pricedItems.map(function(item) {
        var productUrl = rootPath() + 'products/' + item.handle;
        var originalMoney = formatMoney(item.original_total, moneyFormat);
        var discountedMoney = formatMoney(item.discounted_total, moneyFormat);

        return '' +
          '<a class="sutra-product-row" href="' + escapeAttr(productUrl) + '">' +
            '<div class="sutra-product-name">' + escapeHtml(item.title) + '</div>' +
            '<div class="sutra-product-price">' +
              (item.original_total > item.discounted_total ? '<span class="sutra-product-original-price">' + originalMoney + '</span>' : '') +
              '<span class="sutra-product-selling-price">' + discountedMoney + '</span>' +
            '</div>' +
          '</a>';
      }).join('');
    }

    if (imagesEl) {
      imagesEl.innerHTML = pricedItems.map(function(item) {
        return '' +
          '<div class="sutra-img-box">' +
            '<img width="auto" height="auto" loading="lazy" class="sutra-product-img" src="' + escapeAttr(item.image || '') + '" alt="' + escapeAttr(item.title) + '">' +
          '</div>';
      }).join('');
    }

    if (wasEl) {
      if (originalTotal > discountedTotal) {
        wasEl.innerHTML = escapeHtml(sourceData.individually_label || 'Individually') + ' <s>' + formatMoney(originalTotal, moneyFormat) + '</s>';
      } else {
        wasEl.innerHTML = escapeHtml(sourceData.individually_label || 'Individually') + ' ' + formatMoney(originalTotal, moneyFormat);
      }
    }

    if (priceEl) {
      priceEl.textContent = formatMoney(discountedTotal, moneyFormat);
    }

    if (saveEl) {
      if (saveAmount > 0) {
        saveEl.innerHTML = escapeHtml(sourceData.save_label || 'Save') + ' <span class="save-price">' + formatMoney(saveAmount, moneyFormat) + '</span> ' + escapeHtml(sourceData.save_as_label || 'as a curated set');
        saveEl.style.display = '';
      } else {
        saveEl.style.display = 'none';
      }
    }

    if (buttonEl) {
      buttonEl.innerHTML = escapeHtml(getDynamicSetLabel(bundle.name)) + ' — ' + formatMoney(discountedTotal, moneyFormat);
      buttonEl.setAttribute('data-bundle-items', JSON.stringify(pricedItems.map(function(item) {
        return {
          id: Number(item.variant_id),
          quantity: Number(item.quantity) || 1
        };
      })));
      buttonEl.dataset.originalText = buttonEl.textContent;
    }

    renderDynamicSteps(pricedItems, moneyFormat);

    console.log('Matched Bundler bundle for Sutra:', bundle.name, bundle);
    console.log('Dynamic Bundler products:', pricedItems);
    console.log('Original:', originalTotal, 'Discounted:', discountedTotal, 'Save:', saveAmount);
  }

  function updateSutraFromBundler() {
    var bundle = findBundlerBundle();

    if (!bundle) {
      console.log('No matching Bundler bundle found. Page:', sourceData.page_handle, sourceData.page_title, 'Manual setting:', sourceData.bundler_bundle_name);
      return;
    }

    var bundleProducts = getBundleProducts(bundle);

    if (!bundleProducts.length) {
      console.log('Bundler bundle has no active products:', bundle.name);
      return;
    }

    renderDynamicExploreBundles(bundle);

    Promise.all(bundleProducts.map(function(bundleProduct) {
      return fetchProductByHandle(bundleProduct.handle).then(function(productData) {
        if (!productData) return null;

        var variant = (productData.variants || []).find(function(productVariant) {
          return String(productVariant.id) === String(bundleProduct.variant_id);
        }) || (productData.variants || [])[0];

        if (!variant) return null;

        var image = '';

        if (variant.featured_image && variant.featured_image.src) {
          image = variant.featured_image.src;
        } else if (productData.featured_image) {
          image = productData.featured_image;
        } else if (productData.images && productData.images.length) {
          image = productData.images[0];
        }

        return {
          product_id: String(productData.id || bundleProduct.product_id),
          variant_id: String(variant.id || bundleProduct.variant_id),
          title: productData.title || bundleProduct.title,
          handle: productData.handle || bundleProduct.handle,
          quantity: bundleProduct.quantity,
          price: Number(variant.price) || 0,
          image: image,
          sequence: bundleProduct.sequence
        };
      });
    })).then(function(items) {
      items = items.filter(Boolean).sort(function(a, b) {
        return a.sequence - b.sequence;
      });

      if (!items.length) return;

      renderDynamicBundle(bundle, items);
    });
  }

  function waitForBundlerAndUpdate() {
    var tries = 0;

    var timer = setInterval(function() {
      tries++;

      if (window.bndlr && typeof window.bndlr.getBundles === 'function') {
        clearInterval(timer);
        updateSutraFromBundler();
      }

      if (tries > 200) {
        clearInterval(timer);
        console.log('Bundler not found after waiting.');
      }
    }, 50);
  }

  document.addEventListener('click', function(event) {
    var bundleButton = event.target.closest('[data-sutra-bundle-atc]');

    if (bundleButton) {
      event.preventDefault();
      event.stopPropagation();

      var rawItems = bundleButton.getAttribute('data-bundle-items');
      var items = [];

      if (rawItems) {
        try {
          items = JSON.parse(rawItems);
        } catch (error) {
          console.error('Bundle items JSON parse error:', error);
        }
      }

      addItemsToCart(items, bundleButton, 'Set Added ✓');
      return;
    }

    var stepButton = event.target.closest('[data-sutra-step-atc]');

    if (stepButton) {
      event.preventDefault();
      event.stopPropagation();

      var variantId = stepButton.getAttribute('data-variant-id') || stepButton.getAttribute('pid');

      if (!variantId) return;

      var quantity = parseInt(stepButton.getAttribute('data-quantity') || '1', 10);

      var item = {
        id: parseInt(variantId, 10),
        quantity: isNaN(quantity) || quantity < 1 ? 1 : quantity
      };

      addItemsToCart([item], stepButton, 'Added ✓');
    }
  }, true);

  document.addEventListener('click', function(event) {
    var trigger = event.target.closest('.accordion-trigger');

    if (!trigger || !trigger.closest('#sutra-steps')) return;

    var content = trigger.nextElementSibling;
    var iconSvg = trigger.querySelector('.accordion-icon svg');

    if (!content || !content.classList.contains('accordion-content')) return;

    if (content.classList.contains('open')) {
      content.classList.remove('open');
      content.style.maxHeight = '0';

      if (iconSvg) {
        iconSvg.style.transform = 'rotate(0deg)';
      }
    } else {
      content.classList.add('open');
      content.style.maxHeight = content.scrollHeight + 'px';

      if (iconSvg) {
        iconSvg.style.transform = 'rotate(180deg)';
      }
    }
  });

  waitForBundlerAndUpdate();

  document.addEventListener('bundler:loaded', function() {
    updateSutraFromBundler();
  });
})();
</script>

