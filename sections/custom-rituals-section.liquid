<script>
(function() {
  function rootPath() {
    if (window.Shopify && Shopify.routes && Shopify.routes.root) {
      return Shopify.routes.root;
    }

    return '/';
  }

  function refreshCartUI() {
    fetch(rootPath() + 'cart.js', {
      credentials: 'same-origin',
      cache: 'no-store'
    })
      .then(function(res) {
        return res.json();
      })
      .then(function(cart) {
        var cartCountElements = document.querySelectorAll('[data-cart-count], .cart-count, .cart__count, .header__cart-count');

        cartCountElements.forEach(function(el) {
          el.textContent = cart.item_count;
        });

        document.dispatchEvent(new CustomEvent('cart:update', {
          bubbles: true,
          detail: {
            data: {
              itemCount: cart.item_count,
              source: 'custom-ritual-section'
            },
            cart: cart
          }
        }));
      })
      .catch(function(error) {
        console.log('Cart refresh error:', error);
      });
  }

  function addItemsToCart(items, btn) {
    if (!items || !items.length || !btn) return;

    var originalText = btn.textContent;

    btn.textContent = 'Adding...';
    btn.style.opacity = '0.7';
    btn.disabled = true;

    fetch(rootPath() + 'cart/add.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        items: items
      })
    })
      .then(function(response) {
        if (!response.ok) throw new Error('Add to cart failed');
        return response.json();
      })
      .then(function() {
        btn.textContent = 'Added ✓';
        btn.style.opacity = '1';
        btn.disabled = false;
        refreshCartUI();

        setTimeout(function() {
          btn.textContent = originalText;
        }, 2000);
      })
      .catch(function(error) {
        console.error('Bundle add error:', error);
        btn.textContent = 'Error!';
        btn.style.opacity = '1';
        btn.disabled = false;

        setTimeout(function() {
          btn.textContent = originalText;
        }, 2000);
      });
  }

  document.querySelectorAll('.r3-add-bundle').forEach(function(btn) {
    btn.addEventListener('click', function(event) {
      event.preventDefault();
      event.stopPropagation();

      var rawItems = btn.getAttribute('data-bundle-items');
      var items = [];

      if (rawItems) {
        try {
          items = JSON.parse(rawItems);
        } catch (error) {
          console.error('Bundle JSON parse error:', error);
        }
      }

      addItemsToCart(items, btn);
    });
  });
})();
</script>

