<!-- RITUAL TABS -->
<section class="ritual-3col">
  <div class="section">
    <!-- HEADER -->
    <div class="r3-header">
      <p class="rule rule-c reveal">{{ section.settings.caption }}</p>
      <h2 class="sec-h2 reveal d1">{{ section.settings.title }}</h2>
      <p class="r3-sub reveal d2">{{ section.settings.description }}</p>
    </div>

    <!-- THREE RITUAL COLUMNS -->
    <div class="r3-grid">
      {% for block in section.blocks %}
        {% assign products = block.settings.collection.products %}
        {% assign collection = block.settings.collection %}
        {% assign total_original_price = 0 %}
        {% assign total_selling_price = 0 %}
        {% assign total_saving = 0 %}
        {% assign bundle_items_json = '' %}
        {% assign bundle_variant_ids = '' %}

        <div class="r3-col reveal">
          <!-- Bundle image placeholder -->
          <div class="r3-bundle-img">
            <a href="{{ block.settings.ritual_link }}" class="r3-sanskrit">{{ block.settings.sanskrit }}</a>
            <div class="r3-img-ph">
              {% if block.settings.bundle_image != blank %}
                <a href="{{ block.settings.ritual_link }}">
                  <img width="" height="" loading="lazy" src="{{ block.settings.bundle_image | img_url: 'original' }}">
                </a>
              {% else %}
                <div class="r3-img-ph-inner">
                  <div class="r3-img-label">{{ block.settings.bundle_label }}</div>
                  <div class="r3-img-sub">{{ block.settings.bundle_name }}</div>
                  <div class="r3-img-note">{{ block.settings.bundle_note }}</div>
                </div>
              {% endif %}
            </div>
          </div>

          <div class="content-ritual">
            <!-- Ritual identity -->
            <div class="r3-identity">
              <a href="{{ block.settings.ritual_link }}" class="r3-ritual-name">{{ block.settings.ritual_name }}</a>
              <div class="r3-meaning">{{ block.settings.meaning }}</div>
            </div>

            <!-- Products -->
            <div class="r3-products">
              {% for product in products %}
                {% assign variant = product.selected_or_first_available_variant %}

                {% if variant != blank %}
                  {% assign product_original_price = variant.price %}
                  {% assign product_selling_price = variant.price %}
                  {% assign product_saving = 0 %}
                  {% assign product_selling_plan_id = '' %}
                  {% assign selling_plan_allocation = variant.selling_plan_allocations | first %}

                  {% if selling_plan_allocation != blank %}
                    {% if selling_plan_allocation.compare_at_price != blank and selling_plan_allocation.compare_at_price > 0 %}
                      {% assign product_original_price = selling_plan_allocation.compare_at_price %}
                    {% endif %}

                    {% if selling_plan_allocation.price != blank and selling_plan_allocation.price > 0 %}
                      {% assign product_selling_price = selling_plan_allocation.price %}
                    {% endif %}

                    {% if selling_plan_allocation.selling_plan != blank %}
                      {% assign product_selling_plan_id = selling_plan_allocation.selling_plan.id %}
                    {% endif %}
                  {% endif %}

                  {% if product_original_price > product_selling_price %}
                    {% assign product_saving = product_original_price | minus: product_selling_price %}
                  {% endif %}

                  {% assign total_original_price = total_original_price | plus: product_original_price %}
                  {% assign total_selling_price = total_selling_price | plus: product_selling_price %}
                  {% assign total_saving = total_saving | plus: product_saving %}
                  {% assign bundle_variant_ids = bundle_variant_ids | append: variant.id | append: ',' %}

                  {% capture bundle_item_json %}
                    {"id":{{ variant.id }},"quantity":1{% if product_selling_plan_id != blank %},"selling_plan":{{ product_selling_plan_id }}{% endif %}}
                  {% endcapture %}

                  {% if bundle_items_json != blank %}
                    {% assign bundle_items_json = bundle_items_json | append: ',' %}
                  {% endif %}

                  {% assign bundle_items_json = bundle_items_json | append: bundle_item_json %}

                  <div class="r3-product">
                    <div class="r3-product-top">
                      <span class="r3-n">01</span>
                      <div class="r3-product-info">
                        <a href="{{ product.url }}" class="r3-pname">{{ product.title }}</a>
                        <div class="r3-pdesc">
                          {% if forloop.first %}
                            {{ block.settings.pdt_desc_1 }}
                          {% endif %}
                          {% if forloop.index == 2 %}
                            {{ block.settings.pdt_desc_2 }}
                          {% endif %}
                          {% if forloop.last %}
                            {{ block.settings.pdt_desc_3 }}
                          {% endif %}
                        </div>
                      </div>
                    </div>

                    <div class="r3-product-actions">
                      <span class="r3-price">
                        {% if product_saving > 0 %}
                          <span class="r3-original-price">{{ product_original_price | money | split: '.' | first }}</span>
                          <span class="r3-selling-price">{{ product_selling_price | money | split: '.' | first }}</span>
                        {% else %}
                          <span class="r3-selling-price">{{ product_selling_price | money | split: '.' | first }}</span>
                        {% endif %}
                      </span>

                      <div class="button-action">
                        <a href="{{ product.url }}" class="r3-view" onclick="nav('pdp','cleanser')">View</a>
                        <div pid="{{ variant.id }}"data-variant-id="{{ variant.id }}"data-selling-plan-id="{{ product_selling_plan_id }}"class="pcaro-atc r3-atc">
                          <span>+</span> Add
                        </div>
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <!-- Bundle CTA -->
            <div class="r3-bundle-cta">
              <div class="r3-bundle-price-row">
                {% if total_saving > 0 %}
                  <span class="r3-bundle-save">
                    Save <span class="save-price">{{ total_saving | money | split: '.' | first }}</span>
                  </span>
                {% endif %}

                <span class="r3-bundle-price">
                  {% if total_saving > 0 %}
                    <span class="r3-bundle-original-price">{{ total_original_price | money | split: '.' | first }}</span>
                    <span class="r3-bundle-selling-price">{{ total_selling_price | money | split: '.' | first }}</span>
                  {% else %}
                    <span class="r3-bundle-selling-price">{{ total_selling_price | money | split: '.' | first }}</span>
                  {% endif %}
                </span>
              </div>

              <div class="yes-r3-action">
                <div class="action-r3-bundle">
                  <button
                    type="button"
                    class="r3-add-bundle"
                    data-bundle-ids="{{ bundle_variant_ids | remove_last: ',' }}"
                    data-bundle-items='[{{ bundle_items_json | escape }}]'
                  >
                    Add Full {{ block.settings.sanskrit }} Ritual to Bag
                  </button>

                  <div class="explore">
                    <a href="{{ block.settings.collection_link }}" class="r3-explore">
                      Explore {{ block.settings.sanskrit }}
                    </a>
                  </div>
                </div>

                <div class="r3-proof">★★★★★ {{ block.settings.review }}</div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <!-- /r3-grid -->
  </div>
</section>

