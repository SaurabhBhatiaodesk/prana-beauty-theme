                },
                {
                    "type": "image_picker",
                    "id": "icon_image",
                    "label": "Icon Image",
                    "info": "Upload PNG, JPG, or SVG image"
                },
                {
                    "type": "header",
                    "content": "Content"
                },
                {
                    "type": "text",
