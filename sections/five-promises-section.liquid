            "max": 200,
            "step": 4,
            "unit": "px",
            "default": 64
        },
        {
            "type": "range",
            "id": "padding_top_mobile",
            "label": "Mobile Top Padding",
            "min": 0,
            "max": 120,
            "step": 2,
            "unit": "px",
            "default": 32
        },
        {
            "type": "range",
            "id": "padding_bottom_mobile",
            "label": "Mobile Bottom Padding",
            "min": 0,
            "max": 120,
            "step": 2,
            "unit": "px",
            "default": 40
        }
    ],
    "blocks": [
        {
            "type": "promise",
