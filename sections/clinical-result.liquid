<div class="pdp-clinical">
    <div class="pdp-clinical-label">{{ section.settings.heading }}</div>
    <div class="pdp-clin-grid" id="pdp-clin-grid">
    {% for block in section.blocks %}
        <div class="pdp-clin-stat">
            <div class="pdp-clin-num">{{ block.settings.number }}<span class="pdp-clin-unit"> {{ block.settings.unit }}</span></div>
            <div class="pdp-clin-desc">{{ block.settings.text }}</div>
        </div>
    {% endfor %}
     </div>
    <div class="pdp-clin-note" id="pdp-clin-note">{{ section.settings.bottom_text }}</div>
  </div>

  {% schema %}
  {
    "name": "Clinical result",
    "settings": [
    {
    "type": "text",
    "id": "heading",
    "label": "Heading"
    },
    {
    "type": "text",
    "id": "bottom_text",
    "label": "Text"
    }
    ],
    "blocks": [
      {
      "type": "item",
      "name": "item",
      "settings": [
        {
        "type": "text",
        "id": "number",
        "label": "Number"
        },
        {
        "type": "text",
        "id": "unit",
        "label": "Unit"
        },
        {
        "type": "text",
        "id": "text",
        "label": "Text"
        }
      ]
    },
    ],
    "presets": [
    {
      "name": "Clinical result",
    }
  ]
  }
{% endschema %}