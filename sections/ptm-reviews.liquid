{%- render 'ptm-assets' -%}
<div class="ptm">
<section class="tm-sec" id="reviews" aria-labelledby="rev-h-{{ section.id }}">
  <div class="tm-wrap">
    {%- if section.settings.heading != blank -%}<h2 id="rev-h-{{ section.id }}">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="tm-intro">{{ section.settings.intro }}</p>{%- endif -%}
    <div id="looxReviews">
      {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
      {%- if section.blocks.size == 0 -%}<div class="tm-loox-slot">{{ section.settings.empty_text }}</div>{%- endif -%}
    </div>
  </div>
</section>
</div>
{% schema %}
{
  "name": "PDP: Reviews",
  "tag": "section",
  "class": "section-ptm",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "empty_text", "label": "Text when no review app block is added", "default": "Loox review widget mounts here" }
  ],
  "presets": [{ "name": "PDP: Reviews" }]
}
{% endschema %}
