<nav header-menu>
  <div
    class="menu-list"
    style="{% render 'menu-font-styles', settings: block_settings %}"
  >
    {% assign class = 'overflow-menu' | append: color_scheme_classes %}
    {% render 'overflow-list', class: class, ref: 'overflowMenu', children: children, minimum-items: 2, defer: true %}
  </div>
</nav>


<style>
.mega-menu__list a.mega-menu__link {
    position: relative;
    border: 2px solid #4E403C;
    border-radius: 10px;
    padding: 0;
    overflow: hidden;
}
.mega-menu__list .mega-menu__link-image {
    aspect-ratio: auto;
    max-width: 100%;
    min-height: 230px;
    max-height: 230px;
    padding: 0;
    margin: 0;
}
.mega-menu__list span.mega-menu__link-title.wrap-text {
    position: absolute;
    bottom: 15px;
    left: 50%;
    transform: translateX(-50%);
    background: #ECCA6F;
    color: #443531;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Josefin Sans';
    border-radius: 25px;
    padding: 8px 15px 6px;
    max-width: max-content;
    width: 100%;
    text-transform: uppercase;
}
h3.mega-menu-heading {
    color: #97371E;
    font-size: 24px;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: -1px;
    margin: 0 0 15px 0;
}
.mega-menu-products {
    max-width: 100%;
    width: 100%;
    padding: 0 36px;
    overflow-x: hidden;
}
.mega-menu-products-grid {
    display: flex;
    justify-content: space-between;
}
.mega-menu-product-card {
    max-width: 210px;
    background: #FAF8F4;
    padding: 15px;
    text-align: center;
    min-width: 210px;
}
.mega-menu-product-card img {
  max-height: 130px;
  object-fit: contain;
}
</style>