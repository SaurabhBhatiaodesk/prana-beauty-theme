    "prana_ingredients_sec_rcjTkV": {
      "type": "prana-ingredients-sec",
      "blocks": {
        "ingredient_EFqgP6": {
          "type": "ingredient",
          "name": "Saffron",
          "settings": {
            "tab_name": "Saffron",
            "ingredient_title": "Kashmir Saffron",
            "ingredient_subtitle": "Crocus Sativus Flower Extract",
            "description": "<p>Kashmir Saffron — <em>Kumkuma</em> in Sanskrit — is the most potent brightening ingredient in Ayurvedic skincare. <strong>Crocin and crocetin</strong>, its active carotenoids, inhibit tyrosinase and reduce melanin synthesis at the cellular level. It has been used in Ayurvedic skincare formulations for over 4,000 years. PRANA sources exclusively from the Pampore region of Kashmir — the only terroir that produces saffron with sufficient crocin concentration to deliver measurable brightening results in a topical formula.</p>",
            "info_1_title": "Brightening Mechanism",
            "info_1_text": "Crocin inhibits tyrosinase — the enzyme that converts tyrosine into melanin — reducing pigmentation at source rather than masking it at the surface.",
            "info_2_title": "Antioxidant Activity",
            "info_2_text": "Safranal and picrocrocin neutralise free radicals generated by UV and environmental pollution, protecting against oxidative stress that accelerates pigmentation and ageing.",
            "info_3_title": "Circulation & Glow",
            "info_3_text": "Saffron improves microcirculation to skin tissues, increasing oxygen delivery — the physiological basis of the luminosity associated with Kumkuma rituals in Ayurvedic practice.",
            "info_4_title": "Anti-inflammatory",
            "info_4_text": "Crocetin modulates inflammatory cytokines, reducing post-inflammatory hyperpigmentation — the most common form of uneven skin tone in South Asian and deeper skin tones.",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Saffron Glow Face Oil, Saffron Radiance Moisturizer, Bakuchiol Night Restorative Serum"
          }
        },
        "ingredient_3QjHw4": {
          "type": "ingredient",
          "name": "Bakuchi",
          "settings": {
            "tab_name": "Bakuchi",
            "ingredient_title": "Bakuchiol",
            "ingredient_subtitle": "Psoralea Corylifolia Seed Oil",
            "description": "<p>Bakuchiol — <em>Bakuchi</em> in Sanskrit — is the Ayurvedic answer to retinol. Peer-reviewed in the British Journal of Dermatology (2019), it delivers <strong>equivalent results to retinol</strong> for fine lines, firmness, and cell turnover — without the irritation, purging, sun sensitivity, or pregnancy contraindications. The babchi plant has been used in Ayurvedic skin renewal formulations for over 2,000 years.</p>",
            "info_1_title": "Retinol-Equivalent Action",
            "info_1_text": "Bakuchiol activates retinol receptor pathways (RAR and RXR) without being structurally related to retinol — achieving cell turnover stimulation via a different molecular route.",
            "info_2_title": "Collagen Synthesis",
            "info_2_text": "Upregulates Type I, III, and IV collagen gene expression — the structural proteins responsible for skin firmness and elasticity that decline with age and UV exposure.",
            "info_3_title": "Zero Irritation",
            "info_3_text": "Unlike retinol, bakuchiol does not trigger TRPV1 receptor activation — the pathway responsible for the redness, peeling, and sensitivity associated with retinoid use.",
            "info_4_title": "Antioxidant Protection",
            "info_4_text": "Potent free radical scavenger — protects against lipid peroxidation and oxidative DNA damage, supporting cellular longevity alongside its renewal action.",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Bakuchiol Night Restorative Serum"
          }
        },
        "ingredient_VgUth6": {
          "type": "ingredient",
          "name": "Turmeric",
          "settings": {
            "tab_name": "Turmeric",
            "ingredient_title": "Turmeric",
            "ingredient_subtitle": "Curcuma Longa Root Extract",
            "description": "<p>Turmeric — <em>Haridra</em> in Sanskrit, the word for golden — is Ayurveda's most documented skincare ingredient. <strong>Curcumin</strong>, its primary bioactive, simultaneously inhibits melanin synthesis, suppresses inflammatory NF-κB pathways, and provides potent antioxidant protection. The Haldi ritual — applying turmeric paste before a wedding — is practiced across South Asia because of precisely these mechanisms, understood in classical texts millennia before modern biochemistry confirmed them.</p>",
            "info_1_title": "Melanin Inhibition",
            "info_1_text": "Curcumin inhibits tyrosinase and downregulates MITF — the master transcription factor controlling melanin production — addressing hyperpigmentation at multiple points in the pathway.",
            "info_2_title": "Circulation & Glow",
            "info_2_text": "Curcumin suppresses NF-κB — the master inflammatory switch — reducing the cascade that triggers post-inflammatory hyperpigmentation, the most common pigmentation concern in South Asian skin.",
            "info_3_title": "Antioxidant",
            "info_3_text": "ORAC value of 127,068 — one of the highest of any plant-derived compound. Neutralises free radicals from UV, pollution, and metabolic processes.",
            "info_4_title": "Purification",
            "info_4_text": "Antimicrobial action against P. acnes and Staphylococcus aureus — supporting clarity without disrupting the skin microbiome.",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Turmeric & Sandalwood Purifying Mask, Saffron Glow Face Oil"
          }
        },
        "ingredient_RgjaGQ": {
          "type": "ingredient",
          "name": " Rose",
          "settings": {
            "tab_name": "Rose",
            "ingredient_title": "Damask Rose",
            "ingredient_subtitle": "Rosa Damascena Flower Extract / Oil",
            "description": "<p>Damask Rose — <em>Shatapatri</em>, meaning \"hundred petals\" — is the most prized botanical in both Ayurvedic and Persian skincare traditions. It takes <strong>60,000 hand-picked petals</strong> to produce a single ounce of true Rosa Damascena oil. PRANA uses both the absolute oil and the hydrosol (rose water) — the former for its concentrated lipid-soluble actives, the latter for its water-soluble toning and tightening properties.</p>",
            "info_1_title": "Skin Barrier",
            "info_1_text": "Geraniol and citronellol — the dominant terpenes in Damask Rose — support ceramide synthesis and reinforce the skin's lipid barrier, reducing transepidermal water loss.",
            "info_2_title": "pH Balancing",
            "info_2_text": "True rose water has a pH of 5.0–5.5 — matching the skin's ideal acid mantle. It restores pH after cleansing and prepares skin to absorb subsequent actives.",
            "info_3_title": "Anti-inflammatory",
            "info_3_text": "Flavonoids including quercetin and kaempferol inhibit COX-2 enzymes, reducing skin redness and reactivity associated with sensitised skin.",
            "info_4_title": "Astringent & Toning",
            "info_4_text": "Tannins in the flower extract provide gentle astringency — tightening pores and reducing excess sebum without stripping natural oils.",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Rose Jasmine Milk Cleanser, Pure Rose Water Toning Mist"
          }
        },
        "ingredient_yUERNE": {
          "type": "ingredient",
          "name": "Sandalwood",
          "settings": {
            "tab_name": "Sandalwood",
            "ingredient_title": "Sandalwood",
            "ingredient_subtitle": "Santalum Album Oil",
            "description": "<p>Sandalwood — <em>Chandan</em> — is among the most sacred ingredients in Ayurvedic practice. Applied in temples, offered in ritual, and used in skincare for 4,000 years, it is also one of the most scientifically validated plant-derived actives in modern dermatology. <strong>Alpha-santalol</strong>, its primary sesquiterpene, activates olfactory receptor OR2AT4 in keratinocytes — a pathway being investigated for wound healing and anti-proliferative effects in skin. PRANA sources Mysore Sandalwood oil exclusively.</p>",
            "info_1_title": "Anti-inflammatory",
            "info_1_text": "Alpha-santalol significantly inhibits COX-2 — a key enzyme in the inflammatory cascade — reducing skin redness and reactive conditions.",
            "info_2_title": "Tyrosinase Inhibition",
            "info_2_text": "Demonstrated tyrosinase inhibitory activity in vitro, contributing to brightening when combined with saffron and turmeric in PRANA's mask formula.",
            "info_3_title": "Antimicrobial",
            "info_3_text": "Effective against Staphylococcus aureus, Propionibacterium acnes, and Candida albicans — supporting clear skin without microbiome disruption.",
            "info_4_title": "Skin Texture",
            "info_4_text": "Alpha-santalol promotes keratinocyte differentiation — supporting smooth, even skin texture and refined appearance.",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Turmeric & Sandalwood Purifying Mask, Saffron Glow Face Oil"
          }
        },
        "ingredient_L9fpjh": {
          "type": "ingredient",
          "name": "Gotu Kola",
          "settings": {
            "tab_name": "Gotu Kola",
            "ingredient_title": "Gotu Kola",
            "ingredient_subtitle": "Centella Asiatica Extract",
            "description": "<p>Gotu Kola — <em>Mandukparni</em> in Sanskrit — is Ayurveda's longevity herb. In dermatology it is now one of the most clinically studied plant actives for <strong>wound healing and collagen synthesis</strong>. Its triterpenoid saponins — asiaticoside, madecassoside, asiatic acid — activate TGF-β pathways that stimulate fibroblast proliferation and new collagen production. The K-beauty industry has popularised Centella as Cica, largely rediscovering properties documented in Ayurvedic texts over 2,000 years earlier.</p>",
            "info_1_title": "Collagen Stimulation",
            "info_1_text": "Asiaticoside activates TGF-β1 signalling in fibroblasts, stimulating Type I and III collagen synthesis — the structural proteins that maintain skin firmness.",
            "info_2_title": "Wound Repair",
            "info_2_text": "Madecassoside significantly accelerates re-epithelialisation — reducing healing time and post-inflammatory scarring.",
            "info_3_title": "Barrier Repair",
            "info_3_text": "Centella triterpenoids increase hyaluronic acid synthesis in the dermis and improve ceramide production — strengthening both layers of the skin barrier.",
            "info_4_title": "Antioxidant",
            "info_4_text": "Flavonoids including quercetin and rutin provide antioxidant protection, preventing oxidative damage to newly synthesised collagen.",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Bakuchiol Night Restorative Serum , Saffron Radiance Moisturizer"
          }
        },
        "ingredient_rz64Tg": {
          "type": "ingredient",
          "name": "Jasmine",
          "settings": {
            "tab_name": "Jasmine",
            "ingredient_title": "Jasmine",
            "ingredient_subtitle": "Jasminum Officinale Flower Extract",
            "description": "<p>Jasmine — <em>Mallika</em> in Sanskrit — is among the most celebrated botanical fragrances and one of Ayurveda's most valued skin-softening actives. Beyond its aromatic role, jasmine flower extract contains <strong>benzyl acetate, linalool, and jasmone</strong> — compounds with documented moisturising, skin-conditioning, and mild anti-inflammatory properties. In PRANA's cleansing formula, jasmine provides the aromatic signature of morning ritual while supporting natural moisture retention.</p>",
            "info_1_title": "Skin Conditioning",
            "info_1_text": "Benzyl acetate and jasmone act as emollients — softening and smoothing the skin surface without occlusive heaviness.",
            "info_2_title": "Mild Antiseptic",
            "info_2_text": "Jasmine extract demonstrates mild antimicrobial activity against common skin pathogens, supporting skin clarity in the cleansing ritual.",
            "info_3_title": "Psychodermatology",
            "info_3_text": "Jasmine aroma has documented effects on the limbic system — reducing cortisol and promoting calm alertness. In morning skincare ritual, this creates a measurable psychological benefit alongside the topical one.",
            "info_4_title": "",
            "info_4_text": "",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Rose Jasmine Milk Cleanser"
          }
        },
        "ingredient_7R9eh6": {
          "type": "ingredient",
          "name": " Sesame Oil",
          "settings": {
            "tab_name": "Sesame Oil",
            "ingredient_title": "Sesame Oil",
            "ingredient_subtitle": "Sesamum Indicum (Sesame) Oil",
            "description": "<p>Sesame oil — <em>Tila Taila</em> — is the foundational carrier oil of Ayurvedic practice. The Charaka Samhita names it the finest of all oils for skin. Its unique composition of <strong>oleic acid, linoleic acid, and the lignans sesamol and sesamin</strong> creates a carrier with inherent antioxidant, anti-inflammatory, and UV-screening properties that no other commonly available plant oil replicates. It is the base carrier in PRANA's face oil formulation.</p>",
            "info_1_title": "Natural UV Screening",
            "info_1_text": "Sesame oil absorbs approximately 30% of UV radiation in vitro — providing a supplementary photoprotective effect. Not a substitute for sunscreen.",
            "info_2_title": "Antioxidant Stability",
            "info_2_text": "Sesamol and sesamolin are potent antioxidants that also stabilise the oil against oxidative rancidity — making sesame one of the most shelf-stable plant oils without synthetic preservatives.",
            "info_3_title": "Skin Penetration",
            "info_3_text": "The fatty acid profile — predominantly oleic (41%) and linoleic (43%) — closely mirrors the skin's own intercellular lipid composition, enabling deep penetration and barrier repair.",
            "info_4_title": "",
            "info_4_text": "",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Saffron Glow Face Oil"
          }
        },
        "ingredient_Em8gmD": {
          "type": "ingredient",
          "name": " Amla",
          "settings": {
            "tab_name": "Amla",
            "ingredient_title": "Amla",
            "ingredient_subtitle": "Emblica Officinalis Fruit Extract",
            "description": "<p>Amla — <em>Amalaki</em>, Indian gooseberry — contains the <strong>highest concentration of Vitamin C of any fruit on Earth</strong>: approximately 445mg per 100g, versus 53mg in oranges. Unlike synthetic ascorbic acid, Amla's Vitamin C is bound within a matrix of tannins and bioflavonoids that dramatically increase its bioavailability and stability in formulation. It is both a Vitamin C source and an independent antioxidant powerhouse — one of the most efficient brightening and anti-ageing botanicals available.</p>",
            "info_1_title": "Vitamin C Delivery",
            "info_1_text": "Amla delivers natural L-ascorbic acid in a bioflavonoid matrix that protects it from oxidation — the primary formulation challenge of synthetic Vitamin C serums.",
            "info_2_title": "Collagen Synthesis",
            "info_2_text": "Vitamin C is a cofactor in collagen biosynthesis — essential for hydroxylation of proline and lysine residues in the collagen helix.",
            "info_3_title": "Brightening",
            "info_3_text": "Inhibits melanin synthesis via tyrosinase inhibition and direct reduction of oxidised melanin intermediates — complementary to the saffron mechanism.",
            "info_4_title": "",
            "info_4_text": "",
            "info_5_title": "",
            "info_5_text": "",
            "product_tags": "Saffron Glow Face Oil"
          }
        },
        "ingredient_fFNzNC": {
          "type": "ingredient",
          "name": "Ashwagandha",
          "settings": {
            "tab_name": "Ashwagandha",
            "ingredient_title": "Ashwagandha",
            "ingredient_subtitle": "Withania Somnifera Root Extract",
            "description": "<p>Ashwagandha — the \"strength of a horse\" — is Ayurveda's premier adaptogen. Topically, its <strong>withanolides</strong> modulate the skin's stress response: reducing cortisol-mediated inflammation, inhibiting collagen breakdown, and supporting the skin's capacity to maintain homeostasis under environmental stress. For modern skin — constantly challenged by pollution, blue light, and psychological stress — ashwagandha is a uniquely relevant active.</p>",
            "info_1_title": "Cortisol Modulation",
            "info_1_text": "Withanolides inhibit cortisol synthesis locally in skin cells — reducing the collagen-degrading and barrier-disrupting effects of stress-induced cortisol elevation.",
            "info_2_title": "Anti-ageing",
            "info_2_text": "Withaferin A inhibits MMP-1 — the matrix metalloproteinase primarily responsible for collagen degradation — protecting structural integrity of the dermis.",
            "info_3_title": "Antioxidant",
            "info_3_text": "High SOD (superoxide dismutase) stimulation — ashwagandha activates the skin's own endogenous antioxidant enzyme systems rather than simply donating exogenous antioxidants.",
            "info_4_title": "",
            "info_4_text": "",
            "info_5_title": "",
            "info_5_text": "",
