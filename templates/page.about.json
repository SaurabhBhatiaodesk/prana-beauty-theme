    "prana_promise_xpKbUz": {
      "type": "prana-promise",
      "blocks": {
        "promise_card_V8ttRR": {
          "type": "promise_card",
          "settings": {
            "image": "shopify://shop_images/Rectangle_10_2.png",
            "title": "We Care",
            "description": "<p>Prana means bringing you one step closer to nature, with products made from the heart. No quick fixes here – we believe in lasting solutions that nurture both nature and your skin. Our inspiration draws from ancient Ayurveda wisdom, blended seamlessly with a touch of modern skincare magic. We've delved deep, researched intensely, all for the sake of sustainable beauty.</p>"
          }
        },
        "promise_card_4Ut4cR": {
          "type": "promise_card",
          "settings": {
            "image": "shopify://shop_images/Pure_Rose_Water.png",
            "title": "Our Values",
            "description": "<p>Prana Beauty & Wellness is where dedication to purity is our guiding principle. Only the finest, all-natural ingredients find their way into our formulations, sourced from the bountiful gifts of the earth. We meticulously curate each element to create products that not only enhance your skin but also evoke a profound sense of well-being.</p>"
          }
        }
      },
      "block_order": [
        "promise_card_V8ttRR",
        "promise_card_4Ut4cR"
      ],
      "name": "PRANA Promise",
      "settings": {
        "subheading": "The Prana Promise",
        "heading": "The Prana Promise",
        "description": "<p>We stand behind every product with confidence. If your skin isn’t transformed,<br/>your purchase is protected with our 100% satisfaction guarantee.</p><p>Perfect For: Anti-aging, brightening, hydration, calming sensitive skin, acne-prone skin, and anyone looking for clean beauty that works.<br/>PRANA Beauty isn’t just skincare—it’s a mindful ritual. Discover balance. Discover<br/>radiance. Discover you.</p><p>PRANA is an ALL NATURAL , CLEAN and GREEN , HOLISTIC Beauty andWellness brand devoted to the natural and mindful care of the mind, body andsoul. Everything we make is FREE FROM GMOs & absolutely free from parabens,phthalates, fragrances, fillers, gluten , dyes , sulfates, silicones and any other kind of synthetics and harsh chemicals. If it's not NATURALLY found OR given to us by MOTHER NATURE , it is not found here.</p>"
      }
    },
