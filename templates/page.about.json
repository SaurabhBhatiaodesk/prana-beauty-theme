    "discover_ayurveda_section_XeqjV9": {
      "type": "discover-ayurveda-section",
      "blocks": {
        "ayurveda_item_8Lix6x": {
          "type": "ayurveda_item",
          "settings": {
            "title": "",
            "description": "<p>The Ancient Science of Balance, Radiance, and Inner Beauty<br/>For over six thousand years, Ayurveda has been the heartbeat of holistic living — a timeless science that views beauty not as surface-level perfection, but as the reflection of harmony within.<br/>At Prana Beauty, we honor this ancient wisdom by uniting it with modern skincare science and intelligent personalization. The result is more than skincare — it’s a ritual, a philosophy, and a return to balance.</p>"
          }
        }
      },
      "block_order": [
        "ayurveda_item_8Lix6x"
      ],
      "name": "Discover Ayurveda",
      "settings": {
        "subheading": "",
        "heading": "Discover Ayurveda",
        "image": "shopify://shop_images/Rectangle_10_4.png",
        "desktop_layout": "content_first",
        "mobile_layout": "image_first"
