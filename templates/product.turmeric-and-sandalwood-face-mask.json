            "label": "Type",
            "value": "Kasthuri manjal, wild turmeric (<mark class=\"fill\"><em>Curcuma aromatica</em> — confirm species vs. INCI</mark>)"
          }
        },
        "spec_3": {
          "type": "spec",
          "settings": {
            "label": "Extraction",
            "value": "Liquid root extract, used at up to 1% (<mark class=\"fill\">confirm solvent and extraction method with supplier</mark>)"
          }
        },
        "spec_4": {
          "type": "spec",
          "settings": {
            "label": "Why it's in this formula",
            "value": "To bring brightness to uneven-looking skin while the clays purify, balanced by sandalwood so the mask calms rather than stings."
          }
        }
      },
