{% doc %}
  @prompt
    make an image banner there i can put the desktop and mobile image and should be an height adjuster for desktop and mobile also can add the bottom and top space , image i will use full size of width
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    width: 100%;
    padding-top: {{ block.settings.spacing_top_desktop }}px;
    padding-bottom: {{ block.settings.spacing_bottom_desktop }}px;
  }

  .ai-image-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-image-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.height_desktop }}px;
    object-fit: cover;
    display: block;
  }

  .ai-image-banner-mobile-{{ ai_gen_id }} {
    display: none;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.height_desktop }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-image-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  {% unless block.settings.show_desktop %}
    .ai-image-banner-desktop-{{ ai_gen_id }} {
      display: none !important;
    }
  {% endunless %}

  @media screen and (max-width: 749px) {
    .ai-image-banner-{{ ai_gen_id }} {
      padding-top: {{ block.settings.spacing_top_mobile }}px;
      padding-bottom: {{ block.settings.spacing_bottom_mobile }}px;
    }

    .ai-image-banner-desktop-{{ ai_gen_id }} {
      display: none !important;
    }

    .ai-image-banner-mobile-{{ ai_gen_id }} {
      display: block;
    }

    {% unless block.settings.show_mobile %}
      .ai-image-banner-mobile-{{ ai_gen_id }} {
        display: none !important;
      }
    {% endunless %}

    .ai-image-banner-image-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }

    .ai-image-banner-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.height_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-image-banner-{{ ai_gen_id }} banner_home{{ page.handle }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image_desktop or block.settings.image_mobile %}
      <div class="ai-image-banner-desktop-{{ ai_gen_id }}">
        {% if block.settings.image_desktop %}
          <img
            src="{{ block.settings.image_desktop | image_url: width: 3000 }}"
            alt="{{ block.settings.image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_desktop.width }}"
            height="{{ block.settings.image_desktop.height }}"
            class="ai-image-banner-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
              Add a desktop image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-image-banner-mobile-{{ ai_gen_id }}">
        {% if block.settings.image_mobile %}
          <img
            src="{{ block.settings.image_mobile | image_url: width: 1500 }}"
            alt="{{ block.settings.image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_mobile.width }}"
            height="{{ block.settings.image_mobile.height }}"
            class="ai-image-banner-image-{{ ai_gen_id }}"
          >
        {% elsif block.settings.image_desktop %}
          <img
            src="{{ block.settings.image_desktop | image_url: width: 1500 }}"
            alt="{{ block.settings.image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image_desktop.width }}"
            height="{{ block.settings.image_desktop.height }}"
            class="ai-image-banner-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
              Add a mobile image
            </div>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
          Add desktop and mobile images
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 200,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Height",
      "default": 600
    },
    {
      "type": "header",
      "content": "Mobile image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Height",
      "default": 400
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "spacing_top_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "spacing_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Image banner"
    }
  ]
}
{% endschema %}