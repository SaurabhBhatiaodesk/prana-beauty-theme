</script> {% endcomment %}

<script>
document.addEventListener("DOMContentLoaded", () => {

  const containers = document.querySelectorAll(".container-slider-productctivity");

  containers.forEach(container => {
    const sliderEl = container.querySelector(".slider-productctivity");

    // Init Swiper for this container
    const swiper = new Swiper(sliderEl, {
      slidesPerView: 'auto',
      spaceBetween: 8,
      loop: true,
      navigation: {
        nextEl: container.querySelector(".custom-next"),
        prevEl: container.querySelector(".custom-prev"),
      },
      on: {
        slideChange: () => {
          // pause all videos when slide changes
          pauseAllVideos(container);
        }
      }
    });

    // helper to get all videos and buttons inside this container
    function getVideos() {
      return Array.from(container.querySelectorAll(".inter-video-block video"));
    }
    function getButtons() {
      return Array.from(container.querySelectorAll(".inter-video-block .play-pause-btn"));
    }

    // Pause all videos in this container
    function pauseAllVideos(exceptVideo = null, resetTime = false) {
      const videos = getVideos();
      videos.forEach(v => {
        if (v !== exceptVideo) {
          try {
            v.pause();
            if (resetTime) v.currentTime = 0;
          } catch(e){}
        }
      });
    }

    // Update UI for play/pause buttons according to video state
    function updateButtonStateForVideo(video) {
      const wrapper = video.closest(".inter-video-block");
      if (!wrapper) return;
      const btn = wrapper.querySelector(".play-pause-btn");
      if (!btn) return;
      if (!video.paused && !video.ended && video.currentTime > 0) {
        btn.classList.add("hidden");
      } else {
        btn.classList.remove("hidden");
      }
    }

    // Set initial state
    getVideos().forEach(v => updateButtonStateForVideo(v));

    // Listen for play/pause/ended events to update buttons
    getVideos().forEach(video => {
      video.addEventListener("play", () => {
        // Pause others
        pauseAllVideos(video, /*resetTime=*/false);
        updateButtonStateForVideo(video);

        // hide all other buttons
        getButtons().forEach(b => {
          const parent = b.closest(".inter-video-block");
          if (parent && parent.querySelector("video") !== video) b.classList.remove("hidden"); // ensure visible for others
        });
      });

      video.addEventListener("pause", () => {
        updateButtonStateForVideo(video);
      });

      video.addEventListener("ended", () => {
        // show button when ended
        updateButtonStateForVideo(video);
        // optionally reset to start (comment out if not desired)
        // video.currentTime = 0;
      });

      // Ensure if user drags timeline, button state updates
      video.addEventListener("timeupdate", () => updateButtonStateForVideo(video));
    });

    // Click handler (delegated) — click on video or play button toggles play/pause
    container.addEventListener("click", (evt) => {
      const clickedBtn = evt.target.closest(".play-pause-btn");
      const clickedVideo = evt.target.closest("video");

      // if clicked on play button or video element (or their children)
      if (!clickedBtn && !clickedVideo) return;

      const targetVideo = clickedVideo || clickedBtn.closest(".inter-video-block").querySelector("video");
      if (!targetVideo) return;

      // toggle play/pause
      if (targetVideo.paused || targetVideo.ended) {
        // pause others
        pauseAllVideos(targetVideo, /*resetTime=*/false);
        // play this (ensure promise handling for browsers that require user gesture)
        const p = targetVideo.play();
        if (p && typeof p.then === "function") {
          p.catch(() => {
            // play failed (autoplay policy) — nothing else to do, user clicked so should work though
          });
        }
      } else {
        targetVideo.pause();
      }
    });

    // Also pause all videos if user navigates away from page or you want when container removed
    // window.addEventListener("pagehide", () => pauseAllVideos());

  }); // end containers.forEach

}); // DOMContentLoaded
</script>





