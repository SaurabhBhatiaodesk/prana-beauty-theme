
<style>
   .container-slider-productctivity{
         max-width: 43vw;
         width: 100%;  
    }  
    .slider-productctivity{
        width:100%;
        max-width: 100%;
    }  
    .slider-productctivity .swiper-slide{
        width:169px !important;
    } 
  .slider-productctivity .swiper-slide .inter-video-block{
        width:100%;
        overflow:hidden;
    } 
    .slider-productctivity .swiper-slide .inter-video-block video{
        object-fit: cover;
        aspect-ratio: 9 / 12;
        height: 250px;
    }
    .heade-accorss-part{
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin: 0 auto 16px;
    }
    .title-anima{
        font-family: 'Josefin Sans';
        margin:0;
        font-weight: 400;
        font-size: 18px;
        line-height: 100%;
        letter-spacing: -2%;
        color:#4E403C;
    }
    .heade-accorss-part .custom-arrows{
        width:max-content !important;
        gap:5px;
        margin: 0;
    }
    .heade-accorss-part .custom-arrow{
        width:clamp(20px, 20px ,20px) !important;
        height:20px !important;
        border-radius:50%;
        border: 0.74px solid #4E403C;
        padding: 5px 6px;
    }
    .inter-video-block{
        position:relative;
    }
    .play-pause-btn{
        width: 24px;
        height: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        backdrop-filter: blur(16.062137603759766px);
        background: #0003;
        position: absolute;
        z-index: 1;
        inset: 0;
        margin: 0 auto;
        top: 48%;
    }
    .inter-video-block .play-pause-btn.hidden{
        display: none !important;
    }
    {% comment %} .conainer-of-slide-swiper{
      width:100%;
      max-width: 100%;
    } {% endcomment %}

@media screen and (max-width: 990px) {
    .container-slider-productctivity {
      max-width: 100vw;
      width: 100%;
    }
  }    
@media screen and (max-width: 767px) {
    .container-slider-productctivity {
      max-width: 100vw;
      width: 100%;
    }
  }
</style>

{% if product.metafields.custom.recommanded_videos %}
<div class="container-slider-productctivity">
    <div class="heade-accorss-part">
        <h4 class="title-anima">See In Action</h4>
        <div class="custom-arrows custom-product-btns">
            <div class="custom-arrow custom-prev">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4.71777 0.370361L0.369947 4.71819L4.71777 9.06601" stroke="#4E403C" stroke-width="0.740741" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="custom-arrow custom-next">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0.370117 9.06601L4.71794 4.71818L0.370117 0.370357" stroke="#4E403C" stroke-width="0.740741" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </div>
    </div>
    <div class="conainer-of-slide-swiper">
      <div class="swiper product-list-swiper slider-productctivity">
          <div class="swiper-wrapper">
              {% for video_file in product.metafields.custom.recommanded_videos.value %}
                  {% assign video = video_file %}
                  <div class="swiper-slide">
                      <div class="inter-video-block">
                          {% if video.media_type == 'video' %}
                              <video 
                              controls:false 
                              playsinline 
                              preload="metadata"
                              poster="{{ video.preview_image | img_url: 'master' }}"
                              >
                              {% for source in video.sources %}
                                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                              {% endfor %}
                              </video>
                          {% endif %}
                          <span class="play-pause-btn">
                              <svg class="playsvg" width="8" height="9" viewBox="0 0 8 9" fill="none" xmlns="http://www.w3.org/2000/svg">
                                  <path d="M0 0L7.66392 4.47059L0 8.94118V0Z" fill="#FDFCFA"/>
                              </svg>
                          </span>
                      </div>
                  </div>
              {% endfor %}
          </div>
      </div>
    </div>
</div>
{% endif %}

