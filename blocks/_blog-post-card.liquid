

{%- assign block_settings = block.settings -%}

{% capture title %}
  {% content_for 'block', id: 'heading', type: '_heading', text: article.title %}
{% endcapture %}

{% capture details %}
  {% content_for 'block',
    id: 'blog-post-details',
    type: '_blog-post-info-text',
    alignment: block_settings.alignment,
    article: article
  %}
{% endcapture %}

{% capture description %}
  {% content_for 'block', id: 'content', type: '_blog-post-description', article: article, show_read_more: true %}
{% endcapture %}

<div
  class="blog-post-card"
  style="--text-align: {{ block_settings.alignment }}"
>
  {%- if article.image -%}
    <div class="blog-post-card__image-container">
      <a href="{{ article.url }}">
        {% content_for 'block', id: 'image', type: '_blog-post-image', image: article.image %}
      </a>
    </div>
  {%- endif -%}

  <div class="blog-post-card__content 11">
    <a id="blog_title-grid" class="blog_title-grid" href="{{ article.url }}">{{ title }}</a>

    {{ details }}

    {{ description }}
  </div>
</div>

{% stylesheet %}
  .blog-post-card {
      display: flex;
      flex-direction: column;
      text-align: var(--text-align);
      position: relative;
      background: #e3c39f;
      border-radius: 10px;
      height: 100%;
  }
  a#blog_title-grid * {
    color: var(--heading-color);
    font-size: 22px;
    line-height: 24px;
    text-overflow: ellipsis;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    margin: 0 0 10px 0;
    padding: 0;
  }
  .blog-post-card__content {
    padding: 4px 20px 20px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .blog-post-item span.blog-grid-date {
    background: var(--heading-color);
    color: white;
    font-size: 14px;
    padding: 5px 10px;
    border-radius: 6px 0 0px 6px;
    position: absolute;
    top: 20px;
    right: 0;
  }
  .blog-post-card__image-container{
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 2px 2px 4px 0px #4613244D;
    border: 1px solid var(--heading-color);
  }
  .blog-post-item .blog-post-card__image-container,
  .blog-post-item .blog-post-card__content {
    width: 100%;
  }

  .blog-post-item:first-child .blog-post-card {
    flex-direction: row;
    align-items: center;

    @media screen and (max-width: 749px) {
      flex-direction: column;
    }
  }

  .blog-post-item:first-child .blog-post-card__image-container {
    width: 70%;

    @media screen and (max-width: 749px) {
      width: 100%;
    }
  }

  .blog-post-item:first-child:has(.blog-post-card__image-container) .blog-post-card__content {
    /* padding-inline-start: var(--columns-gap); */
    width: 30%;

    @media screen and (max-width: 749px) {
      /* padding-inline-start: 0; */
      width: 100%;
      padding: 4px 17px 17px;
    }
  }

  .blog-post-card__content a {
    display: block;
    text-wrap: pretty;
    text-decoration: none;
    padding-block-start: 0.75rem;
  }

  .blog-post-card__content a:hover,
  .blog-post-card__content a:hover [style*='--color: var(--color-primary)'] {
    color: var(--color-primary-hover);
  }

  .blog-post-card__content a:hover [style*='--color: var(--color-foreground-heading)'] {
    color: rgb(var(--color-foreground-heading-rgb) / var(--opacity-subdued-text));
  }

  .blog-post-card__content a:hover [style*='--color: var(--color-foreground)'] {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  @media all and (max-width:575px){
    a#blog_title-grid * {
        color: var(--heading-color);
        font-size: 20px;
        line-height: 24px;
        margin: 0 0 5px;
    }
    .blog-post-card__content{
      padding: 4px 15px 17px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_post",
  "settings": [
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ]
}
{% endschema %}
