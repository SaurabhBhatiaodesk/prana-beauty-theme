<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Prata&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Ponomar&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >
    
    {% if template == 'list-collections' %}
    
     <title>The Holistic Organic Skincare Collection | Prana Beauty</title>
      <meta name="description" content="Browse a unique skincare collection featuring holistic skincare and natural beauty products. Trust Prana Beauty to provide pure organic skincare products.">

    {% else %}
    {%- render 'meta-tags' -%}
    {% endif %}


    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    

  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {% if template contains 'product' %}
        <div class="pdp">
      {% endif %}

      {{ content_for_layout }}
      
      {% if template contains 'product' %}
      </div>
      {% endif %}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% comment %} sticky {% endcomment %}
    
    {% comment %} Sticky Bar (PDP Only) {% endcomment %}

    {% if template contains 'product' %}
      {% assign sticky_pdt = product %}

      {% if sticky_pdt %}
        <div class="hp-sticky-bar" id="stickyBar" style="display:none;">
          <div class="hp-sticky-inner">

            <div class="hp-sticky-left">
              {% if sticky_pdt.featured_image %}
                <img
                  class="hp-sticky-img"
                  src="{{ sticky_pdt.featured_image | image_url: width: 150 }}"
                  alt="{{ sticky_pdt.title | escape }}"
                  width="60"
                  height="60"
                >
              {% endif %}

              <div class="hp-sticky-action">
                <div class="hp-sticky-name">
                  {{ sticky_pdt.title }}
                </div>

                <div class="hp-sticky-sub">
                  Most loved ·

                  {% if sticky_pdt.metafields.reviews.rating_count.value %}
                    {{ sticky_pdt.metafields.reviews.rating_count.value }} reviews ·
                  {% else %}
                    0 reviews ·
                  {% endif %}

                  {% if sticky_pdt.metafields.reviews.rating.value %}
                    {{ sticky_pdt.metafields.reviews.rating.value.rating | default: sticky_pdt.metafields.reviews.rating.value }}★
                  {% else %}
                    0★
                  {% endif %}
                </div>
              </div>
            </div>

            <div class="hp-sticky-right">
              <div class="hp-sticky-price">
                {{ sticky_pdt.price | money }}
              </div>

              <button
                class="pcaro-atc hp-sticky-atc"
                data-variant-id="{{ sticky_pdt.selected_or_first_available_variant.id }}">
                Add to Cart
              </button>

              <button
                class="hp-sticky-close"
                onclick="document.getElementById('stickyBar').style.display='none'">
                ✕
              </button>
            </div>

          </div>
        </div>
      {% endif %}
    {% endif %}

    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const accordionContainer = document.querySelector(
          "#shopify-section-template--25824165134626__section_eh8EJy"
        );

        if (!accordionContainer) return;

        const allDetails = accordionContainer.querySelectorAll("details");
        const imageBlocks = accordionContainer.querySelectorAll(".image-block"); // images in same order as details

        function showImageByIndex(index) {
          imageBlocks.forEach((img, i) => {
            img.style.display = i === index ? "flex" : "none";
          });
        }

        allDetails.forEach((details, index) => {
          details.addEventListener("toggle", () => {
            if (details.open) {
              // Close all other accordions
              allDetails.forEach((other) => {
                if (other !== details) other.removeAttribute("open");
              });

              // Show matching image
              showImageByIndex(index);
            }
          });
        });

        // On page load → open first accordion + show first image
        allDetails[0]?.setAttribute("open", "");
        showImageByIndex(0);
      });
    </script>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const accordionParent = document.querySelector(".product-details .accordion");
        if (!accordionParent) return;

        const allDetails = accordionParent.querySelectorAll("details");

        allDetails.forEach((item) => {
          item.addEventListener("toggle", function () {
            if (this.open) {
              // Close all other details
              allDetails.forEach((other) => {
                if (other !== this) other.removeAttribute("open");
              });
            }
          });
        });
      });
      </script>

  <script src="{{ 'prana-market-visibility.js' | asset_url }}" defer data-prana-market-check data-store-domain="{{ shop.domain | escape }}" data-store-permanent-domain="{{ shop.permanent_domain | escape }}"></script>
  </body>
</html>
